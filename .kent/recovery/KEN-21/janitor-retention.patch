+                runtime_fd if name == lock_name else task_fd,
+                name,
+                relative,
+                8 * 1024 * 1024,
+            )
+            total_bytes += len(raw)
+            entries.append({
+                "path": relative,
+                "kind": "file",
+                "mode": stat.S_IMODE(metadata.st_mode),
+                "uid": metadata.st_uid,
+                "nlink": metadata.st_nlink,
+                "size": len(raw),
+                "sha256": hashlib.sha256(raw).hexdigest(),
+            })
+
+        build_fd = _ken21_retention_open_directory(root_fd, "build", "build")
+        opened.append(build_fd)
+        workflow_fd = _ken21_retention_open_directory(
+            build_fd, "kent-workflow", "build/kent-workflow",
+        )
+        opened.append(workflow_fd)
+        task_build_fd = _ken21_retention_open_directory(
+            workflow_fd, "KEN-21", "build/kent-workflow/KEN-21",
+        )
+        opened.append(task_build_fd)
+        record_directory(task_build_fd, "build/kent-workflow/KEN-21")
+        walk(task_build_fd, "build/kent-workflow/KEN-21")
+        if total_bytes > 256 * 1024 * 1024 or len(entries) > 4096:
+            raise ValueError("retention inventory exceeds fixed bounds")
+        runtime = runtime_contracts()
+        entries.sort(key=lambda item: item["path"])
+        return runtime.canonical_sha256({
