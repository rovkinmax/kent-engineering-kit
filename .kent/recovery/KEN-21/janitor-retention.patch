+        or workspace != Path(KEN21_RETENTION_ROOT)
+        or branch != "KEN-21"
+        or pr_url != KEN21_RETENTION_DELIVERY["pr_url"]
+        or cleanup_mode != "merged"
+        or not re.fullmatch(r"[0-9a-f-]{36}", cleanup_session_id)
+    ):
+        raise ValueError("flat KEN-21 recovery identity is missing or mismatched")
