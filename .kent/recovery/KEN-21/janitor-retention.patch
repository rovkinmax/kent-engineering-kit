+def _ken21_retention_git(workspace, receipt, application):
+    command, environment = _evidence_git_workspace(workspace)
+
+    def probe(*args, check=True):
+        return run(
+            [*command, *args],
+            cwd=workspace,
+            environment=environment,
+            check=check,
+        )
+
+    git_root = Path(probe("rev-parse", "--show-toplevel").stdout.strip()).resolve()
+    head = probe("rev-parse", "HEAD").stdout.strip()
+    branch = probe("symbolic-ref", "--quiet", "--short", "HEAD", check=False).stdout.strip()
+    if (
+        git_root != workspace
+        or head != KEN21_RETENTION_HEAD
+        or branch != "KEN-21"
+        or receipt["task"]["head"] != head
+        or receipt["task"]["branch_name"] != branch
+    ):
+        raise ValueError("retention Git root, branch, or HEAD changed")
+
+    tracked = probe("diff", "--name-only", "--no-renames", "-z", "HEAD", "--").stdout
+    staged = probe(
+        "diff", "--cached", "--name-only", "--no-renames", "-z", "HEAD", "--",
+    ).stdout
+    untracked = probe(
+        "ls-files", "--others", "--exclude-standard", "-z",
+    ).stdout
+    allowed = {KEN21_RETENTION_JANITOR}
+    if (
+        set(filter(None, tracked.split("\0"))) != allowed
+        or set(filter(None, staged.split("\0"))) - allowed
+        or untracked
+    ):
+        raise ValueError("retention worktree has changes outside the approved Janitor patch")
+
+    full_patch = probe(
+        "diff", "--binary", "--no-ext-diff", "HEAD", "--", KEN21_RETENTION_JANITOR,
+    ).stdout.encode("utf-8")
+    staged_patch = probe(
+        "diff", "--cached", "--binary", "--no-ext-diff", "HEAD", "--",
+        KEN21_RETENTION_JANITOR,
+    ).stdout.encode("utf-8")
+    unstaged_patch = probe(
+        "diff", "--binary", "--no-ext-diff", "--", KEN21_RETENTION_JANITOR,
+    ).stdout.encode("utf-8")
+    if (
+        hashlib.sha256(full_patch).hexdigest() != application["patch_sha256"]
+        or (staged_patch and (staged_patch != full_patch or unstaged_patch))
+        or (not staged_patch and unstaged_patch != full_patch)
+    ):
+        raise ValueError("retention tracked Janitor delta differs from approved patch")
+
+    original = probe("show", f"HEAD:{KEN21_RETENTION_JANITOR}").stdout.encode("utf-8")
+    if hashlib.sha256(original).hexdigest() != KEN21_RETENTION_ORIGINALS["janitor_sha256"]:
+        raise ValueError("frozen Janitor preimage does not match approved hash")
+    current = _ken21_retention_read(workspace, KEN21_RETENTION_JANITOR, 8 * 1024 * 1024)
+    if (
+        hashlib.sha256(current).hexdigest() != application["janitor_postimage_sha256"]
+        or not os.stat(workspace / KEN21_RETENTION_JANITOR, follow_symlinks=False).st_mode
+        & stat.S_IXUSR
+    ):
+        raise ValueError("patched Janitor postimage is not the approved executable")
+    return probe, original, current
