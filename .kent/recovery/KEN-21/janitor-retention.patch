+def _ken21_retention_inventory(workspace):
+    root_fd = os.open(
+        workspace,
+        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
+    )
+    opened = [root_fd]
+    entries = []
+    total_bytes = 0
+
+    def record_directory(descriptor, relative):
+        metadata = os.fstat(descriptor)
+        _ken21_retention_check_directory(metadata, relative)
+        if len(entries) >= 4096:
+            raise ValueError("retention inventory exceeds fixed entry limit")
+        entries.append({
+            "path": relative,
+            "kind": "directory",
+            "mode": stat.S_IMODE(metadata.st_mode),
+            "uid": metadata.st_uid,
+        })
+
+    def walk(descriptor, relative):
+        nonlocal total_bytes
+        with os.scandir(descriptor) as scan:
+            children = []
+            for child in scan:
+                if len(entries) + len(children) >= 4096:
+                    raise ValueError("retention inventory exceeds fixed entry limit")
+                children.append(child)
+        children.sort(key=lambda item: item.name)
+        for child in children:
+            name = child.name
+            info = child.stat(follow_symlinks=False)
+            path = f"{relative}/{name}"
+            if stat.S_ISDIR(info.st_mode):
+                child_fd = _ken21_retention_open_directory(descriptor, name, path)
+                opened.append(child_fd)
+                record_directory(child_fd, path)
+                walk(child_fd, path)
+            elif stat.S_ISREG(info.st_mode):
+                raw, metadata = _ken21_retention_read_at(
+                    descriptor, name, path, 64 * 1024 * 1024,
+                )
+                total_bytes += len(raw)
+                if total_bytes > 256 * 1024 * 1024 or len(entries) >= 4096:
+                    raise ValueError("retention inventory exceeds fixed bounds")
+                entries.append({
+                    "path": path,
+                    "kind": "file",
+                    "mode": stat.S_IMODE(metadata.st_mode),
+                    "uid": metadata.st_uid,
+                    "nlink": metadata.st_nlink,
+                    "size": len(raw),
+                    "sha256": hashlib.sha256(raw).hexdigest(),
+                })
+            else:
+                raise ValueError(f"retention inventory contains unsafe entry: {path}")
+
+    try:
+        _ken21_retention_check_directory(os.fstat(root_fd), "task root")
+        kent_fd = _ken21_retention_open_directory(root_fd, ".kent", ".kent")
+        opened.append(kent_fd)
+        runtime_fd = _ken21_retention_open_directory(kent_fd, "runtime", ".kent/runtime")
+        opened.append(runtime_fd)
+        lock_name, sentinel_name = runtime_state_names("KEN-21")
+        with os.scandir(runtime_fd) as scan:
+            runtime_names = {item.name for item in scan}
+        if runtime_names != {lock_name, "KEN-21"} or sentinel_name in runtime_names:
+            raise ValueError("retention runtime inventory has unknown task state")
+        task_fd = _ken21_retention_open_directory(runtime_fd, "KEN-21", ".kent/runtime/KEN-21")
+        opened.append(task_fd)
+        record_directory(task_fd, ".kent/runtime/KEN-21")
+        with os.scandir(task_fd) as scan:
+            task_names = {item.name for item in scan}
+        if task_names != {"evidence-ledger.jsonl"}:
+            raise ValueError("retention runtime contains unknown KEN-21 entries")
+        for name, relative in (
