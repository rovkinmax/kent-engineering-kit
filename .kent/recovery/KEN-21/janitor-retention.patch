+def _ken21_retention_read(workspace, relative, limit):
+    parts = relative.split("/")
+    if (
+        not relative
+        or relative.startswith("/")
+        or any(part in {"", ".", ".."} for part in parts)
+    ):
+        raise ValueError("retention file path is not fixed and relative")
+    root_fd = os.open(
+        workspace,
+        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
+    )
+    _ken21_retention_check_directory(os.fstat(root_fd), "task root")
+    opened = [root_fd]
+    try:
+        parent = root_fd
+        for part in parts[:-1]:
+            parent = _ken21_retention_open_directory(parent, part, relative)
+            opened.append(parent)
+        raw, _ = _ken21_retention_read_at(parent, parts[-1], relative, limit)
+        return raw
+    finally:
+        for descriptor in reversed(opened):
+            os.close(descriptor)
