+def _ken21_retention_open_directory(parent, name, label):
+    descriptor = os.open(
+        name,
+        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
+        dir_fd=parent,
+    )
+    try:
+        _ken21_retention_check_directory(os.fstat(descriptor), label)
+        return descriptor
+    except BaseException:
+        os.close(descriptor)
+        raise
+
+
+def _ken21_retention_read_at(parent, name, label, limit):
+    descriptor = os.open(
+        name,
+        os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
+        dir_fd=parent,
+    )
+    try:
+        before = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(before.st_mode)
+            or before.st_uid != os.getuid()
+            or before.st_nlink != 1
+            or stat.S_IMODE(before.st_mode) & 0o7022
+            or before.st_size < 0
+            or before.st_size > limit
+        ):
+            raise ValueError(f"{label} is not an owned safe bounded file")
+        chunks = []
+        remaining = limit + 1
+        while remaining:
+            chunk = os.read(descriptor, min(65536, remaining))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        raw = b"".join(chunks)
+        after = os.fstat(descriptor)
+        current = os.stat(name, dir_fd=parent, follow_symlinks=False)
+        if (
+            len(raw) > limit
+            or _ken21_retention_identity(before) != _ken21_retention_identity(after)
+            or _ken21_retention_identity(after) != _ken21_retention_identity(current)
+        ):
+            raise ValueError(f"{label} changed during bounded read")
+        return raw, after
+    finally:
+        os.close(descriptor)
+
