+def bound_profile(project_id, primary, workspace_id, binding_sha256,
+                  expected_memory, *, core=None):
+    source = Path(__file__).with_name("profile_source.py")
+    raw = record_bytes(core, source, private=True, maximum=MAX_NATIVE_OUTPUT)
+    module = types.ModuleType("_kent_ordinary_r2_profile_source")
+    module.__file__ = str(source)
+    exec(compile(raw, str(source), "exec"), module.__dict__)
+    return module.read_bound_profile(
+        project_id, primary, workspace_id, binding_sha256, expected_memory,
+        reader=record_bytes, core=core,
+    )
 
 
