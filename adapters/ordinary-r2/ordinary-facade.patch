+def native_primary_workspace_id(project_id, primary, workspace):
+    rows = []
+    offset = 0
+    while True:
+        inventory = native_json([
+            "project", "workspaces", "--project", project_id,
+            "--offset", str(offset), "--limit", "100", "--json",
+        ], workspace)
+        items = inventory.get("workspaces")
+        if (inventory.get("project_id") != project_id
+                or inventory.get("offset") != offset
+                or not isinstance(items, list) or len(items) > 100
+                or len(rows) + len(items) > 256):
+            raise ValueError("native workspace inventory incomplete")
+        rows.extend(items)
+        if len(items) < 100:
+            break
+        offset += len(items)
+    matches = [
+        item for item in rows
+        if isinstance(item, dict) and item.get("is_default") is True
+        and item.get("root_path") == str(primary)
+    ]
+    if len(matches) != 1:
+        raise ValueError("native primary workspace unresolved")
+    return bootstrap_key(matches[0].get("workspace_id"))
 
 
