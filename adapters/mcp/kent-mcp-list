#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done
adapter_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
# shellcheck disable=SC1091
source "$adapter_dir/mcp-common.sh"

usage() {
  cat <<'EOF'
Usage: kent-mcp-list [server] [--schema] [--refresh] [--task-locator <native-task-id>] [mcporter list options]
EOF
}

if [[ "${1-}" == "--help" ]]; then
  usage
  exit 0
fi

server=""
invocation_id=""
standalone_binding=""
task_locator=""
if [[ $# -gt 0 && "$1" != --* ]]; then
  server="$1"
  shift
fi

schema=false
refresh=false
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --invocation-id)
      [[ -z "$invocation_id" && -n "${2-}" ]] || {
        printf 'invalid_invocation_id: provide one --invocation-id <uuid>\n' >&2
        exit 2
      }
      invocation_id="$2"
      shift 2
      ;;
    --task-locator)
      [[ -z "$task_locator" && -n "${2-}" ]] || {
        printf 'invalid_task_locator: provide one --task-locator <native-task-id>\n' >&2
        exit 2
      }
      task_locator="$2"
      shift 2
      ;;
    --standalone-binding)
      [[ -z "$standalone_binding" && -n "${2-}" ]] || {
        printf 'invalid_standalone_binding: provide one --standalone-binding <json>\n' >&2
        exit 2
      }
      standalone_binding="$2"
      shift 2
      ;;
    --schema)
      schema=true
      args+=("$1" "--json")
      shift
      ;;
    --refresh)
      refresh=true
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

root="$(workspace_root)"
mcp_resolve_binding "$root" "$standalone_binding" "$task_locator"
r2_mode=false
# shellcheck disable=SC2154
if [[ "$mcp_mode" == "r2" ]]; then
  r2_mode=true
  if ! mcp_validate_invocation_id "$invocation_id"; then
    printf 'mcp_invocation_id_required: R2 list calls require --invocation-id <uuid>\n' >&2
    exit 2
  fi
elif [[ -n "$invocation_id" || -n "$standalone_binding" ]]; then
  printf 'mcp_r2_binding_required: invocation controls cannot fall back to legacy mode\n' >&2
  exit 2
fi
require_mcporter
if [[ "$server" == "mobile" ]]; then
  config="$(mcporter_home_config_path)"
  [[ -f "$config" ]] || {
    printf 'mcporter_global_mobile_missing: run configure-mcporter --apply; expected %s\n' \
      "$config" >&2
    exit 2
  }
  config_display="mcporter-global-mobile"
else
  config="$(resolve_mcp_config)"
  config_display="${config:-mcporter-default}"
fi
cache_path=""
if [[ "$r2_mode" != true && "$schema" == true && -n "$server" ]]; then
  mkdir -p "$root/build/mcp-cache"
  cache_path="$root/build/mcp-cache/$(safe_name "$server")-schema.json"
  if [[ "$refresh" != true && -s "$cache_path" ]]; then
    cat "$cache_path"
    append_call_log "$root" "$server" "list-schema-cache" "$config_display" \
      "json" "$cache_path" 0 ""
    exit 0
  fi
fi

tmp_out="$(mktemp)"
tmp_err="$(mktemp)"
trap 'rm -f "$tmp_out" "$tmp_err"' EXIT

cmd=(mcporter)
if [[ "$server" == "serena" ]]; then
  serena_cmd="$(resolve_serena_command "$config")"
  serena_args=()
  while IFS= read -r -d '' arg; do
    serena_args+=("$arg")
  done < <(serena_stdio_args "$root")
  cmd+=(list --stdio "$serena_cmd" "${serena_args[@]}")
elif [[ "$server" == "mobile" ]]; then
  cmd+=(--config "$config" --root "$root" list "$server")
elif [[ -n "$server" ]] &&
  project_server_cmd="$(resolve_project_server_command "$root" "$server")"; then
  project_server_args=()
  while IFS= read -r -d '' arg; do
    project_server_args+=("$arg")
  done < <(project_server_stdio_args "$root" "$server")
  config_display="project-stdio:$project_server_cmd"
  cmd+=(list --stdio "$project_server_cmd" "${project_server_args[@]}")
else
  [[ -z "$config" ]] || cmd+=(--config "$config")
  cmd+=(--root "$root" list)
  [[ -z "$server" ]] || cmd+=("$server")
fi
cmd+=("${args[@]}")

config_sha256="$(mcp_config_sha256 "$config_display" "$config")"
if [[ "$r2_mode" == true ]]; then
  r2_tool="list"
  r2_output_mode="text"
  if [[ "$schema" == true ]]; then
    r2_tool="list-schema"
    r2_output_mode="json"
  else
    for arg in "${args[@]}"; do
      if [[ "$arg" == "--json" || "$arg" == "--json="* ]]; then
        r2_output_mode="json"
        break
      fi
    done
  fi
  r2_server="${server:-all}"
  permitted_metadata="$(
    mcp_make_permitted_metadata list "$r2_server" "$r2_tool" \
      "$config_sha256" "$r2_output_mode" false false
  )" || exit $?
  request_sha256="$(
    mcp_sha256_fields \
      list "$server" "$config_display" "$config" "$config_sha256" \
      "$schema" "$refresh" "$r2_output_mode" \
      "${#args[@]}" "${args[@]}" "${#cmd[@]}" "${cmd[@]}"
  )" || exit $?
  mcp_begin_invocation "$invocation_id" "$request_sha256" \
    "$permitted_metadata" || exit $?
fi

if [[ "$r2_mode" == true && "$schema" == true && -n "$server" ]]; then
  cache_key="$(mcp_sha256_fields list-schema "$server" "$config_sha256")"
  if [[ "$refresh" != true ]]; then
    mcp_read_cache "$cache_key" || exit $?
    # shellcheck disable=SC2154
    if [[ "$mcp_cache_state" == "hit" ]]; then
      if ! mcp_validate_schema_output "$mcp_cache_object_path"; then
        printf 'mcp_project_memory_invalid_response: cached schema is not bounded JSON object\n' >&2
        exit 2
      fi
      # shellcheck disable=SC2154
      mcp_finish_invocation "$invocation_id" 0 "" \
        "$mcp_cache_object_sha256" || exit $?
      # shellcheck disable=SC2154
      cat "$mcp_cache_object_path"
      exit 0
    fi
  fi
fi

set +e
with_server_lock_if_needed "$server" "$root" "${cmd[@]}" >"$tmp_out" 2>"$tmp_err"
exit_code=$?
set -e

if [[ "$r2_mode" != true ]]; then
  cat "$tmp_out"
  [[ ! -s "$tmp_err" ]] || cat "$tmp_err" >&2
fi

raw_log_path=""
if [[ $exit_code -eq 0 && -n "$cache_path" ]]; then
  if ! grep -Eqi \
    'tools unavailable|Tools: <unavailable>|Next: run .*auth|Non-200 status code' \
    "$tmp_out"; then
    cp "$tmp_out" "$cache_path"
    raw_log_path="$cache_path"
  fi
fi

error_code=""
[[ $exit_code -eq 0 ]] || error_code="mcporter_list_failed"
if [[ "$r2_mode" == true ]]; then
  object_sha256=""
  if [[ "$schema" == true && -n "$server" && $exit_code -eq 0 ]] &&
    ! grep -Eqi \
      'tools unavailable|Tools: <unavailable>|Next: run .*auth|Non-200 status code' \
      "$tmp_out" &&
    mcp_validate_schema_output "$tmp_out"; then
    mcp_put_artifact "$invocation_id" schema "$tmp_out" || exit $?
    # shellcheck disable=SC2154
    object_sha256="$mcp_object_sha256"
    mcp_publish_cache "$invocation_id" "$cache_key" "$object_sha256" || exit $?
  fi
  mcp_finish_invocation "$invocation_id" "$exit_code" "$error_code" \
    "$object_sha256" || exit $?
  cat "$tmp_out"
  [[ ! -s "$tmp_err" ]] || cat "$tmp_err" >&2
  exit "$exit_code"
fi
append_call_log "$root" "${server:-all}" "list" "$config_display" "json" \
  "$raw_log_path" "$exit_code" "$error_code"

exit "$exit_code"
