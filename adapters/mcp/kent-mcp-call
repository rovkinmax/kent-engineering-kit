#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done
adapter_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
# shellcheck disable=SC1091
source "$adapter_dir/mcp-common.sh"

usage() {
  cat <<'EOF'
Usage: kent-mcp-call <server.tool> [arguments] [safe-output-mode] [--save-raw] [--raw-dir <dir>] [--no-save-raw] [--allow-mutate]
       kent-mcp-call --self-test

Safe output modes:
  --quiet
  --digest-output
  --assert-contains <literal>
  --assert-not-contains <literal>
  --assert-json-true <JSON-pointer>
  --hash-matches <extended-regex>
  --marker-present <literal>

Safe modes except --quiet emit the sanitized kent-mcp-result-v1 outcome
contract. --quiet remains process-exit-only. Raw responses are not written to
a separate artifact by default, but normal stdout is still retained by the
Kent shell transcript. Mobile tools other than device therefore require a
safe output mode.
EOF
}

if [[ "${1-}" == "--help" || $# -lt 1 ]]; then
  usage
  [[ $# -lt 1 ]] && exit 2 || exit 0
fi

self_test=false
[[ "${1-}" == "--self-test" ]] && self_test=true

target="$1"
shift

allow_mutate=false
save_raw=false
raw_save_requested=false
raw_dir=""
output_mode="text"
safe_output_mode="raw"
assert_contains=()
assert_not_contains=()
assert_json_true=()
hash_matches_regex=""
marker_literals=()
args=()

set_safe_output_mode() {
  local requested="$1"
  if [[ "$safe_output_mode" != "raw" && "$safe_output_mode" != "$requested" ]]; then
    printf 'conflicting_safe_output_modes: %s and %s\n' \
      "$safe_output_mode" "$requested" >&2
    exit 2
  fi
  safe_output_mode="$requested"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-mutate)
      allow_mutate=true
      shift
      ;;
    --quiet)
      set_safe_output_mode quiet
      shift
      ;;
    --digest-output)
      set_safe_output_mode digest
      shift
      ;;
    --assert-contains)
      set_safe_output_mode assertion
      value="${2-}"
      [[ -n "$value" ]] || {
        printf 'missing_value: --assert-contains requires a literal\n' >&2
        exit 2
      }
      assert_contains+=("$value")
      shift 2
      ;;
    --assert-not-contains)
      set_safe_output_mode assertion
      value="${2-}"
      [[ -n "$value" ]] || {
        printf 'missing_value: --assert-not-contains requires a literal\n' >&2
        exit 2
      }
      assert_not_contains+=("$value")
      shift 2
      ;;
    --assert-json-true)
      set_safe_output_mode json_assertion
      [[ $# -ge 2 ]] || {
        printf 'missing_value: --assert-json-true requires a JSON pointer\n' >&2
        exit 2
      }
      assert_json_true+=("$2")
      shift 2
      ;;
    --hash-matches)
      set_safe_output_mode extract
      value="${2-}"
      [[ -n "$value" ]] || {
        printf 'missing_value: --hash-matches requires an extended regex\n' >&2
        exit 2
      }
      [[ -z "$hash_matches_regex" ]] || {
        printf 'duplicate_safe_output_option: --hash-matches\n' >&2
        exit 2
      }
      hash_matches_regex="$value"
      shift 2
      ;;
    --marker-present)
      set_safe_output_mode extract
      value="${2-}"
      [[ -n "$value" ]] || {
        printf 'missing_value: --marker-present requires a literal\n' >&2
        exit 2
      }
      marker_literals+=("$value")
      shift 2
      ;;
    --save-raw)
      save_raw=true
      raw_save_requested=true
      shift
      ;;
    --no-save-raw)
      save_raw=false
      raw_save_requested=false
      shift
      ;;
    --raw-dir)
      raw_dir="${2-}"
      [[ -n "$raw_dir" ]] || {
        printf 'missing_value: --raw-dir requires a value\n' >&2
        exit 2
      }
      save_raw=true
      raw_save_requested=true
      shift 2
      ;;
    --output)
      output_mode="${2-}"
      [[ -n "$output_mode" ]] || {
        printf 'missing_value: --output requires a value\n' >&2
        exit 2
      }
      args+=("$1" "$2")
      shift 2
      ;;
    --output=*)
      output_mode="${1#--output=}"
      args+=("$1")
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if ! python3 - "$hash_matches_regex" \
  "${#assert_contains[@]}" "${assert_contains[@]}" \
  "${#assert_not_contains[@]}" "${assert_not_contains[@]}" \
  "${#assert_json_true[@]}" "${assert_json_true[@]}" \
  "${#marker_literals[@]}" "${marker_literals[@]}" <<'PY'
import sys

MAX_SELECTORS = 32
MAX_SELECTOR_BYTES = 4096

try:
    pattern = sys.argv[1]
    index = 2

    def take_values():
        global index
        count = int(sys.argv[index])
        index += 1
        values = sys.argv[index:index + count]
        if len(values) != count:
            raise ValueError
        index += count
        return values

    contains = take_values()
    not_contains = take_values()
    json_pointers = take_values()
    markers = take_values()
    if index != len(sys.argv):
        raise ValueError

    selectors = contains + not_contains + json_pointers + markers
    if pattern:
        selectors.append(pattern)
    if len(selectors) > MAX_SELECTORS:
        raise ValueError
    if any(len(value.encode("utf-8")) > MAX_SELECTOR_BYTES for value in selectors):
        raise ValueError

    for pointer in json_pointers:
        if pointer == "":
            continue
        if not pointer.startswith("/"):
            raise ValueError
        position = 0
        while position < len(pointer):
            if pointer[position] == "~":
                if (
                    position + 1 >= len(pointer)
                    or pointer[position + 1] not in "01"
                ):
                    raise ValueError
                position += 2
            else:
                position += 1
except (IndexError, UnicodeError, ValueError):
    print("safe_output_arguments_invalid", file=sys.stderr)
    raise SystemExit(2)
PY
then
  printf 'safe_output_arguments_invalid: selector, pointer, or count limit\n' >&2
  exit 2
fi

server="${target%%.*}"
tool="${target#*.}"
if [[ "$self_test" != true && ( "$server" == "$target" || -z "$server" || -z "$tool" ) ]]; then
  printf 'invalid_target: expected <server.tool>, got %s\n' "$target" >&2
  exit 2
fi

arg_value() {
  local key="$1"
  local arg
  for arg in "${args[@]}"; do
    if [[ "$arg" == "$key="* ]]; then
      printf '%s\n' "${arg#*=}"
      return 0
    fi
  done
  return 1
}

action_is_one_of() {
  local action="$1"
  shift
  local allowed
  for allowed in "$@"; do
    [[ "$action" == "$allowed" ]] && return 0
  done
  return 1
}

is_mobile_server() {
  [[ "$1" == "mobile" || "$1" == mobile-* ]]
}

assert_mobile_exact_target() {
  local server_name="$1"
  local tool_name="$2"
  local platform device_id

  [[ "$server_name" == "mobile" ]] || return 0

  case "$tool_name" in
    device)
      return 0
      ;;
    screen|input|ui|app)
      platform="$(arg_value platform || true)"
      device_id="$(arg_value deviceId || true)"
      if [[ -z "$platform" || -z "$device_id" ]]; then
        printf 'mobile_exact_target_required: mobile.%s requires non-empty platform and deviceId arguments\n' \
          "$tool_name" >&2
        exit 2
      fi
      ;;
    system|flow)
      printf 'unsupported_mobile_implicit_target: mobile.%s cannot prove one exact device through the current schema; use an exact project platform adapter\n' \
        "$tool_name" >&2
      exit 2
      ;;
  esac
}

mobile_tool_mutates() {
  local tool_name="$1"
  local action_name="$2"

  case "$tool_name" in
    device)
      ! action_is_one_of "$action_name" list get_target list_modules
      ;;
    screen)
      ! action_is_one_of "$action_name" capture annotate
      ;;
    input|flow)
      return 0
      ;;
    ui)
      ! action_is_one_of "$action_name" tree find analyze wait assert_visible assert_gone
      ;;
    app)
      ! action_is_one_of "$action_name" list
      ;;
    system)
      ! action_is_one_of "$action_name" wait logs info webview clipboard_get metrics
      ;;
    browser)
      ! action_is_one_of "$action_name" list_sessions snapshot screenshot wait_for_selector
      ;;
    desktop)
      ! action_is_one_of "$action_name" windows clipboard_get performance monitors get_target_pid
      ;;
    store)
      ! action_is_one_of "$action_name" get_releases get_versions
      ;;
    visual)
      ! action_is_one_of "$action_name" list
      ;;
    recorder)
      ! action_is_one_of "$action_name" status list show
      ;;
    sync)
      ! action_is_one_of "$action_name" status list
      ;;
    accessibility)
      ! action_is_one_of "$action_name" audit check summary rules
      ;;
    performance)
      ! action_is_one_of "$action_name" snapshot compare crashes framestats
      ;;
    autopilot)
      ! action_is_one_of "$action_name" status
      ;;
    sandbox)
      ! action_is_one_of "$action_name" prefs_read file_list file_read
      ;;
    intent)
      ! action_is_one_of "$action_name" services
      ;;
    sensor)
      ! action_is_one_of "$action_name" notifications
      ;;
    network)
      ! action_is_one_of "$action_name" traffic connectivity
      ;;
    *)
      return 0
      ;;
  esac
}

target_requires_mutation_approval() {
  local target_name="$1"
  local action_name="$2"
  local target_server="${target_name%%.*}"
  local target_tool="${target_name#*.}"
  local policy_hook policy_result policy_exit

  if policy_hook="$(resolve_project_policy_hook "$(workspace_root)")"; then
    set +e
    policy_result="$("$policy_hook" "$target_name" "$action_name")"
    policy_exit=$?
    set -e
    if [[ $policy_exit -ne 0 ]]; then
      printf 'mcp_policy_hook_failed: %s exited %s\n' \
        "$policy_hook" "$policy_exit" >&2
      exit 2
    fi
    case "$policy_result" in
      read-only) return 1 ;;
      mutating) return 0 ;;
      blocked)
        printf 'mcp_policy_blocked: %s\n' "$target_name" >&2
        exit 2
        ;;
      ""|inherit) ;;
      *)
        printf 'mcp_policy_invalid: %s returned %s\n' \
          "$policy_hook" "$policy_result" >&2
        exit 2
        ;;
    esac
  fi

  if is_mobile_server "$target_server"; then
    mobile_tool_mutates "$target_tool" "$action_name"
    return
  fi

  case "$target_name" in
    jetbrains.rename_refactoring|jetbrains.reformat_file|jetbrains.execute_run_configuration)
      return 0
      ;;
    jetbrains.get_*|jetbrains.search_*|jetbrains.find_*|jetbrains.list_*)
      return 1
      ;;
    jetbrains.build_project)
      printf 'unsupported_mcp_tool: jetbrains.build_project is intentionally not used; run the project build tool directly\n' >&2
      exit 2
      ;;
    firebase.firebase_login|firebase.firebase_logout|firebase.firebase_create_project|firebase.firebase_create_app|firebase.firebase_create_android_sha|firebase.firebase_update_environment|firebase.firebase_init|firebase.firebase_deploy|firebase.dataconnect_execute|firebase.auth_update_user|firebase.auth_set_sms_region_policy|firebase.messaging_send_message|firebase.remoteconfig_update_template|firebase.crashlytics_create_note|firebase.crashlytics_delete_note|firebase.crashlytics_update_issue|firebase.realtimedatabase_set_data|firebase.firestore_add_document|firebase.firestore_update_document|firebase.firestore_delete_document|firebase.firestore_create_database|firebase.firestore_update_database|firebase.firestore_delete_database|firebase.firestore_create_index|firebase.firestore_delete_index)
      return 0
      ;;
    firebase.firebase_get_*|firebase.firebase_list_*|firebase.crashlytics_get_*|firebase.crashlytics_list_*)
      return 1
      ;;
    serena.get_symbols_overview|serena.find_symbol|serena.find_referencing_symbols|serena.search_for_pattern|serena.list_dir|serena.find_file|serena.read_memory|serena.list_memories|serena.get_current_config|serena.check_onboarding_performed)
      return 1
      ;;
    figma.get_*|figma.list_*|notion.notion-fetch|notion.notion-search|package-version-check.*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

assert_policy() {
  local test_target="$1"
  local action="$2"
  local expected="$3"
  local actual="read-only"
  target_requires_mutation_approval "$test_target" "$action" && actual="mutating"
  [[ "$actual" == "$expected" ]] || {
    printf 'self_test_failed: %s action=%s expected %s, got %s\n' \
      "$test_target" "$action" "$expected" "$actual" >&2
    return 1
  }
}

run_self_test() {
  assert_policy mobile.device list read-only
  assert_policy mobile.device enable_module mutating
  assert_policy mobile.input tap mutating
  assert_policy mobile.ui assert_visible read-only
  assert_policy mobile.ui tap_text mutating
  assert_policy mobile.future inspect mutating
  assert_policy firebase.firebase_get_environment "" read-only
  assert_policy firebase.firebase_deploy "" mutating
  assert_policy unknown.inspect "" mutating
}

if [[ "$self_test" == true ]]; then
  run_self_test
  exit 0
fi

if [[ "$safe_output_mode" != "raw" && "$raw_save_requested" == true ]]; then
  printf 'safe_output_cannot_save_raw: remove --save-raw/--raw-dir\n' >&2
  exit 2
fi

action="$(arg_value action || true)"
if [[ "$server" == "mobile" && "$tool" == "device" ]] &&
  action_is_one_of "$action" set set_target get_target; then
  printf 'unsupported_mobile_target_state: default mobile is stateless; use action=list and pass platform plus deviceId to every target-specific call\n' >&2
  exit 2
fi

assert_mobile_exact_target "$server" "$tool"

if is_mobile_server "$server" && [[ "$tool" != "device" ]] &&
  [[ "$safe_output_mode" == "raw" ]]; then
  printf 'sensitive_mobile_output_requires_safe_mode: use a safe output mode, including --assert-json-true for known boolean state\n' >&2
  exit 2
fi

if target_requires_mutation_approval "$target" "$action" &&
  [[ "$allow_mutate" != true ]]; then
  printf 'mutating_mcp_requires_allow: %s requires --allow-mutate\n' "$target" >&2
  exit 2
fi

root="$(workspace_root)"
require_mcporter
if [[ "$server" == "mobile" ]]; then
  config="$(mcporter_home_config_path)"
  [[ -f "$config" ]] || {
    printf 'mcporter_global_mobile_missing: run configure-mcporter --apply; expected %s\n' \
      "$config" >&2
    exit 2
  }
  config_display="mcporter-global-mobile"
else
  config="$(resolve_mcp_config)"
  config_display="${config:-mcporter-default}"
fi

tmp_out="$(mktemp)"
tmp_err="$(mktemp)"
tmp_safe_out="$(mktemp)"
tmp_safe_err="$(mktemp)"
trap 'rm -f "$tmp_out" "$tmp_err" "$tmp_safe_out" "$tmp_safe_err"' EXIT

cmd=(mcporter)
if [[ "$server" == "serena" ]]; then
  serena_cmd="$(resolve_serena_command "$config")"
  serena_args=()
  while IFS= read -r -d '' arg; do
    serena_args+=("$arg")
  done < <(serena_stdio_args "$root")
  cmd+=(call --stdio "$serena_cmd" "${serena_args[@]}" "$tool" "${args[@]}")
elif [[ "$server" == "mobile" ]]; then
  cmd+=(--config "$config" --root "$root" call "$target" "${args[@]}")
elif project_server_cmd="$(resolve_project_server_command "$root" "$server")"; then
  project_server_args=()
  while IFS= read -r -d '' arg; do
    project_server_args+=("$arg")
  done < <(project_server_stdio_args "$root" "$server")
  config_display="project-stdio:$project_server_cmd"
  cmd+=(call --stdio "$project_server_cmd" "${project_server_args[@]}" "$tool" "${args[@]}")
else
  [[ -z "$config" ]] || cmd+=(--config "$config")
  cmd+=(--root "$root" call "$target" "${args[@]}")
fi

set +e
with_server_lock_if_needed "$server" "$root" "${cmd[@]}" >"$tmp_out" 2>"$tmp_err"
exit_code=$?
set -e

effective_exit_code="$exit_code"
error_code=""

render_safe_result() {
  python3 - "$safe_output_mode" "$tmp_out" "$exit_code" \
    "${#assert_contains[@]}" "${assert_contains[@]}" \
    "${#assert_not_contains[@]}" "${assert_not_contains[@]}" \
    "${#assert_json_true[@]}" "${assert_json_true[@]}" \
    "$hash_matches_regex" \
    "${#marker_literals[@]}" "${marker_literals[@]}" <<'PY'
import hashlib
import json
import math
import re
import subprocess
import sys

MAX_DOCUMENT_BYTES = 1024 * 1024
MAX_UNIQUE_HASHES = 256

try:
    mode, path = sys.argv[1:3]
    transport_exit = int(sys.argv[3])
    index = 4

    def take_values():
        global index
        count = int(sys.argv[index])
        index += 1
        values = sys.argv[index:index + count]
        if len(values) != count:
            raise ValueError
        index += count
        return values

    contains = take_values()
    not_contains = take_values()
    json_pointers = take_values()
    pattern = sys.argv[index]
    index += 1
    markers = take_values()
    if index != len(sys.argv):
        raise ValueError
except (IndexError, ValueError):
    print("processing_failed", file=sys.stderr)
    raise SystemExit(3)

literal_count = len(contains) + len(not_contains)
assertion_kind = {
    "assertion": "literal",
    "json_assertion": "json_boolean",
}.get(mode, "none")
assertion_requested = mode in {"assertion", "json_assertion"}


def result_base(transport, processing, assertion, kind):
    return {
        "schema": "kent-mcp-result-v1",
        "transport": transport,
        "processing": processing,
        "action": "unknown",
        "assertion": assertion,
        "assertionKind": kind,
    }


def add_unavailable_mode_fields(result):
    if mode == "assertion":
        result.update(
            {
                "contains": len(contains),
                "notContains": len(not_contains),
                "failedContains": 0,
                "failedNotContains": 0,
                "assertionResults": ["unknown"] * literal_count,
            }
        )
    elif mode == "json_assertion":
        result.update(
            {
                "assertionCount": len(json_pointers),
                "failedAssertions": 0,
                "unknownAssertions": len(json_pointers),
                "assertionResults": ["unknown"] * len(json_pointers),
            }
        )
    elif mode == "extract":
        result["markerCount"] = len(markers)


def emit(result):
    sys.stdout.write(json.dumps(result, separators=(",", ":"), allow_nan=False))
    sys.stdout.write("\n")


if transport_exit != 0:
    result = result_base(
        "failed",
        "not_attempted",
        "unknown" if assertion_requested else "not_requested",
        assertion_kind,
    )
    add_unavailable_mode_fields(result)
    emit(result)
    raise SystemExit(0)


def bounded_bytes():
    with open(path, "rb") as source:
        data = source.read(MAX_DOCUMENT_BYTES + 1)
    if len(data) > MAX_DOCUMENT_BYTES:
        raise ValueError
    return data


def processing_failure():
    result = result_base(
        "succeeded",
        "failed",
        "unknown" if assertion_requested else "not_requested",
        assertion_kind,
    )
    add_unavailable_mode_fields(result)
    emit(result)
    print("processing_failed", file=sys.stderr)
    raise SystemExit(3)


def reject_constant(_value):
    raise ValueError


def parse_finite_float(value):
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError
    return parsed


def object_without_duplicate_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError
        result[key] = value
    return result


def decode_pointer(pointer):
    if pointer == "":
        return []
    decoded = []
    for token in pointer[1:].split("/"):
        value = []
        position = 0
        while position < len(token):
            char = token[position]
            if char != "~":
                value.append(char)
                position += 1
                continue
            escaped = token[position + 1]
            value.append("~" if escaped == "0" else "/")
            position += 2
        decoded.append("".join(value))
    return decoded


def select_boolean(document, tokens):
    selected = document
    for token in tokens:
        if isinstance(selected, dict):
            if token not in selected:
                return "unknown"
            selected = selected[token]
        elif isinstance(selected, list):
            if (
                token == "-"
                or not token.isascii()
                or not token.isdecimal()
                or (len(token) > 1 and token.startswith("0"))
            ):
                return "unknown"
            if len(token) > len(str(len(selected))):
                return "unknown"
            position = int(token)
            if position >= len(selected):
                return "unknown"
            selected = selected[position]
        else:
            return "unknown"
    if selected is True:
        return "passed"
    if selected is False:
        return "failed"
    return "unknown"


try:
    if mode == "digest":
        digest = hashlib.sha256()
        byte_count = 0
        line_count = 0
        with open(path, "rb") as source:
            while True:
                chunk = source.read(65536)
                if not chunk:
                    break
                digest.update(chunk)
                byte_count += len(chunk)
                line_count += chunk.count(b"\n")
        result = result_base(
            "succeeded", "succeeded", "not_requested", "none"
        )
        result.update(
            {
                "sha256": digest.hexdigest(),
                "bytes": byte_count,
                "lines": line_count,
            }
        )
        emit(result)
        raise SystemExit(0)

    raw = bounded_bytes()
    if mode == "assertion":
        outcomes = []
        failed_contains = 0
        failed_not_contains = 0
        for value in contains:
            completed = subprocess.run(
                ["grep", "-Fq", "--", value, path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if completed.returncode not in (0, 1):
                raise ValueError
            passed = completed.returncode == 0
            outcomes.append("passed" if passed else "failed")
            failed_contains += not passed
        for value in not_contains:
            completed = subprocess.run(
                ["grep", "-Fq", "--", value, path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if completed.returncode not in (0, 1):
                raise ValueError
            passed = completed.returncode == 1
            outcomes.append("passed" if passed else "failed")
            failed_not_contains += not passed
        aggregate = "failed" if "failed" in outcomes else "passed"
        result = result_base("succeeded", "succeeded", aggregate, "literal")
        result.update(
            {
                "contains": len(contains),
                "notContains": len(not_contains),
                "failedContains": failed_contains,
                "failedNotContains": failed_not_contains,
                "assertionResults": outcomes,
            }
        )
        emit(result)
        if aggregate == "failed":
            print("assertion_failed", file=sys.stderr)
            raise SystemExit(4)
        raise SystemExit(0)

    if mode == "json_assertion":
        document = json.loads(
            raw.decode("utf-8", errors="strict"),
            object_pairs_hook=object_without_duplicate_keys,
            parse_constant=reject_constant,
            parse_float=parse_finite_float,
        )
        outcomes = [
            select_boolean(document, decode_pointer(pointer))
            for pointer in json_pointers
        ]
        if "failed" in outcomes:
            aggregate = "failed"
        elif "unknown" in outcomes:
            aggregate = "unknown"
        else:
            aggregate = "passed"
        result = result_base(
            "succeeded", "succeeded", aggregate, "json_boolean"
        )
        result.update(
            {
                "assertionCount": len(outcomes),
                "failedAssertions": outcomes.count("failed"),
                "unknownAssertions": outcomes.count("unknown"),
                "assertionResults": outcomes,
            }
        )
        emit(result)
        if aggregate == "failed":
            print("assertion_failed", file=sys.stderr)
            raise SystemExit(4)
        if aggregate == "unknown":
            print("assertion_unknown", file=sys.stderr)
            raise SystemExit(5)
        raise SystemExit(0)

    if mode == "extract":
        text = raw.decode("utf-8", errors="strict")
        expression = re.compile(pattern) if pattern else None
        occurrence_count = 0
        hashes = []
        seen = set()
        if expression is not None:
            for match in expression.finditer(text):
                occurrence_count += 1
                digest = hashlib.sha256(
                    match.group(0).encode("utf-8")
                ).hexdigest()
                if digest in seen:
                    continue
                if len(hashes) >= MAX_UNIQUE_HASHES:
                    raise ValueError
                seen.add(digest)
                hashes.append(digest)
        result = result_base(
            "succeeded", "succeeded", "not_requested", "none"
        )
        result.update(
            {
                "occurrenceCount": occurrence_count,
                "uniqueCount": len(hashes),
                "hashes": hashes,
                "markerCount": len(markers),
                "markersPresent": [marker in text for marker in markers],
            }
        )
        emit(result)
        raise SystemExit(0)

    raise ValueError
except SystemExit:
    raise
except Exception:
    processing_failure()
PY
}

if [[ "$safe_output_mode" != "raw" && "$safe_output_mode" != "quiet" ]]; then
  set +e
  render_safe_result >"$tmp_safe_out" 2>"$tmp_safe_err"
  renderer_exit=$?
  set -e

  if [[ -s "$tmp_safe_out" ]]; then
    cat "$tmp_safe_out"
  else
    fallback_transport="succeeded"
    fallback_processing="failed"
    fallback_assertion="not_requested"
    fallback_kind="none"
    if [[ $exit_code -ne 0 ]]; then
      fallback_transport="failed"
      fallback_processing="not_attempted"
    fi
    case "$safe_output_mode" in
      assertion)
        fallback_assertion="unknown"
        fallback_kind="literal"
        ;;
      json_assertion)
        fallback_assertion="unknown"
        fallback_kind="json_boolean"
        ;;
    esac
    printf '{"schema":"kent-mcp-result-v1","transport":"%s","processing":"%s","action":"unknown","assertion":"%s","assertionKind":"%s"}\n' \
      "$fallback_transport" "$fallback_processing" \
      "$fallback_assertion" "$fallback_kind"
    renderer_exit=3
  fi

  if [[ $exit_code -ne 0 ]]; then
    printf 'mcp_call_failed: %s exited %s; raw output suppressed\n' \
      "$target" "$exit_code" >&2
    effective_exit_code="$exit_code"
    error_code="mcporter_call_failed"
  else
    case "$renderer_exit" in
      0)
        effective_exit_code=0
        ;;
      3)
        printf 'mcp_safe_processing_failed: raw output suppressed\n' >&2
        effective_exit_code=3
        error_code="mcp_safe_processing_failed"
        ;;
      4)
        printf 'mcp_output_assertion_failed: raw output suppressed\n' >&2
        effective_exit_code=3
        error_code="mcp_output_assertion_failed"
        ;;
      5)
        printf 'mcp_output_assertion_unknown: raw output suppressed\n' >&2
        effective_exit_code=3
        error_code="mcp_output_assertion_unknown"
        ;;
      *)
        printf 'mcp_safe_processing_failed: raw output suppressed\n' >&2
        effective_exit_code=3
        error_code="mcp_safe_processing_failed"
        ;;
    esac
  fi

  raw_path=""
  append_call_log "$root" "$server" "$tool" "$config_display" "$output_mode" \
    "$raw_path" "$effective_exit_code" "$error_code" "$safe_output_mode"
  exit "$effective_exit_code"
fi

effective_exit_code="$exit_code"
error_code=""

if [[ "$safe_output_mode" == "raw" ]]; then
  cat "$tmp_out"
  if [[ $exit_code -ne 0 ]]; then
    [[ ! -s "$tmp_err" ]] || cat "$tmp_err" >&2
    error_code="mcporter_call_failed"
  else
    [[ ! -s "$tmp_err" ]] || cat "$tmp_err" >&2
  fi
elif [[ $exit_code -ne 0 ]]; then
    printf 'mcp_call_failed: %s exited %s; raw output suppressed\n' \
      "$target" "$exit_code" >&2
  error_code="mcporter_call_failed"
fi

raw_path=""
if [[ "$save_raw" == true ]]; then
  if [[ -z "$raw_dir" ]]; then
    raw_dir="$(artifact_root "$root")/_mcp-raw"
  fi
  server_dir="$raw_dir/$(safe_name "$server")"
  mkdir -p "$server_dir"
  raw_path="$server_dir/$(safe_name "$tool")-$(timestamp_utc).$(output_ext "$output_mode")"
  cp "$tmp_out" "$raw_path"
fi

append_call_log "$root" "$server" "$tool" "$config_display" "$output_mode" \
  "$raw_path" "$effective_exit_code" "$error_code" "$safe_output_mode"

