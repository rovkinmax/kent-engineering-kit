#!/usr/bin/env python3
"""Exercise bounded scenario evidence, verifier recovery and release closure."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
import unittest


ROOT = Path(__file__).resolve().parents[1]
BASELINE = "bf4a29c288410be93321bd53406c424d13024e71"
CHILD_RELATIVE = ".kent/scripts/workflow-compile-verify"
TASK = ":app:compileDevDebugKotlin"
EVIDENCE_DIR = ROOT / "build/kent-workflow/OSM-112"
MAX_LOG_BYTES = 16_384
WORK_KINDS = ("feature", "bugfix", "refactor", "migration", "dependency", "test")


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def git(*args: str, cwd: Path) -> str:
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def capture_baseline_red() -> dict[str, object]:
    head = git("rev-parse", "HEAD", cwd=ROOT)
    if head != BASELINE:
        raise RuntimeError(f"Expected immutable task baseline {BASELINE}, found {head}")

    baseline_child = subprocess.run(
        ["git", "-C", str(ROOT), "show", f"{BASELINE}:{CHILD_RELATIVE}"],
        check=True,
        capture_output=True,
    ).stdout
    current_child = (ROOT / CHILD_RELATIVE).read_bytes()
    if current_child != baseline_child:
        raise RuntimeError("Compile verifier differs from the immutable baseline")

    with tempfile.TemporaryDirectory(prefix="osome-baseline-red-") as temporary:
        synthetic_root = Path(temporary) / ".kent/worktrees/mock-scenario-baseline"
        child_path = synthetic_root / CHILD_RELATIVE
        child_path.parent.mkdir(parents=True)
        child_path.write_bytes(baseline_child)
        child_path.chmod(0o755)

        fake_compile = synthetic_root / "tools/agentw"
        fake_compile.parent.mkdir(parents=True)
        fake_compile.write_text(
            "#!/bin/sh\n"
            "printf '%s\\n' \"$*\" > invocation-args.txt\n"
            "printf 'mock compile success\\n'\n"
            "exit 0\n",
            encoding="utf-8",
        )
        fake_compile.chmod(0o755)

        git("init", "-q", cwd=synthetic_root)
        git("config", "user.name", "Appsome baseline fixture", cwd=synthetic_root)
        git("config", "user.email", "baseline@example.invalid", cwd=synthetic_root)
        git("add", CHILD_RELATIVE, "tools/agentw", cwd=synthetic_root)
        git("commit", "-q", "-m", "baseline compile fixture", cwd=synthetic_root)
        synthetic_commit = git("rev-parse", "HEAD", cwd=synthetic_root)

        result = subprocess.run(
            [str(child_path)],
            cwd=synthetic_root,
            input="{}\n",
            text=True,
            capture_output=True,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            check=True,
        )
        try:
            output = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise RuntimeError("Baseline compile child emitted invalid JSON") from error
        invocation = (synthetic_root / "invocation-args.txt").read_text(
            encoding="utf-8"
        ).strip()
        compiler_log = (
            synthetic_root / "build/kent-workflow/compile-dev-debug.log"
        ).read_bytes()
        if output != {"transition": "passed"}:
            raise RuntimeError(f"Expected baseline red result 'passed', got {output!r}")
        if invocation != TASK or b"mock compile success\n" not in compiler_log:
            raise RuntimeError("The fixed fake compiler did not complete the expected task")

        bounded_log = (
            "Compile child stdout:\n"
            f"{result.stdout}"
            "Compile child stderr:\n"
            f"{result.stderr}"
            "Fake compiler log:\n"
            f"{compiler_log.decode('utf-8', errors='replace')}"
        ).encode("utf-8")
        if len(bounded_log) > MAX_LOG_BYTES:
            raise RuntimeError("Baseline reproduction log exceeded its size limit")

        EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
        log_path = EVIDENCE_DIR / "pre-edit-red.log"
        log_path.write_bytes(bounded_log)
        evidence: dict[str, object] = {
            "schema": "appsome-mock-scenario-pre-edit-red-v1",
            "task": "OSM-112",
            "immutable_baseline": BASELINE,
            "compile_child_path": CHILD_RELATIVE,
            "compile_child_sha256": sha256(baseline_child),
            "synthetic_git_head": synthetic_commit,
            "scenario_evidence_present": False,
            "expected_transition": "blocked",
            "observed_transition": output["transition"],
            "fixed_fake_compile": {
                "task": invocation,
                "result": "success",
            },
            "reproduced": True,
            "bounded_log_path": str(log_path.relative_to(ROOT)),
            "bounded_log_sha256": sha256(bounded_log),
        }
        evidence_path = EVIDENCE_DIR / "pre-edit-red.json"
        evidence_path.write_text(
            json.dumps(evidence, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        return evidence


class ScenarioFixture:
    def __init__(self, work_kind: str = "feature") -> None:
        self.temporary = tempfile.TemporaryDirectory(prefix="appsome-scenario-suite-")
        self.root = Path(self.temporary.name).resolve() / "repo"
        self.root.mkdir()
        self.work_kind = work_kind
        self.helper = self.root / ".kent/scripts/workflow-mock-scenario-evidence"
        self.helper.parent.mkdir(parents=True)
        shutil.copyfile(ROOT / ".kent/scripts/workflow-mock-scenario-evidence", self.helper)
        self.helper.chmod(0o755)
        (self.root / ".gitignore").write_text("**/build/\n", encoding="utf-8")
        self.source = self.root / "src/main/Label.kt"
        self.source.parent.mkdir(parents=True)
        self.source.write_text('fun label() = "old"\n', encoding="utf-8")
        self.fixture_path = self.root / "src/test/resources/label.json"
        self.fixture_path.parent.mkdir(parents=True)
        self.fixture_path.write_text('{"label":"old","expected":"OLD"}\n', encoding="utf-8")
        self.scenario_path = "src/test/label_scenario.py"
        self.case_id = "com.example.LabelScenario#showsUpdatedLabel"
        scenario = self.root / self.scenario_path
        scenario.write_text(
            "import json\nfrom pathlib import Path\n"
            "def showsUpdatedLabel():\n"
            "    fixture = json.loads(Path('src/test/resources/label.json').read_text())\n"
            "    rendered = fixture['label'].upper()  # synthetic mock-backed view\n"
            "    assert rendered == fixture['expected'], (rendered, fixture['expected'])\n"
            "    print(json.dumps({'consumed_label': fixture['label'], 'rendered': rendered}))\n"
            "if __name__ == '__main__':\n    showsUpdatedLabel()\n",
            encoding="utf-8",
        )
        self.git("init", "--quiet")
        self.git("config", "user.name", "Appsome evidence fixture")
        self.git("config", "user.email", "evidence@example.invalid")
        self.git("add", ".")
        self.git("commit", "--quiet", "-m", "synthetic baseline")
        self.baseline = self.git("rev-parse", "HEAD")
        self.results_dir = "app/build/test-results/mock-scenario"
        (self.root / self.results_dir).mkdir(parents=True)
        self.artifact_dir = self.root / "build/kent-workflow/OSM-112"
        self.artifact_dir.mkdir(parents=True)

    def git(self, *arguments: str) -> str:
        result = subprocess.run(
            ["git", "-C", str(self.root), *arguments],
            check=True,
            capture_output=True,
            text=True,
            timeout=10,
        )
        return result.stdout.strip()

    def close(self) -> None:
        self.temporary.cleanup()

    def change_app_behavior(self) -> None:
        self.source.write_text('fun label() = "new"\n', encoding="utf-8")
        self.change_fixture_only()
        scenario = self.root / self.scenario_path
        scenario.write_text(
            scenario.read_text(encoding="utf-8").replace(
                "    print(json.dumps",
                "    source = Path('src/main/Label.kt').read_text()\n"
                "    assert source == 'fun label() = \"new\"\\n'\n"
                "    assert fixture['label'] == 'new' and rendered == 'NEW'\n"
                "    print(json.dumps",
            ),
            encoding="utf-8",
        )

    def change_fixture_only(self) -> None:
        self.fixture_path.write_text('{"label":"new","expected":"NEW"}\n', encoding="utf-8")

    def run_selected_scenario(
        self, testcase: unittest.TestCase, *, expected_outcome: str = "passed"
    ) -> None:
        result = subprocess.run(
            [sys.executable, self.scenario_path], cwd=self.root, capture_output=True,
            text=True, timeout=2, env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        )
        if expected_outcome == "passed":
            testcase.assertEqual(0, result.returncode, result.stderr)
            testcase.assertEqual(
                {"consumed_label": "new", "rendered": "NEW"}, json.loads(result.stdout)
            )
        else:
            testcase.assertEqual(1, result.returncode, result.stderr)
            testcase.assertIn("AssertionError", result.stderr)
        self.write_junit([self.case_id], outcome=expected_outcome)
        (self.artifact_dir / "verification.log").write_text(
            result.stdout + result.stderr, encoding="utf-8"
        )

    def change_non_applicable(self) -> None:
        documentation = self.root / "docs/workflow-note.md"
        documentation.parent.mkdir(parents=True)
        documentation.write_text("Document a tooling contract.\n", encoding="utf-8")

    def write_junit(
        self,
        case_ids: list[str],
        *,
        outcome: str = "passed",
    ) -> Path:
        cases = []
        for case_id in case_ids:
            class_name, method_name = case_id.split("#", 1)
            child = ""
            if outcome == "failed":
                child = '<failure message="assertion failed">failed</failure>'
            elif outcome == "skipped":
                child = '<skipped message="not run"/>'
            cases.append(
                f'<testcase classname="{class_name}" name="{method_name}">'
                f"{child}</testcase>"
            )
        result = self.root / self.results_dir / "TEST-selected.xml"
        result.write_text(
            f'<testsuite tests="{len(cases)}">{"".join(cases)}</testsuite>\n',
            encoding="utf-8",
        )
        return result

    def write_log(self) -> str:
        log = self.artifact_dir / "verification.log"
        log.write_text("synthetic selected verification completed\n", encoding="utf-8")
        return log.relative_to(self.root).as_posix()

    def run_helper(
        self,
        testcase: unittest.TestCase,
        command: str,
        request: dict[str, object],
    ) -> dict[str, object]:
        result = subprocess.run(
            [sys.executable, str(self.helper), command],
            cwd=self.root,
            input=json.dumps(request, separators=(",", ":")) + "\n",
            text=True,
            capture_output=True,
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            check=False,
            timeout=2,
        )
        testcase.assertLessEqual(len(result.stdout), 32 * 1024, result.stderr)
        testcase.assertLessEqual(len(result.stderr), 8192)
        testcase.assertEqual(result.returncode, 0, result.stderr)
        return json.loads(result.stdout)

    def capture_before(
        self,
        testcase: unittest.TestCase,
        selected_case_ids: list[str],
        *,
        output_path: str = "build/kent-workflow/OSM-112/start.json",
    ) -> dict[str, object]:
        return self.run_helper(
            testcase,
            "capture-before",
            {
                "workspace_path": str(self.root),
                "task_short_id": "OSM-112",
                "work_kind": self.work_kind,
                "baseline": self.baseline,
                "results_dir": self.results_dir,
                "selected_case_ids": selected_case_ids,
                "output_path": output_path,
            },
        )

    def capture_after(
        self,
        testcase: unittest.TestCase,
        *,
        runner_exit_code: int = 0,
        log_path: str | None = None,
        start_path: str = "build/kent-workflow/OSM-112/start.json",
        output_path: str = "build/kent-workflow/OSM-112/execution.json",
    ) -> dict[str, object]:
        return self.run_helper(
            testcase,
            "capture-after",
            {
                "workspace_path": str(self.root),
                "start_path": start_path,
                "output_path": output_path,
                "runner_exit_code": runner_exit_code,
                "log_path": log_path or self.write_log(),
            },
        )

    def packet(
        self,
        start: dict[str, object],
        after: dict[str, object],
        *,
        applicable: bool = True,
        command: str = "python3 tools/run-selected-scenario",
        behavior_delta_paths: list[str] | None = None,
        scenario_paths: list[str] | None = None,
        rationale: str = "This delivery changes workflow tooling, not app UI behavior.",
    ) -> tuple[dict[str, object], dict[str, object], Path]:
        start_record = json.loads(
            (self.root / str(start["start_path"])).read_text(encoding="utf-8")
        )
        receipt = json.loads(
            (self.root / str(after["receipt_path"])).read_text(encoding="utf-8")
        )
        delta = start_record["source_delta"]
        all_paths = [str(item["path"]) for item in delta["files"]]
        if behavior_delta_paths is None:
            behavior_delta_paths = all_paths
        if applicable:
            if scenario_paths is None:
                scenario_paths = [self.scenario_path]
            behavior: dict[str, object] = {
                "behavior_id": "label.changed",
                "applicability": "applicable",
                "delta_paths": behavior_delta_paths,
                "source_paths": (
                    ["src/main/Label.kt"]
                    if "src/main/Label.kt" in behavior_delta_paths
                    else []
                ),
                "scenario_paths": scenario_paths,
                "mock_seam": "The scenario loads the changed label fixture.",
                "assertions": ["The rendered label equals the fixture value."],
                "test_case_ids": start_record["selected_case_ids"],
            }
        else:
            behavior = {
                "behavior_id": "workflow.documentation",
                "applicability": "not_applicable",
                "delta_paths": behavior_delta_paths,
                "source_paths": [],
                "rationale": rationale,
                "alternative_verification": [
                    "The bounded policy and local validator suite pass."
                ],
            }
        log = receipt["verification_log"]
        packet: dict[str, object] = {
            "schema": "mock-scenario-evidence-v1",
            "execution_id": start_record["execution_id"],
            "task_short_id": "OSM-112",
            "work_kind": self.work_kind,
            "baseline": self.baseline,
            "source_delta": delta,
            "source_sha256": delta["sha256"],
            "behaviors": [behavior],
            "verification": {
                "result": receipt["result"],
                "command": command,
                "log_path": log["path"],
                "log_sha256": log["sha256"],
            },
            "execution_receipt": {
                "path": after["receipt_path"],
                "sha256": after["receipt_sha256"],
            },
        }
        evidence_path = self.artifact_dir / "evidence.json"
        evidence_path.write_text(
            json.dumps(packet, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        envelope = {
            "schema": "mock-scenario-review-context-v1",
            "evidence_path": evidence_path.relative_to(self.root).as_posix(),
            "evidence_sha256": sha256(evidence_path.read_bytes()),
            "narrative": "Retain the existing review context and behavior rationale.",
        }
        return packet, envelope, evidence_path

    def validate(
        self,
        testcase: unittest.TestCase,
        envelope: object,
    ) -> dict[str, object]:
        if isinstance(envelope, str):
            serialized = envelope
        else:
            serialized = json.dumps(envelope, separators=(",", ":"))
        return self.run_helper(
            testcase,
            "validate",
            {"workspace_path": str(self.root), "review_context": serialized},
        )


class MockScenarioEvidenceTest(unittest.TestCase):
    def test_all_kinds_execution_failure_skip_and_missing_case(self) -> None:
        for work_kind in WORK_KINDS:
            for outcome, status in (("failed", "failed"), ("skipped", "blocked"), ("missing", "blocked")):
                with self.subTest(work_kind=work_kind, outcome=outcome):
                    fixture = self.make_fixture(work_kind)
                    try:
                        fixture.change_app_behavior()
                        start = fixture.capture_before(self, [fixture.case_id])
                        fixture.write_junit(
                            [fixture.case_id] if outcome != "missing" else ["com.example.LabelScenario#other"],
                            outcome=outcome,
                        )
                        after = fixture.capture_after(self, runner_exit_code=1 if outcome == "failed" else 0)
                        _, envelope, _ = fixture.packet(start, after)
                        result = fixture.validate(self, envelope)
                        self.assertEqual(status, result["status"], result)
                    finally:
                        fixture.close()

    def test_regular_artifact_reads_remain_bounded(self) -> None:
        for artifact in ("evidence.json", "start.json", "execution.json", "verification.log"):
            with self.subTest(artifact=artifact):
                fixture = self.make_fixture()
                try:
                    _, envelope, _ = self.valid_applicable_packet(fixture)
                    limit = 4 * 1024 * 1024 if artifact.endswith(".log") else 256 * 1024
                    (fixture.artifact_dir / artifact).write_bytes(b"x" * (limit + 1))
                    result = fixture.validate(self, envelope)
                    self.assertEqual("blocked", result["status"])
                    self.assertEqual(
                        "log_too_large" if artifact.endswith(".log") else "json_too_large",
                        result["reason_code"],
                    )
                finally:
                    fixture.close()

    def test_all_kinds_applicable_and_missing_scenario_delta(self) -> None:
        for work_kind in WORK_KINDS:
            with self.subTest(work_kind=work_kind, case="changed-scenario"):
                fixture = self.make_fixture(work_kind)
                try:
                    packet, envelope, _ = self.valid_applicable_packet(fixture)
                    self.assertEqual(work_kind, packet["work_kind"])
                    self.assertEqual("passed", fixture.validate(self, envelope)["status"])
                finally:
                    fixture.close()
            for scenario_paths in ([fixture.scenario_path], []):
                with self.subTest(work_kind=work_kind, scenario_paths=scenario_paths):
                    fixture = self.make_fixture(work_kind)
                    try:
                        # Executing a pre-existing case is insufficient: only
                        # implementation changed, not the scenario or fixture.
                        fixture.source.write_text('fun label() = "new"\n', encoding="utf-8")
                        start = fixture.capture_before(self, [fixture.case_id])
                        result = subprocess.run(
                            [sys.executable, fixture.scenario_path], cwd=fixture.root,
                            capture_output=True, text=True, timeout=2,
                            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
                        )
                        self.assertEqual(0, result.returncode, result.stderr)
                        fixture.write_junit([fixture.case_id])
                        after = fixture.capture_after(self)
                        self.assertEqual("passed", after["status"])
                        _, envelope, _ = fixture.packet(start, after, scenario_paths=scenario_paths)
                        blocked = fixture.validate(self, envelope)
                        self.assertEqual("blocked", blocked["status"])
                        self.assertEqual(
                            "scenario_path_unmapped" if scenario_paths else "list_invalid",
                            blocked["reason_code"],
                        )
                    finally:
                        fixture.close()

    def test_mixed_applicability_requires_every_behavior(self) -> None:
        fixture = self.make_fixture()
        try:
            fixture.change_non_applicable()
            packet, envelope, path = self.valid_applicable_packet(fixture)
            documentation = "docs/workflow-note.md"
            packet["behaviors"][0]["delta_paths"].remove(documentation)
            packet["behaviors"].append({
                "behavior_id": "workflow.documentation", "applicability": "not_applicable",
                "delta_paths": [documentation], "source_paths": [],
                "rationale": "The workflow note is documentation, not rendered application behavior.",
                "alternative_verification": ["Synthetic source inventory maps the tooling note."],
            })
            path.write_text(json.dumps(packet), encoding="utf-8")
            envelope["evidence_sha256"] = sha256(path.read_bytes())
            result = fixture.validate(self, envelope)
            self.assertEqual("passed", result["status"])
            self.assertEqual(2, result["behavior_count"])
            packet["behaviors"].pop()
            path.write_text(json.dumps(packet), encoding="utf-8")
            envelope["evidence_sha256"] = sha256(path.read_bytes())
            self.assertEqual(
                "behavior_inventory_incomplete", fixture.validate(self, envelope)["reason_code"]
            )
        finally:
            fixture.close()

    def test_fix_reentry_recovers_pointer_and_refreshes_changed_evidence(self) -> None:
        fixture = self.make_fixture()
        try:
            old_packet, envelope, _ = self.valid_applicable_packet(fixture)
            pointer = fixture.artifact_dir / "review-envelope.json"
            pointer.write_text(json.dumps(envelope), encoding="utf-8")
            self.assertEqual("blocked", fixture.validate(self, None)["status"])
            recovered = json.loads(pointer.read_text(encoding="utf-8"))
            self.assertEqual("passed", fixture.validate(self, recovered)["status"])
            # Fix the mapped behavior, then prove the recovered old evidence
            # cannot admit the new source. A fresh execution must be captured.
            fixture.source.write_text('fun label() = "fixed"\n', encoding="utf-8")
            scenario = fixture.root / fixture.scenario_path
            scenario.write_text(
                scenario.read_text().replace('fun label() = "new"', 'fun label() = "fixed"'),
                encoding="utf-8",
            )
            stale = fixture.validate(self, recovered)
            self.assertEqual("source_drift", stale["reason_code"])
            start = fixture.capture_before(
                self, [fixture.case_id], output_path="build/kent-workflow/OSM-112/fix-start.json"
            )
            fixture.run_selected_scenario(self)
            # Same case/result content is stale; an actual fresh run has a
            # distinct XML identity, here explicitly marked with the run ID.
            xml = fixture.root / fixture.results_dir / "TEST-selected.xml"
            xml.write_text(xml.read_text().replace("<testsuite ", f'<testsuite run="{start["execution_id"]}" '))
            after = fixture.capture_after(
                self, log_path="build/kent-workflow/OSM-112/verification.log",
                start_path=str(start["start_path"]),
                output_path="build/kent-workflow/OSM-112/fix-execution.json",
            )
            packet, refreshed, _ = fixture.packet(start, after)
            self.assertNotEqual(old_packet["execution_id"], packet["execution_id"])
            self.assertNotEqual(old_packet["source_sha256"], packet["source_sha256"])
            self.assertEqual("passed", fixture.validate(self, refreshed)["status"])
        finally:
            fixture.close()

    def test_fifo_artifacts_fail_closed_without_waiting_for_a_writer(self) -> None:
        for artifact in ("evidence.json", "start.json", "execution.json", "verification.log"):
            with self.subTest(artifact=artifact):
                fixture = self.make_fixture()
                try:
                    _, envelope, _ = self.valid_applicable_packet(fixture)
                    path = fixture.artifact_dir / artifact
                    path.unlink()
                    os.mkfifo(path)
                    started = time.monotonic()
                    try:
                        result = fixture.validate(self, envelope)
                    except subprocess.TimeoutExpired:
                        self.fail(f"FIFO {artifact} blocked instead of returning JSON")
                    self.assertLess(time.monotonic() - started, 2)
                    self.assertEqual("blocked", result["status"])
                    self.assertEqual("field_invalid", result["reason_code"])
                    if artifact in ("start.json", "verification.log"):
                        (fixture.artifact_dir / "execution.json").unlink()
                        result = fixture.capture_after(
                            self, log_path="build/kent-workflow/OSM-112/verification.log"
                        )
                        self.assertEqual("field_invalid", result["reason_code"])
                finally:
                    fixture.close()

    def test_multiline_narrative_is_retained_and_bounded(self) -> None:
        fixture = self.make_fixture()
        try:
            _, envelope, _ = self.valid_applicable_packet(fixture)
            narrative = "Prior review:\r\n- first finding\n\tSecond line.\n"
            envelope["narrative"] = narrative
            self.assertEqual("passed", fixture.validate(self, envelope)["status"])
            self.assertEqual(narrative, envelope["narrative"])
            for invalid in (" \r\n\t", "x" * (16 * 1024 + 1), "bad\x00text"):
                envelope["narrative"] = invalid
                result = fixture.validate(self, envelope)
                self.assertEqual("blocked", result["status"])
                self.assertEqual("field_invalid", result["reason_code"])
        finally:
            fixture.close()

    def make_fixture(self, work_kind: str = "feature") -> ScenarioFixture:
        return ScenarioFixture(work_kind)

    def valid_applicable_packet(
        self,
        fixture: ScenarioFixture,
        *,
        outcome: str = "passed",
        runner_exit_code: int = 0,
        preexisting: bool = False,
    ) -> tuple[dict[str, object], dict[str, object], Path]:
        fixture.change_app_behavior()
        if outcome == "failed":
            scenario = fixture.root / fixture.scenario_path
            scenario.write_text(scenario.read_text().replace("rendered == 'NEW'", "rendered == 'WRONG'"))
        if preexisting:
            fixture.write_junit([fixture.case_id], outcome="passed")
        start = fixture.capture_before(self, [fixture.case_id])
        if start.get("status") != "passed":
            raise AssertionError(start)
        if not preexisting:
            if outcome in ("passed", "failed"):
                fixture.run_selected_scenario(self, expected_outcome=outcome)
            else:
                fixture.write_junit([fixture.case_id], outcome=outcome)
        after = fixture.capture_after(
            self, runner_exit_code=runner_exit_code,
            log_path=(
                "build/kent-workflow/OSM-112/verification.log"
                if not preexisting and outcome in ("passed", "failed") else None
            ),
        )
        packet, envelope, path = fixture.packet(start, after)
        return packet, envelope, path

