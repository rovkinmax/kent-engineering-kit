def verify_manifest_fixtures() -> None:
    """Resolve the actual project closure with the explicitly selected Kit."""
    kit = Path(os.environ["KENT_ENGINEERING_KIT_ROOT"]).resolve(strict=True)
    sys.path.insert(0, str(kit))
    from workflowkit.profile import ProjectProfile
    from workflowkit.release import ReleaseSpec
    from workflowkit.revision import (
        RevisionPreflightError, add_release_requirements, collect_runtime_external_captures,
        preflight_project_revision, profile_requirements,
    )

    profile = ProjectProfile.load(ROOT)
    spec = ReleaseSpec.from_toml(
        (ROOT / profile.release.spec_path).read_text(), profile=profile
    )
    requirements = profile_requirements(profile)
    add_release_requirements(requirements, spec)
    manifest_path = spec.source_manifest.path
    manifest = json.loads((ROOT / manifest_path).read_text())
    assert manifest["additional_trees"] == []
    paths = set(requirements) | set(manifest["additional_paths"]) | {manifest_path}
    policy_paths = {
        ".kent/commands/mock-scenario-policy.md",
        ".kent/scripts/workflow-mock-scenario-evidence",
        "tools/test-workflow-mock-scenario-evidence",
        ".kent/scripts/tests/test-workflow-verify-report",
    }
    with tempfile.TemporaryDirectory(prefix="appsome-policy-manifest-") as directory:
        root = Path(directory)
        for relative in sorted(paths):
            source = ROOT / relative
            assert source.is_file() and not source.is_symlink(), relative
            destination = root / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
        git("init", "-q", cwd=root)
        git("config", "user.name", "Appsome manifest fixture", cwd=root)
        git("config", "user.email", "manifest@example.invalid", cwd=root)

        def commit() -> str:
            git("add", ".", cwd=root)
            git("-c", "core.hooksPath=/dev/null", "commit", "-qm", "Manifest fixture", cwd=root)
            return git("rev-parse", "HEAD", cwd=root)

        good = commit()
        resolved = preflight_project_revision(root, good)
        assert policy_paths <= {item.path for item in resolved.checked_paths}
        inputs = resolved.selected_runtime_source_inputs
        assert inputs is not None
        captures = collect_runtime_external_captures(root, inputs)
        captured = {
            key.split("=", 1)[0] for kind, key, _ in captures if kind == "source-sha256"
        }
        assert policy_paths <= captured
        print("manifest resolved closure: policy/helper/suite/wrapper paths and digests passed")

        broken = json.loads(json.dumps(manifest))
        broken["additional_paths"] = sorted(broken["additional_paths"] + ["missing-policy-file"])
        (root / manifest_path).write_text(json.dumps(broken))
        missing = commit()
        try:
            preflight_project_revision(root, missing)
        except RevisionPreflightError as error:
            assert "additional path not found" in str(error), error
        else:
            raise AssertionError("Manifest resolver accepted a missing additional path")

        broken = json.loads(json.dumps(manifest))
        for external in broken["external_roots"]:
            if external["key"].startswith(".kent/scripts/workflow-mock-scenario-evidence="):
                external["key"] = external["key"].split("=", 1)[0] + "=sha256:" + ":".join(["0" * 8] * 8)
        broken["external_roots"].sort(key=lambda item: (item["kind"], item["key"]))
        (root / manifest_path).write_text(json.dumps(broken))
        mismatch = commit()
        invalid_inputs = preflight_project_revision(root, mismatch).selected_runtime_source_inputs
        try:
            collect_runtime_external_captures(root, invalid_inputs)
        except RevisionPreflightError as error:
            assert "digest mismatch" in str(error), error
        else:
            raise AssertionError("Manifest external-capture resolver accepted a mismatched digest")
        # Immutable good revision remains valid despite the two invalid tips.
        recovered = preflight_project_revision(root, good)
        assert captures == collect_runtime_external_captures(root, recovered.selected_runtime_source_inputs)
        print("manifest missing-path/mismatched-digest negatives and pinned recovery: passed")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--baseline-red",
        action="store_true",
        help="reproduce the baseline's false pass without scenario evidence",
    )
    parser.add_argument(
        "--manifest-fixtures", action="store_true",
        help="also exercise source closure with explicit KENT_ENGINEERING_KIT_ROOT",
    )
    arguments, remaining = parser.parse_known_args()
    if arguments.baseline_red:
        if remaining:
            parser.error("--baseline-red does not accept test filters")
        evidence = capture_baseline_red()
        print(json.dumps(evidence, sort_keys=True))
        return 0
    result = unittest.main(argv=[sys.argv[0], *remaining], exit=False).result
    if result.wasSuccessful() and arguments.manifest_fixtures:
        verify_manifest_fixtures()
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"test-workflow-mock-scenario-evidence: {error}")
        raise SystemExit(1)
