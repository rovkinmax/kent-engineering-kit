sys.dont_write_bytecode = True


JIRA_KEY = re.compile(r"(?<![A-Z0-9])([A-Z][A-Z0-9]+-\d+)(?![A-Z0-9])", re.I)
URL = re.compile(r"https?://[^\s<>()\[\]{}\"']+")
POLICIES = {"task", "jira", "github_issue"}
HANDOFF_KEYS = ("workspace_path", "plan_path", "work_kind")
CODER_HANDOFF_KEYS = (
    "task_short_id",
    "accepted_plan_sha256",
    "plan_route",
    "plan_route_context",
    "review_context",
)
CODER_SELECTION_SCHEMA = "coder-selection-v1"
CODER_SELECTION_FIELDS = {
    "schema",
    "task_short_id",
    "complexity",
    "rationale",
}
CODER_SELECTION_TARGETS = {
    "simple": ("implementation-simple", "xhigh"),
    "complex": ("implementation-complex", "medium"),
}
SHA256 = re.compile(r"^[0-9a-f]{64}$")
CODER_SELECTION_POLICY = {"disabled", "complexity"}
DEFAULT_KENT_PATHS = (
    str(Path.home() / ".kent" / "bin" / "kent"),
    "/opt/homebrew/bin/kent",
    "/usr/local/bin/kent",
)
TOML_TABLE = re.compile(r"^\[([A-Za-z0-9_.-]+)\]\s*(?:#.*)?$")
BRANCH_POLICY_ASSIGNMENT = re.compile(
    r'^branch_identity\s*=\s*"([a-z_]+)"\s*(?:#.*)?$'
)
BRANCH_DIRECTIVE = re.compile(r"^branch_name:[ \t]*(.*)$", re.MULTILINE)


class IdentityAmbiguity(ValueError):
    pass


def complete(transition: str, commentary: str = "", **values: str) -> None:
    payload = {"transition": transition}
    if commentary:
        payload["commentary"] = commentary
    payload.update(values)
    print(json.dumps(payload, ensure_ascii=False))


def blocked(reason: str, handoff: dict[str, str]) -> int:
    complete(
        "branch_identity_blocked",
        blocker_reason=reason,
        **handoff,
    )
    return 0


def run(
    args: list[str],
    *,
    cwd: Path,
    timeout: int = 30,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(f"{' '.join(args)} failed: {detail}")
    return result


def repository_root() -> Path:
    start = Path.cwd().resolve()
    result = run(["git", "rev-parse", "--show-toplevel"], cwd=start)
    root = Path(result.stdout.strip()).resolve()
    if root != start:
        raise ValueError(
            f"script must run at the task worktree root: {start}; found {root}"
        )
    return root


def workflow_input() -> dict[str, object]:
    payload = json.load(sys.stdin)
    if not isinstance(payload, dict):
        raise ValueError("workflow input must be a JSON object")
    return payload


def task_id(payload: dict[str, object]) -> str:
    identity = payload.get("_kent")
    if not isinstance(identity, dict):
        raise ValueError("workflow input is missing _kent identity")
    value = identity.get("task_id")
    if not isinstance(value, str) or not value.strip():
        raise ValueError("workflow input is missing _kent.task_id")
    return value.strip()


def handoff_values(payload: dict[str, object]) -> dict[str, str]:
    present = [key for key in HANDOFF_KEYS if key in payload]
    coder_present = [key for key in CODER_HANDOFF_KEYS if key in payload]
    if not present and "delivery_context" not in payload and not coder_present:
        return {}
    if len(present) != len(HANDOFF_KEYS):
        missing = sorted(set(HANDOFF_KEYS) - set(present))
        raise ValueError(
            "workflow branch handoff is incomplete; missing "
            + ", ".join(missing)
        )
    values: dict[str, str] = {}
    for key in HANDOFF_KEYS:
        value = payload[key]
        if not isinstance(value, str):
            raise ValueError(f"{key} must be a string")
        values[key] = value.strip()
    if not values["workspace_path"]:
        raise ValueError("workspace_path must be non-empty")
    if not values["work_kind"]:
        raise ValueError("work_kind must be non-empty")
    if "delivery_context" in payload:
        from workflow_runtime_contracts import delivery_context_fields

        values.update(delivery_context_fields(payload))
    if coder_present:
        if len(coder_present) != len(CODER_HANDOFF_KEYS):
            missing = sorted(set(CODER_HANDOFF_KEYS) - set(coder_present))
            raise ValueError(
                "complexity-selection handoff is incomplete; missing "
                + ", ".join(missing)
            )
        for key in CODER_HANDOFF_KEYS:
            value = payload[key]
            if not isinstance(value, str) or not value.strip():
                raise ValueError(f"{key} must be a non-empty string")
            values[key] = value.strip()
        if SHA256.fullmatch(values["accepted_plan_sha256"]) is None:
            raise ValueError("accepted_plan_sha256 must be a lowercase SHA-256 digest")
    return values


def coder_selection_policy(root: Path) -> str:
    path = root / ".kent" / "workflow-profile.toml"
    if path.is_symlink() or not path.is_file():
        raise ValueError("project workflow profile is missing or unsafe")
    profile = tomllib.loads(path.read_text(encoding="utf-8"))
    policies = profile.get("policies")
    if not isinstance(policies, dict):
        raise ValueError("project workflow profile has no policies table")
    policy = policies.get("coder_selection", "disabled")
    if not isinstance(policy, str) or policy not in CODER_SELECTION_POLICY:
        raise ValueError("policies.coder_selection is unsupported")
    if (
        policy == "complexity"
        and policies.get("writer_sessions", "continuous") != "continuous"
    ):
        raise ValueError(
            "complexity coder selection requires continuous writer Sessions"
        )
    return policy


def duplicate_free_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON object key: {key!r}")
        result[key] = value
    return result


def plan_contract_adapter(root: Path, profile: dict[str, object]):
    commands = profile.get("commands")
    configured = commands.get("plan_contract") if isinstance(commands, dict) else None
    if (
        not isinstance(configured, str)
        or not configured
        or "\\" in configured
        or Path(configured).is_absolute()
        or any(part in {"", ".", ".."} for part in configured.split("/"))
    ):
        raise ValueError("commands.plan_contract must be a normalized relative path")
    root = root.resolve()
    source = root
    for part in configured.split("/"):
        source = source / part
        if source.is_symlink():
            raise ValueError("qualified plan contract adapter path contains a symlink")
    if not source.is_file() or not source.resolve().is_relative_to(root):
        raise ValueError("qualified plan contract adapter unavailable")
    loader = importlib.machinery.SourceFileLoader("branch_memory_contract", str(source))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ValueError("plan contract adapter cannot be loaded")
    contract = importlib.util.module_from_spec(spec)
    loader.exec_module(contract)
    return contract


def project_memory_context(
    root: Path,
    payload: dict[str, object],
) -> tuple[dict[str, object], str, object | None]:
    profile_path = root / ".kent/workflow-profile.toml"
    if profile_path.is_symlink() or not profile_path.is_file():
        raise ValueError("project workflow profile is missing or unsafe")
    profile = tomllib.loads(profile_path.read_text(encoding="utf-8"))
    memory = profile.get("project_memory")
    if memory is None:
        return profile, "legacy", None
    if not isinstance(memory, dict) or memory.get("mode") not in {"legacy", "r2"}:
        raise ValueError("project memory storage mode is unknown")
    configured_mode = memory["mode"]
    if configured_mode == "legacy":
        return profile, "legacy", None

    contract = plan_contract_adapter(root, profile)
    if not isinstance(payload.get("_kent"), dict):
        raise ValueError("R2 project memory requires native Task context")
    admission = contract.memory_call(root, payload, "resolve-task")
    resolved_mode = admission.get("mode")
    if resolved_mode not in {"legacy", "r2"}:
        raise ValueError("project memory adapter returned an unknown storage mode")
    return profile, resolved_mode, contract


def coder_selection_snapshot(
    root: Path,
    handoff: dict[str, str],
    *,
    short_id: str,
    native_payload: dict[str, object] | None = None,
    contract: object | None = None,
    resolved_memory_mode: str | None = None,
) -> tuple[str, str]:
    profile = tomllib.loads(
        (root / ".kent/workflow-profile.toml").read_text(encoding="utf-8"))
    memory = profile.get("project_memory")
    if memory is None:
        configured_memory_mode = "legacy"
    elif isinstance(memory, dict) and memory.get("mode") in {"legacy", "r2"}:
        configured_memory_mode = memory["mode"]
    else:
        raise ValueError("project memory storage mode is unknown")
    if contract is None:
        contract = plan_contract_adapter(root, profile)
    if resolved_memory_mode is None:
        resolved_memory_mode = configured_memory_mode
        if configured_memory_mode == "r2":
            context = native_payload or {}
            admission = contract.memory_call(root, context, "resolve-task")
            resolved_memory_mode = admission.get("mode")
    if resolved_memory_mode not in {"legacy", "r2"}:
        raise ValueError("project memory adapter returned an unknown storage mode")
    if resolved_memory_mode == "r2":
        context = native_payload or {}
        resolved = contract.memory_call(
            root, context, "resolve-plan", plan_path=handoff["plan_path"])
        choice = contract.plan_coder_selection(Path(resolved["working_path"]), short_id)
        status = contract.memory_call(root, context, "check-plan", coder_selection=choice)
        accepted = contract.memory_snapshot_projection(status, short_id)
        cache_path = root / ".kent/runtime" / short_id / "plan-contract.json"
        if os.path.lexists(cache_path):
            cache = contract.inspection_json(contract.inspection_read_file(
                cache_path, root=root, max_bytes=65536), "plan locator")
            contract.validate_memory_cache(cache, status, short_id)
        if (status["comparison"] != "unchanged"
                or accepted["normalized_sha256"] != handoff["accepted_plan_sha256"]
                or accepted.get("coder_selection") != choice):
            raise ValueError("external accepted coder selection changed")
        role, effort = CODER_SELECTION_TARGETS[choice["complexity"]]
        return role, effort
    runtime = root / ".kent" / "runtime"
    task_directory = runtime / short_id
    for directory in (root / ".kent", runtime, task_directory):
        if directory.is_symlink() or not directory.is_dir():
            raise ValueError("accepted plan snapshot directory is missing or unsafe")
    snapshot_path = task_directory / "plan-contract.json"
    if snapshot_path.is_symlink() or not snapshot_path.is_file():
        raise ValueError("accepted task-bound plan snapshot is missing or unsafe")
    snapshot = json.loads(
        snapshot_path.read_text(encoding="utf-8"),
        object_pairs_hook=duplicate_free_object,
    )
    if not isinstance(snapshot, dict) or snapshot.get("schema_version") != 1:
        raise ValueError("accepted plan snapshot has an unsupported schema")
    if snapshot.get("task_short_id") != short_id:
        raise ValueError("accepted plan snapshot belongs to a different Task")
    accepted_digest = snapshot.get("normalized_sha256")
    normalized = snapshot.get("normalized_plan")
    if (
        not isinstance(accepted_digest, str)
        or SHA256.fullmatch(accepted_digest) is None
        or not isinstance(normalized, str)
        or hashlib.sha256(normalized.encode("utf-8")).hexdigest()
        != accepted_digest
    ):
        raise ValueError("accepted plan snapshot digest is invalid")
    if handoff["accepted_plan_sha256"] != accepted_digest:
        raise ValueError("accepted_plan_sha256 does not match the snapshot")
    selection = snapshot.get("coder_selection")
    if not isinstance(selection, dict):
        raise ValueError("accepted plan snapshot has no coder selection")
    if set(selection) != CODER_SELECTION_FIELDS:
        raise ValueError("accepted coder selection has missing or unknown fields")
    if (
        selection.get("schema") != CODER_SELECTION_SCHEMA
        or selection.get("task_short_id") != short_id
        or not isinstance(selection.get("complexity"), str)
        or selection.get("complexity") not in CODER_SELECTION_TARGETS
        or not isinstance(selection.get("rationale"), str)
        or not selection["rationale"].strip()
    ):
        raise ValueError("accepted coder selection is malformed or wrong-task")
    if snapshot.get("coder_selection_sha256") != accepted_digest:
        raise ValueError("accepted coder selection is not digest-bound")
    plan_path_value = snapshot.get("plan_path")
    if not isinstance(plan_path_value, str) or not plan_path_value:
        raise ValueError("accepted plan snapshot has no plan_path")
    if plan_path_value != handoff["plan_path"]:
        raise ValueError("accepted plan path differs from the handoff")
    candidate = Path(plan_path_value)
    if not candidate.is_absolute():
        candidate = root / candidate
    if candidate.is_symlink() or not candidate.is_file():
        raise ValueError("accepted plan path is missing or unsafe")
    resolved = candidate.resolve()
    if not resolved.is_relative_to(root):
        raise ValueError("accepted plan path escapes the task workspace")
    if contract is None:
        contract = plan_contract_adapter(root, profile)
    normalized = contract.normalized_plan(resolved).encode("utf-8")
    if hashlib.sha256(normalized).hexdigest() != accepted_digest:
        raise ValueError("accepted normalized plan changed before branch retry")
    if contract.plan_coder_selection(resolved, short_id) != selection:
        raise ValueError(
            "snapshot coder selection differs from the digest-bound plan choice"
        )
    role, effort = CODER_SELECTION_TARGETS[selection["complexity"]]
    return role, effort


def no_retained_writer(
    root: Path,
    *,
    task: str,
    native_task_id: str,
    contract: object,
) -> str | None:
    items = contract.retained_session_inventory(
        root, task=task, native_task_id=native_task_id,
    )
    writers: list[dict[str, str]] = []
    for item in items:
        session_id = item.get("session_id")
        role = item.get("agent_role")
        if role.startswith("implementation-"):
            writers.append({"session_id": session_id, "agent_role": role})
    if writers:
        return (
            "a retained implementation Session already exists; branch retry "
            "cannot start a second writer"
        )
    return None


def revalidate_before_writer(
    handoff: dict[str, str],
    reason: str,
) -> int:
    if not all(key in handoff for key in CODER_HANDOFF_KEYS):
        return blocked(
            "Невозможно передать задачу на повторную сверку: отсутствуют "
            "задача, digest или контекст принятого плана. Требуется "
            "восстановить корректный workflow handoff.",
            handoff,
        )
    complete(
        "branch_identity_revalidate",
        "Принятый выбор исполнителя или его связь с планом не подтверждены; "
        "возвращаюсь к проверке плана до запуска писателя.",
        workspace_path=handoff["workspace_path"],
        plan_path=handoff["plan_path"],
        work_kind=handoff["work_kind"],
        plan_route=handoff["plan_route"],
        plan_route_context=handoff["plan_route_context"],
        plan_change_report=(
            "Accepted coder selection could not be validated before the first "
            f"writer: {reason}"
        ),
        review_context=handoff["review_context"],
        task_short_id=handoff["task_short_id"],
        accepted_plan_sha256=handoff["accepted_plan_sha256"],
        **(
            {"delivery_context": handoff["delivery_context"]}
            if "delivery_context" in handoff
            else {}
        ),
    )
    return 0


def ready_for_writer(
    message: str,
    handoff: dict[str, str],
    selection: tuple[str, str] | None,
) -> int:
    values = dict(handoff)
    if selection is not None:
        values["target_assignee"], values["target_thinking"] = selection
    complete("branch_identity_ready", message, **values)
    return 0


def resolve_kent_bin() -> str:
    configured = os.environ.get("KENT_BIN")
    candidates = (configured,) if configured else ("kent", *DEFAULT_KENT_PATHS)
    for candidate in candidates:
        if not candidate:
            continue
        if os.path.sep in candidate:
            path = Path(candidate).expanduser()
            if path.is_file() and os.access(path, os.X_OK):
                return str(path)
            continue
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    if configured:
        raise RuntimeError(
            f"configured Kent CLI is not executable: {configured}"
        )
    raise RuntimeError(
        "Kent CLI was not found; set KENT_BIN to its absolute path"
    )


def task_payload(root: Path, identity: str) -> dict[str, object]:
    kent_bin = resolve_kent_bin()
    result = run(
        [
            kent_bin,
            "task",
            "show",
            identity,
            "--project",
            str(root),
            "--json",
        ],
        cwd=root,
    )
    decoded = json.loads(result.stdout)
    if not isinstance(decoded, dict):
        raise RuntimeError("kent task show returned a non-object payload")
    return decoded


def profile_policy(root: Path) -> str:
    profile_path = root / ".kent" / "workflow-profile.toml"
    table = ""
    value = ""
    for line_number, raw_line in enumerate(
        profile_path.read_text().splitlines(),
        start=1,
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        table_match = TOML_TABLE.fullmatch(line)
        if table_match:
            table = table_match.group(1)
            continue
        if table != "policies":
            continue
        key = line.split("=", 1)[0].strip()
        if key != "branch_identity":
            continue
        assignment = BRANCH_POLICY_ASSIGNMENT.fullmatch(line)
        if assignment is None:
            raise ValueError(
                "policies.branch_identity must be one quoted lowercase "
                f"identifier at {profile_path}:{line_number}"
            )
        if value:
            raise ValueError("policies.branch_identity is declared more than once")
        value = assignment.group(1)
    value = value or "task"
    if value not in POLICIES:
        raise ValueError(f"unsupported policies.branch_identity: {value!r}")
    return value


def task_string(payload: dict[str, object], key: str) -> str:
    value = payload.get(key)
    if isinstance(value, str):
        return value.strip()
    return ""


def task_short_id(payload: dict[str, object]) -> str:
    summary = payload.get("summary")
    if isinstance(summary, dict):
        value = summary.get("short_id")
        if isinstance(value, str) and value.strip():
            return value.strip()
    value = payload.get("short_id")
    if isinstance(value, str) and value.strip():
        return value.strip()
    raise ValueError("kent task show payload is missing task short ID")


def task_body(payload: dict[str, object]) -> str:
    body = task_string(payload, "body")
    if body:
        return body
    summary = payload.get("summary")
    if isinstance(summary, dict):
        preview = summary.get("body_preview")
        if isinstance(preview, str):
            return preview
    return ""


def jira_url_key(value: str) -> str:
    parsed = urlparse(value)
    if parsed.scheme not in {"http", "https"}:
        return ""
    parts = [part for part in parsed.path.split("/") if part]
    for index, part in enumerate(parts[:-1]):
        if part.lower() != "browse":
            continue
        match = JIRA_KEY.fullmatch(parts[index + 1])
        if match:
            return match.group(1).upper()
    return ""


def jira_key(source_url: str, body: str) -> str:
    source_key = jira_url_key(source_url)
    if source_key:
        return source_key
    keys = []
    for match in URL.finditer(body):
        key = jira_url_key(match.group(0).rstrip(".,;:!?"))
        if key and key not in keys:
            keys.append(key)
    if len(keys) > 1:
        raise IdentityAmbiguity(
            "В body найдено несколько Jira issue URL без авторитетного "
            f"source_url: {', '.join(keys)}. Укажите root issue как Source "
            "задачи; linked, cloned и dependency issues не определяют ветку."
        )
    return keys[0] if keys else ""


def github_repository(root: Path) -> Optional[tuple[str, str]]:
    result = run(
        ["git", "remote", "get-url", "origin"],
        cwd=root,
        check=False,
    )
    if result.returncode != 0:
        return None
    remote = result.stdout.strip()
    if remote.startswith("git@github.com:"):
        path = remote.removeprefix("git@github.com:")
    else:
        parsed = urlparse(remote)
        if parsed.hostname not in {"github.com", "www.github.com"}:
            return None
        path = parsed.path.lstrip("/")
    path = path.removesuffix(".git").strip("/")
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return parts[0].lower(), parts[1].lower()


def github_issue_number(root: Path, source_url: str, body: str) -> str:
    repository = github_repository(root)
    if repository is None:
        return ""

    def issue_number(candidate: str) -> str:
        parsed = urlparse(candidate)
        if parsed.hostname not in {"github.com", "www.github.com"}:
            return ""
        parts = [part for part in parsed.path.split("/") if part]
        if (
            len(parts) == 4
            and (parts[0].lower(), parts[1].removesuffix(".git").lower())
            == repository
            and parts[2] == "issues"
            and parts[3].isdigit()
            and int(parts[3]) > 0
        ):
            return str(int(parts[3]))
        return ""

    source_issue = issue_number(source_url)
    if source_issue:
        return source_issue
    issues = []
    for match in URL.finditer(body):
        issue = issue_number(match.group(0).rstrip(".,;:!?"))
        if issue and issue not in issues:
            issues.append(issue)
    if len(issues) > 1:
        raise IdentityAmbiguity(
            "В body найдено несколько GitHub issue URL текущего репозитория "
            f"без авторитетного source_url: {', '.join(issues)}. Укажите root "
            "issue как Source задачи."
        )
    return issues[0] if issues else ""


def desired_branch(
    policy: str,
    root: Path,
    source_url: str,
    body: str,
    fallback: str,
) -> str:
    if policy == "jira":
        key = jira_key(source_url, body)
        directives = BRANCH_DIRECTIVE.findall(body)
        if directives:
            if len(directives) != 1 or not key:
                raise IdentityAmbiguity(
                    "Для branch_name нужны ровно одна директива и "
                    "однозначный исходный Jira issue."
                )
            branch = directives[0].strip()
            if not re.fullmatch(
                rf"feature/{re.escape(key)}-[A-Za-z0-9][A-Za-z0-9._-]*",
                branch,
            ):
                raise IdentityAmbiguity(
                    f"branch_name должен иметь вид feature/{key}-<suffix>."
                )
            validate_branch(root, branch)
            return branch
        return f"feature/{key}" if key else fallback
    if policy == "github_issue":
        issue = github_issue_number(root, source_url, body)
        return f"issue-{issue}" if issue else fallback
    return fallback


def current_branch(root: Path) -> str:
    result = run(["git", "branch", "--show-current"], cwd=root)
    branch = result.stdout.strip()
    if not branch:
        raise ValueError("task worktree is detached")
    return branch


def validate_branch(root: Path, branch: str) -> None:
    result = run(
        ["git", "check-ref-format", "--branch", branch],
        cwd=root,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "invalid ref"
        raise ValueError(f"invalid branch {branch!r}: {detail}")


def local_branch_exists(root: Path, branch: str) -> bool:
    return (
        run(
            ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
            cwd=root,
            check=False,
        ).returncode
        == 0
    )


def remote_branch_state(root: Path, branch: str) -> str:
    result = run(
        [
            "git",
            "ls-remote",
            "--exit-code",
            "--heads",
            "origin",
            f"refs/heads/{branch}",
        ],
        cwd=root,
        timeout=45,
        check=False,
    )
    if result.returncode == 0:
        return "exists"
    if result.returncode == 2:
        return "absent"
    detail = result.stderr.strip() or result.stdout.strip() or "no output"
    raise RuntimeError(f"cannot inspect origin branch {branch!r}: {detail}")


def apply_branch_identity(
    incoming: dict[str, object],
    handoff: dict[str, str],
) -> int:
    root = repository_root()
    if handoff:
        workspace = Path(handoff["workspace_path"]).expanduser().resolve()
        if workspace != root:
            return blocked(
                f"Workflow передал workspace_path {workspace}, но Script "
                f"запущен в {root}. Нужно восстановить канонический task root.",
                handoff,
            )
    native_task_id = task_id(incoming)
    task = task_payload(root, native_task_id)
    short_id = task_short_id(task)
    profile, memory_mode, contract = project_memory_context(root, incoming)
    policy = profile_policy(root)
    selection: tuple[str, str] | None = None
    if coder_selection_policy(root) == "complexity":
        if not all(key in handoff for key in CODER_HANDOFF_KEYS):
            return blocked(
                "В complexity route отсутствует обязательный task-bound "
                "snapshot handoff; первый writer не запущен.",
                handoff,
            )
        if handoff["task_short_id"] != short_id:
            return revalidate_before_writer(
                handoff,
                "workflow task_short_id differs from Kent's current Task",
            )
        if handoff["plan_route"] != "start":
            return revalidate_before_writer(
                handoff,
                "branch identity is only valid for the initial start route",
            )
        summary = task.get("summary")
        returned_task_id = (
            summary.get("id")
            if isinstance(summary, dict)
            else task.get("id")
        )
        if returned_task_id != native_task_id:
            return blocked(
                "Kent task readback native identity does not match _kent.task_id.",
                handoff,
            )
        try:
            if contract is None:
                contract = plan_contract_adapter(root, profile)
            selection = coder_selection_snapshot(
                root,
                handoff,
                short_id=short_id,
                native_payload=incoming,
                contract=contract,
                resolved_memory_mode=memory_mode,
            )
        except ValueError as error:
            return revalidate_before_writer(handoff, str(error))
        try:
            writer_issue = no_retained_writer(
                root,
                task=short_id,
                native_task_id=native_task_id,
                contract=contract,
            )
        except (RuntimeError, json.JSONDecodeError, ValueError) as error:
            return blocked(
                "Не удалось безопасно проверить retained writer перед первым "
                f"запуском: {error}",
                handoff,
            )
        if writer_issue is not None:
            return revalidate_before_writer(handoff, writer_issue)
    source_url = task_string(task, "source_url")
    body = task_body(task)
    try:
        desired = desired_branch(policy, root, source_url, body, short_id)
    except IdentityAmbiguity as error:
        return blocked(str(error), handoff)
    current = current_branch(root)

    if current == desired:
        return ready_for_writer(
            f"Ветка уже соответствует политике проекта: {current}.",
            handoff,
            selection,
        )
    if current != short_id:
        return blocked(
            f"Текущая ветка {current!r} не совпадает ни с Kent ID "
            f"{short_id!r}, ни с ожидаемой веткой {desired!r}. Нужно проверить "
            "владельца worktree и явно решить, какую ветку сохранять.",
            handoff,
        )
    if desired == short_id:
        return ready_for_writer(
            f"Внешний идентификатор не найден; сохранена Kent-ветка {short_id}.",
            handoff,
            selection,
        )

    validate_branch(root, desired)
    if local_branch_exists(root, desired):
        return blocked(
            f"Локальная ветка {desired!r} уже существует. Нужно удалить её "
            "только если она доказанно устарела, либо отменить дублирующую задачу.",
            handoff,
        )
    try:
        remote_state = remote_branch_state(root, desired)
    except RuntimeError as error:
        return blocked(
            f"Не удалось безопасно проверить remote-ветку {desired!r}: {error}",
            handoff,
        )
    if remote_state == "exists":
        return blocked(
            f"Remote-ветка origin/{desired} уже существует. Нужно проверить её "
            "владельца и удалить только доказанно устаревший дубль либо отменить "
            "новую задачу.",
            handoff,
        )

    try:
        run(["git", "branch", "-m", desired], cwd=root)
    except RuntimeError as error:
        return blocked(
            f"Не удалось безопасно переименовать ветку {short_id!r} в "
            f"{desired!r}: {error}",
            handoff,
        )
    return ready_for_writer(
        f"Ветка переименована: {short_id} → {desired}.",
        handoff,
        selection,
    )


def execute(incoming: dict[str, object]) -> int:
    handoff = handoff_values(incoming)
    try:
        return apply_branch_identity(incoming, handoff)
    except (
        json.JSONDecodeError,
        OSError,
        RuntimeError,
        subprocess.TimeoutExpired,
        ValueError,
    ) as error:
        return blocked(
            "Не удалось выполнить branch identity из-за инфраструктурной "
            f"ошибки: {error}. После устранения причины повторите Script.",
            handoff,
        )


def main() -> int:
    incoming = workflow_input()
    root = Path.cwd().resolve()
    profile_path = root / ".kent/workflow-profile.toml"
    profile = tomllib.loads(profile_path.read_text()) if profile_path.is_file() else {}
    if profile.get("policies", {}).get("delivery_reliability") is None:
        return execute(incoming)
    source = Path(__file__).with_name("workflow-checkpoint")
    if source.is_symlink() or not source.is_file():
        raise ValueError("qualified producer adapter is unavailable")
    loader = importlib.machinery.SourceFileLoader("branch_producer_adapter", str(source))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ValueError("producer adapter cannot be loaded")
    adapter = importlib.util.module_from_spec(spec)
    loader.exec_module(adapter)
    # Preserve the existing result producer, including blocked/revalidation
    # routes. Only validated final JSON reaches native completion stdout.
    with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as output:
        with contextlib.redirect_stdout(output):
            code = execute(incoming)
        output.seek(0)
        raw = output.read(1024 * 1024 + 1).encode("utf-8")
    if len(raw) > 1024 * 1024:
        raise ValueError("branch producer result exceeds limit")
    sys.stdout.buffer.write(adapter.emit_producer_result(root, incoming, raw, "branch-identity"))
    return code


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (json.JSONDecodeError, OSError, ValueError) as error:
        print(f"workflow-branch-identity: {error}", file=sys.stderr)
        raise SystemExit(1)
