#!/usr/bin/env python3
"""Cooperative command/Session renewal over an independently installed CLI."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
import types
import uuid
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

MAX_BYTES = 262144
MAX_RUNS = 256
CLI_TIMEOUT = 10.0
ACQUIRE_TIMEOUT = 300.0
CLEANUP_TIMEOUT = 120.0
HEARTBEAT_MAX_AGE = 30.0
STOP_PROOF_SHA256 = "2c0912a48204144366a3aa6c5aca0b461f778921f662840ec649c1497251c42b"
CUSTODY_MARKER_PROTOCOL = 2
STOP_PROTOCOL = 2
UNCERTAINTY_MARKER = "command-stop-uncertain.json"
PARENT_UNCERTAINTY_MARKER = "parent-command-stop-uncertain.json"
REMOTE_STOP_RECORD = "remote-stop.json"
STOP = False


class Error(ValueError):
    pass


class Busy(Error):
    pass


class CommandStopUncertain(Error):
    pass


class FinishStatusUncertain(Error):
    def __init__(self, lease):
        super().__init__("resource cleanup is confirmed; finish status persistence failed")
        self.lease = lease


def interrupted(_number, _frame):
    global STOP
    STOP = True


def private(path: Path, *, directory=False):
    info = path.lstat()
    if (stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid()
            or info.st_mode & 0o077
            or not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))):
        raise Error(f"not an owner-private {'directory' if directory else 'file'}: {path}")


def mkdir(path: Path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    private(path, directory=True)


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise Error("duplicate JSON field")
        value[key] = item
    return value


def read(path: Path):
    private(path)
    with path.open("rb") as stream:
        data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise Error("JSON record exceeds size limit")
    value = json.loads(data, object_pairs_hook=unique_object)
    if not isinstance(value, dict):
        raise Error("expected a JSON object")
    return value


def _write_record(path: Path, value):
    data = (json.dumps(value, sort_keys=True, allow_nan=False) + "\n").encode()
    if len(data) > MAX_BYTES:
        raise Error("JSON record exceeds size limit")
    temporary = path.with_name(f".{path.name}-{uuid.uuid4().hex}")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


@contextmanager
def marker_lock(run: Path):
    """Protocol 1: all marker publishers/removers lock this directory inode."""
    private(run, directory=True)
    fd = os.open(run, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        deadline = time.monotonic() + CLI_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Busy("marker coordination lock timed out") from None
                time.sleep(min(0.05, remaining))
        info = run.lstat()
        held = os.fstat(fd)
        if (info.st_dev, info.st_ino) != (held.st_dev, held.st_ino):
            raise Error("marker coordination directory changed")
        private(run, directory=True)
        yield fd
    finally:
        os.close(fd)


def _stop_marker_publication_failed(run: Path, *, reason: str):
    """Retain the existing admission barrier even when marker publication fails."""
    private(run, directory=True)
    fd = os.open(run, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        _write_record(run / "stop-renewal.json", {
            "schema": 1, "reason": reason,
        })
        os.fsync(fd)
    finally:
        os.close(fd)


def write(path: Path, value):
    if path.name not in {UNCERTAINTY_MARKER, PARENT_UNCERTAINTY_MARKER}:
        return _write_record(path, value)
    try:
        with marker_lock(path.parent) as fd:
            _write_record(path, value)
            os.fsync(fd)
    except (Error, OSError, ValueError) as error:
        # Never publish unlocked. This barrier also covers file/directory fsync
        # failures; if it cannot persist, propagate uncertainty to the owner.
        _stop_marker_publication_failed(
            path.parent,
            reason="marker_lock_unavailable" if isinstance(error, Busy) else "marker_publication_failed",
        )
        raise


@contextmanager
def lock(run: Path):
    fd = os.open(run / "helper.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        private(run / "helper.lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise Busy("helper is already running") from error
        yield
    finally:
        os.close(fd)


@contextmanager
def admission_lock(root: Path):
    path = root / "admission.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        private(path)
        deadline = time.monotonic() + CLI_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as error:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Busy("run admission lock timed out") from error
                time.sleep(min(0.1, remaining))
        yield
    finally:
        os.close(fd)


def stop_child(child, *, group=False):
    if child.poll() is not None:
        return
    try:
        if group:
            os.killpg(child.pid, signal.SIGTERM)
        else:
            child.terminate()
    except ProcessLookupError:
        child.wait(timeout=5)
        return
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        if group:
            os.killpg(child.pid, signal.SIGKILL)
        else:
            child.kill()
        child.wait(timeout=5)


def capture(command, *, timeout=CLI_TIMEOUT, tick=None, resource_operation=None):
    """Bound both output streams while retaining only owned child handles."""
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    output = {child.stdout: bytearray(), child.stderr: bytearray()}
    deadline = time.monotonic() + timeout
    try:
        with selectors.DefaultSelector() as selector:
            for stream in output:
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ)
            while selector.get_map() or child.poll() is None:
                if time.monotonic() >= deadline:
                    raise Error(f"{Path(command[0]).name} timed out")
                if tick:
                    tick()
                for key, _events in selector.select(0.1):
                    data = os.read(key.fd, 65536)
                    if not data:
                        selector.unregister(key.fileobj)
                    else:
                        output[key.fileobj].extend(data)
                        if sum(map(len, output.values())) > MAX_BYTES:
                            raise Error("command output exceeds size limit")
            if child.wait() != 0:
                # CLI stderr is diagnostic only; do not copy arbitrary tool
                # responses (which may include secrets) into evidence.
                label = (f"resource-lease {resource_operation}" if resource_operation
                         else Path(command[0]).name)
                message = f"{label} failed with exit {child.returncode}"
                if resource_operation == "acquire":
                    message += (
                        ". Check pool status using executable and pool from the client configuration:"
                        " <executable> --root <pool> status."
                        " Inspect the original run before retrying."
                    )
                raise Error(message)
            value = json.loads(output[child.stdout], object_pairs_hook=unique_object)
            if not isinstance(value, dict):
                raise Error("command returned a non-object result")
            return value
    finally:
        stop_child(child)
        for stream in output:
            stream.close()


def absolute(value, label):
    if not isinstance(value, str) or not Path(value).is_absolute():
        raise Error(f"{label} must be an absolute path")
    return Path(value).resolve()


def configuration(path):
    value = read(Path(path))
    if (set(value) != {"schema", "executable", "pool", "runs_directory", "profiles"}
            or type(value["schema"]) is not int or value["schema"] != 1):
        raise Error("unsupported resource client configuration")
    for key in ("executable", "pool", "runs_directory"):
        value[key] = str(absolute(value[key], key))
    if not os.access(value["executable"], os.X_OK):
        raise Error("configured resource-lease executable is unavailable")
    profiles = value["profiles"]
    if (not isinstance(profiles, dict) or not profiles
            or any(not isinstance(k, str) or not isinstance(v, str) or not k or not v
                   for k, v in profiles.items())):
        raise Error("profiles must map explicit names to capabilities")
    return value


def native_active(binding):
    task, session, project = (binding[key] for key in ("task", "session", "project"))
    deadline = time.monotonic() + CLI_TIMEOUT
    def observe(command):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Error("native observation timed out")
        return capture(command, timeout=remaining)
    detail = observe(["kent", "task", "show", task, "--project", project, "--json"])
    summary, status = detail.get("summary", {}), detail.get("status", {})
    if (not isinstance(summary, dict) or not isinstance(status, dict)
            or summary.get("id") != task or summary.get("done") is not False
            or status.get("kind") != "running"
            or status.get("native_state") not in {"running", "active", "waiting", "waiting_ask", "waiting_approval"}):
        raise Error("native Task is not observably active")
    offset = 0
    for _page in range(100):
        page = observe(["kent", "task", "sessions", task, "--project", project,
                        "--offset", str(offset), "--limit", "100", "--json"])
        if page.get("task_id") != task or not isinstance(page.get("items"), list):
            raise Error("invalid native Session inventory")
        matches = [row for row in page["items"] if isinstance(row, dict)
                   and row.get("session_id") == session]
        if matches:
            if len(matches) != 1 or matches[0].get("status") != "running":
                raise Error("native Session is not running")
            return
        following = page.get("next_offset")
        if following is None:
            break
        if type(following) is not int or following <= offset:
            raise Error("invalid native Session pagination")
        offset = following
    raise Error("native Session is missing from bounded inventory")


def canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode()


def aggregate_command_stop(parent_stop, remote_stop):
    if parent_stop in {"pending", "unconfirmed"} or remote_stop == "pending":
        return "unconfirmed"
    if parent_stop == "not_started" and remote_stop == "not_started":
        return "not_started"
    return "confirmed"


def _marker_identity(path: Path) -> dict:
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        raise Error("remote stop marker is not an owner-private regular file")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
            raise Error("remote stop marker changed while opening")
        raw = os.read(fd, MAX_BYTES + 1)
        after = os.fstat(fd)
        current = path.lstat()
        if (len(raw) > MAX_BYTES or len(raw) != opened.st_size
                or (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
                != (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns)
                or (current.st_dev, current.st_ino) != (opened.st_dev, opened.st_ino)):
            raise Error("remote stop marker changed while reading")
        return {
            "device": after.st_dev, "inode": after.st_ino, "size": after.st_size,
            "mtime_ns": after.st_mtime_ns, "ctime_ns": after.st_ctime_ns,
            "sha256": hashlib.sha256(raw).hexdigest(),
        }
    finally:
        os.close(fd)


def _remote_stop_state(run: Path, lease, directory_fd: int):
    path = run / REMOTE_STOP_RECORD
    marker = run / UNCERTAINTY_MARKER
    if not (path.exists() or path.is_symlink()):
        if marker.exists() or marker.is_symlink():
            raise Error("remote stop marker lacks provenance")
        return "not_started"
    value = read(path)
    required = {"schema", "stop_protocol", "operation_id", "state", "run_directory",
                "binding_sha256", "lease_identity", "marker_identity"}
    if set(value) != required or type(value.get("schema")) is not int or value["schema"] != 1:
        raise Error("invalid remote stop record")
    if type(value.get("stop_protocol")) is not int or value["stop_protocol"] != STOP_PROTOCOL:
        raise Error("unsupported remote stop protocol")
    operation_id = value.get("operation_id")
    try:
        if not isinstance(operation_id, str) or str(uuid.UUID(operation_id)) != operation_id:
            raise ValueError
    except ValueError:
        raise Error("invalid remote operation identity") from None
    if value.get("state") not in {"pending", "confirmed"}:
        raise Error("invalid remote operation state")
    if value.get("run_directory") != str(run.resolve()):
        raise Error("remote operation belongs to another run")
    binding_path = run / "binding.json"
    if not binding_path.exists():
        raise Error("remote operation has no owner binding")
    binding = read(binding_path)
    if (binding.get("stop_protocol") != STOP_PROTOCOL
            or binding.get("custody_marker_protocol") != CUSTODY_MARKER_PROTOCOL
            or hashlib.sha256(canonical_json(binding)).hexdigest() != value.get("binding_sha256")):
        raise Error("remote operation owner binding changed")
    identity = value.get("lease_identity")
    if (not isinstance(identity, dict) or set(identity) != {
            "id", "generation", "slot", "owner", "capability"}
            or not isinstance(identity.get("id"), str) or not identity["id"]
            or type(identity.get("generation")) is not int or identity["generation"] < 0
            or not isinstance(identity.get("slot"), str) or not identity["slot"]
            or identity.get("owner") != binding.get("owner")
            or identity.get("capability") != binding.get("capability")
            or value.get("marker_identity") is not None and (
                not isinstance(value.get("marker_identity"), dict)
                or set(value["marker_identity"]) != {
                    "device", "inode", "size", "mtime_ns", "ctime_ns", "sha256"}
                or any(type(value["marker_identity"].get(key)) is not int
                       or value["marker_identity"][key] < 0 for key in (
                           "device", "inode", "size", "mtime_ns", "ctime_ns"))
                or not isinstance(value["marker_identity"].get("sha256"), str)
                or re.fullmatch(r"[0-9a-f]{64}", value["marker_identity"]["sha256"]) is None
            )
            or value.get("state") == "confirmed" and value.get("marker_identity") is None):
        raise Error("remote operation lease identity is invalid")
    if lease is not None:
        if not isinstance(lease, dict) or lease.get("id") != identity["id"] or lease.get("slot") != identity["slot"]:
            raise Error("remote operation lease identity changed")
        generation = lease.get("generation")
        if generation is None:
            if lease.get("state") not in {"completed", "cancelled", "expired"}:
                raise Error("remote operation lease generation is unavailable")
            # The bound operation record above retains the historical generation.
            # Terminal observations legitimately clear it; the previous status is
            # another observation, not the durable historical identity.
        elif type(generation) is not int or generation != identity["generation"]:
            raise Error("remote operation lease identity changed")
    if marker.exists() or marker.is_symlink():
        marker_value = read(marker)
        marker_identity = _marker_identity(marker)
        if (marker_value.get("schema") != 2
                or marker_value.get("operation_id") != operation_id
                or marker_value.get("reason") not in {
                    "remote_stop_unconfirmed", "host_interrupted",
                    "remote_execution_uncertain", "native_runner_drain_unconfirmed"}
                or value.get("marker_identity") is None
                or marker_identity != value["marker_identity"]):
            raise Error("remote stop marker changed")
        if value["state"] == "confirmed":
            os.fsync(directory_fd)
            marker.unlink()
            os.fsync(directory_fd)
    elif value["state"] == "pending":
        # Missing marker is not evidence; the durable pending record remains authoritative.
        return "pending"
    return value["state"]


@dataclass
class Lease:
    run: Path
    metadata: dict

    @property
    def config(self):
        return self.metadata["config"]

    def cli(self, action, *, timeout=CLI_TIMEOUT, tick=None):
        command = [self.config["executable"], "--root", self.config["pool"], action,
                   "--owner", self.metadata["owner"], "--lease", str(self.run / "receipt.json")]
        if action == "acquire":
            command += ["--capability", self.metadata["capability"], "--wait", str(ACQUIRE_TIMEOUT)]
        elif action in {"cancel", "release"}:
            command += ["--wait", str(CLEANUP_TIMEOUT)]
        value = capture(command, timeout=timeout, tick=tick, resource_operation=action)
        if (value.get("owner") != self.metadata["owner"]
                or value.get("capability") != self.metadata["capability"]):
            raise Error("CLI returned a different lease binding")
        return value

    def record(self, phase, *, lease=None, error=None, parent_command_stop=None):
        with marker_lock(self.run) as directory_fd:
            try:
                previous = read(self.run / "status.json")
            except FileNotFoundError:
                previous = {}
            if previous and previous.get("stop_protocol") != STOP_PROTOCOL:
                raise Error("legacy stop record requires qualified reconciliation")
            parent_stop = parent_command_stop
            if parent_stop is None:
                parent_stop = previous.get("parent_command_stop", "not_started")
            if parent_stop not in {"not_started", "pending", "confirmed", "unconfirmed"}:
                raise Error("invalid parent command-stop state")
            parent_marker = self.run / PARENT_UNCERTAINTY_MARKER
            if parent_marker.exists() or parent_marker.is_symlink():
                parent_stop = "unconfirmed"
            prior_lease = lease if lease is not None else previous.get("lease")
            remote_stop = _remote_stop_state(self.run, prior_lease, directory_fd)
            if remote_stop not in {"not_started", "pending", "confirmed"}:
                raise Error("invalid remote command-stop state")
            command_stop = aggregate_command_stop(parent_stop, remote_stop)
            if phase == "finished" and (
                    parent_stop not in {"not_started", "confirmed"}
                    or remote_stop not in {"not_started", "confirmed"}):
                phase = "failed"
                error = error or previous.get("error") or "command stop is uncertain"
            if command_stop == "unconfirmed":
                if phase == "finished":
                    phase = "failed"
                message = "command stop is uncertain"
                if not error:
                    error = message
                elif not error.startswith(message):
                    error = f"{message}; {error}"
            lease_value = prior_lease
            value = {"phase": phase, "updated_at": time.monotonic(),
                     "stop_protocol": STOP_PROTOCOL,
                     "custody_marker_protocol": CUSTODY_MARKER_PROTOCOL,
                     "parent_command_stop": parent_stop,
                     "remote_command_stop": remote_stop,
                     "run_directory": str(self.run), "lease": lease_value, "error": error,
                     "command_stop": command_stop}
            _write_record(self.run / "status.json", value)
            os.fsync(directory_fd)
            return value

    def finish(self, cancel=False):
        if not (self.run / "receipt.json").exists():
            # The CLI writes its receipt before registration. With the helper
            # lock held and acquire child reaped, no receipt means no request.
            value = {
                "state": "cancelled", "cleanup_pending": False, "quarantined": False,
                "endpoint": None, "request_created": False,
            }
        else:
            value = self.cli("cancel" if cancel else "release", timeout=CLEANUP_TIMEOUT + 5)
            if (value.get("state") not in {"completed", "cancelled", "expired"}
                    or value.get("cleanup_pending") is not False or value.get("quarantined") is not False):
                raise Error("resource cleanup is not confirmed")
        try:
            status = self.record("finished", lease=value)
        except (Error, OSError, ValueError) as error:
            raise FinishStatusUncertain(value) from error
        if status["phase"] != "finished":
            raise CommandStopUncertain(status["error"])
        return status


def active(value):
    remaining = value.get("expires_in")
    if (value.get("state") != "active" or not isinstance(value.get("endpoint"), dict)
            or not value["endpoint"] or isinstance(remaining, bool)
            or not isinstance(remaining, (float, int)) or not math.isfinite(remaining)
            or remaining <= 0 or value.get("quarantined") is not False):
        raise Error("lease is not active")
    return min(10.0, remaining / 3)


def prune(root):
    """Bound proven-finished records; retain all unknown/failed evidence."""
    completed = []
    allowed = {"binding.json", "status.json", "receipt.json", "helper.lock",
               "finish.json", "launched.json", "stop-renewal.json",
               REMOTE_STOP_RECORD, PARENT_UNCERTAINTY_MARKER}

    def finished(run):
        status = read(run / "status.json")
        value = status.get("lease") or {}
        marker = run / UNCERTAINTY_MARKER
        parent_marker = run / PARENT_UNCERTAINTY_MARKER
        remote_path = run / REMOTE_STOP_RECORD
        remote_state = "not_started"
        if remote_path.exists() or remote_path.is_symlink():
            binding = read(run / "binding.json")
            remote = read(remote_path)
            if (remote.get("stop_protocol") != STOP_PROTOCOL
                    or remote.get("binding_sha256") != hashlib.sha256(canonical_json(binding)).hexdigest()
                    or remote.get("state") not in {"pending", "confirmed"}):
                return None
            remote_state = remote["state"]
        if (status.get("stop_protocol") == STOP_PROTOCOL
                and status.get("parent_command_stop") in {"not_started", "confirmed"}
                and remote_state in {"not_started", "confirmed"}
                and status.get("phase") == "finished"
                and status.get("command_stop") in ("confirmed", "not_started")
                and not (marker.exists() or marker.is_symlink())
                and not (parent_marker.exists() or parent_marker.is_symlink())
                and value.get("state") in {"completed", "cancelled", "expired"}
                and value.get("cleanup_pending") is False
                and value.get("quarantined") is False):
            return status
        return None

    for run in root.iterdir():
        try:
            private(run, directory=True)
            status = finished(run)
            if status is not None:
                completed.append((status["updated_at"], run))
        except (Error, OSError, ValueError, KeyError, TypeError):
            continue
    for _updated, run in sorted(completed)[:-64]:
        try:
            with lock(run):
                if finished(run) is None:
                    continue
                files = list(run.iterdir())
                if any(path.name not in allowed for path in files):
                    continue
                for path in files:
                    private(path)
                for path in files:
                    path.unlink()
                run.rmdir()
        except (Error, OSError):
            continue


def prepare(args, binding=None):
    config = configuration(args.config)
    if args.profile not in config["profiles"]:
        raise Error("requested profile is not configured")
    root = Path(config["runs_directory"])
    mkdir(root)
    run = absolute(args.run_dir, "run directory") if getattr(args, "run_dir", None) else root / uuid.uuid4().hex
    if run.parent != root or run.name == "admission.lock":
        raise Error("run directory must be a non-reserved direct child of runs_directory")
    metadata = {"schema": 1, "config": config, "profile": args.profile,
                "stop_protocol": STOP_PROTOCOL,
                "custody_marker_protocol": CUSTODY_MARKER_PROTOCOL,
                "capability": config["profiles"][args.profile],
                "owner": args.owner if binding is None else f"smoke:{binding['task']}:{binding['session']}",
                "binding": binding}
    with admission_lock(root):
        prune(root)
        try:
            count = sum(path.name != "admission.lock" for path in root.iterdir())
            if count >= MAX_RUNS and not run.exists():
                raise Error("consumer run retention limit reached; inspect completed records")
            run.mkdir(mode=0o700)
        except FileExistsError:
            private(run, directory=True)
            if read(run / "binding.json") != metadata:
                raise Error("existing run has a different immutable binding")
        else:
            write(run / "binding.json", metadata)
    return Lease(run, metadata)


def load(run):
    run = Path(run).absolute()
    private(run, directory=True)
    run = run.resolve()
    metadata = read(run / "binding.json")
    if (type(metadata.get("schema")) is not int or metadata["schema"] != 1
            or metadata.get("stop_protocol") != STOP_PROTOCOL
            or metadata.get("custody_marker_protocol") != CUSTODY_MARKER_PROTOCOL
            or run.parent != Path(metadata["config"]["runs_directory"])):
        raise Error("legacy stop record requires qualified reconciliation")
    return Lease(run, metadata)


class Renewal:
    def __init__(self, lease):
        self.lease = lease
        self.next_native = 0.0
        self.next_record = 0.0
        self.next_renew = 0.0
        self.value = None
        self.phase = "acquiring"

    def tick(self):
        now = time.monotonic()
        if STOP or (self.lease.run / "finish.json").exists():
            raise InterruptedError("consumer stopped")
        if (self.lease.run / "stop-renewal.json").exists():
            raise Error("renewal was permanently stopped")
        binding = self.lease.metadata["binding"]
        if binding and now >= self.next_native:
            native_active(binding)
            self.next_native = time.monotonic() + (
                active(self.value) if self.value is not None else 10
            )
        if self.value is not None and now >= self.next_renew:
            self.value = self.lease.cli("renew")
            self.next_renew = time.monotonic() + active(self.value)
        if now >= self.next_record:
            self.lease.record(self.phase, lease=self.value)
            self.next_record = time.monotonic() + 1

    def acquire(self):
        self.tick()
        self.value = self.lease.cli("acquire", timeout=ACQUIRE_TIMEOUT + 5, tick=self.tick)
        self.next_renew = time.monotonic() + active(self.value)
        self.phase = "active"
        self.lease.record(self.phase, lease=self.value)
        return self.value


def run_command(args):
    command = args.command[1:] if args.command and args.command[0] == "--" else args.command
    if not command:
        raise Error("a command is required")
    lease = prepare(args)
    child = None
    acquired = False
    failure = None
    result = 1
    with lock(lease.run):
        renewal = Renewal(lease)
        try:
            value = renewal.acquire()
            acquired = True
            environment = os.environ.copy()
            for mapping in args.env:
                variable, separator, key = mapping.partition("=")
                if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", variable):
                    raise Error("expected --env VARIABLE=endpoint_key")
                endpoint = value["endpoint"].get(key)
                if not isinstance(endpoint, str) or not endpoint:
                    raise Error("required endpoint field is unavailable")
                if variable in environment and environment[variable] != endpoint:
                    raise Error(f"conflicting inherited {variable}")
                environment[variable] = endpoint
            environment["RESOURCE_LEASE_RUN_DIRECTORY"] = str(lease.run)
            # Write ahead of launching: even failed uncertainty-marker/status
            # writes must leave retry/pruning unable to claim a confirmed stop.
            lease.record("active", lease=value, parent_command_stop="pending")
            child = subprocess.Popen(command, env=environment, start_new_session=True)
            while child.poll() is None:
                renewal.tick()
                time.sleep(0.1)
            # A final authoritative check prevents success after silent lease loss.
            active(lease.cli("inspect"))
            result = child.returncode
        except (Error, OSError, ValueError, InterruptedError) as error:
            failure = str(error)
            print(f"resource-lease-client: {failure}", file=sys.stderr)
        finally:
            if child is None:
                try:
                    lease.record("active", lease=renewal.value, parent_command_stop="not_started")
                except (Error, OSError, ValueError):
                    message = "command non-start confirmation persistence failed"
                    failure = f"{failure}; {message}" if failure else message
                    print(f"resource-lease-client: {failure}", file=sys.stderr)
            else:
                try:
                    stop_child(child, group=True)
                except (OSError, subprocess.TimeoutExpired) as error:
                    reason = "wait_timeout" if isinstance(error, subprocess.TimeoutExpired) else "signal_error"
                    failure = f"command stop is uncertain ({reason})"
                    try:
                        write(lease.run / PARENT_UNCERTAINTY_MARKER,
                              {"schema": 1, "reason": reason})
                    except (Error, OSError, ValueError):
                        failure += "; uncertainty marker persistence failed"
                    try:
                        lease.record("failed", lease=renewal.value, error=failure,
                                     parent_command_stop="unconfirmed")
                    except (Error, OSError, ValueError):
                        failure += "; command status persistence failed"
                    print(f"resource-lease-client: {failure}", file=sys.stderr)
                else:
                    try:
                        lease.record("active", lease=renewal.value, parent_command_stop="confirmed")
                    except (Error, OSError, ValueError):
                        failure = "command stop confirmation persistence failed"
                        print(f"resource-lease-client: {failure}", file=sys.stderr)
            try:
                lease.finish(cancel=not acquired)
            except CommandStopUncertain as error:
                failure = failure or str(error)
                print(f"resource-lease-client: {error}", file=sys.stderr)
            except (Error, OSError, ValueError) as error:
                if isinstance(error, FinishStatusUncertain):
                    cleanup_error, cleanup_value = str(error), error.lease
                else:
                    cleanup_error, cleanup_value = f"cleanup failed: {error}", renewal.value
                failure = f"{failure}; {cleanup_error}" if failure else cleanup_error
                try:
                    lease.record("failed", lease=cleanup_value, error=failure)
                except (Error, OSError, ValueError):
                    failure += "; cleanup status persistence failed"
                print(f"resource-lease-client: {failure}", file=sys.stderr)
        print(json.dumps({"command_exit": child.returncode if child else None,
                          "consumer_error": failure, "run_directory": str(lease.run)}),
              file=sys.stderr)
        return result if failure is None else 1


def serve(run):
    lease = load(run)
    with lock(lease.run):
        if (lease.run / "status.json").exists():
            raise Error("a stopped helper cannot be restarted")
        renewal = Renewal(lease)
        try:
            renewal.acquire()
            while True:
                renewal.tick()
                time.sleep(0.1)
        except InterruptedError:
            try:
                lease.finish(cancel=renewal.value is None)
            except (Error, OSError, ValueError) as error:
                lease.record("failed", error=str(error))
                return 1
        except (Error, OSError, ValueError) as error:
            # Unknown observation is not proof device effects drained.
            # Stop renewal; the existing service TTL remains the fallback.
            lease.record("stopped", lease=renewal.value, error=str(error))
            return 1
    return 0


def check(run):
    lease = load(run)
    if (lease.run / "stop-renewal.json").exists():
        raise Error("renewal was permanently stopped")
    value = read(lease.run / "status.json")
    if (value.get("stop_protocol") != STOP_PROTOCOL
            or value.get("custody_marker_protocol") != CUSTODY_MARKER_PROTOCOL):
        raise Error("legacy stop record requires qualified reconciliation")
    age = time.monotonic() - value["updated_at"]
    if value.get("phase") != "active" or not 0 <= age <= HEARTBEAT_MAX_AGE:
        raise Error("helper is not observably active")
    try:
        with lock(lease.run):
            raise Error("helper is no longer running")
    except Busy:
        pass
    try:
        if lease.metadata["binding"] is not None:
            native_active(lease.metadata["binding"])
        current = lease.cli("inspect")
        active(current)
    except (Error, OSError, ValueError):
        write(lease.run / "stop-renewal.json", {"schema": 1})
        raise
    value["lease"] = current
    value["endpoint"] = current["endpoint"]
    return value


def start(args):
    task = args.task
    if not task.startswith("task-") or str(uuid.UUID(task[5:])) != task[5:]:
        raise Error("expected canonical native task-UUID")
    if str(uuid.UUID(args.session)) != args.session:
        raise Error("expected canonical Session UUID")
    binding = {"project": args.project, "task": task, "session": args.session}
    native_active(binding)
    lease = prepare(args, binding)
    if (lease.run / "status.json").exists():
        return check(lease.run)
    # Serialize launch admission separately from the long-lived helper lock.
    with lock(lease.run):
        if (lease.run / "launched.json").exists():
            raise Error("helper startup outcome is unknown; inspect the original run")
        write(lease.run / "launched.json", {"schema": 1})
    child = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_serve", "--run-dir", str(lease.run)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.monotonic() + ACQUIRE_TIMEOUT + 10
    while time.monotonic() < deadline:
        if (lease.run / "status.json").exists():
            value = read(lease.run / "status.json")
            if value.get("phase") == "active":
                return check(lease.run)
            if value.get("phase") in {"stopped", "failed", "finished"}:
                raise Error(value.get("error") or "helper stopped")
        if STOP:
            write(lease.run / "finish.json", {"schema": 1})
            raise Error("startup interrupted; inspect original run cleanup")
        if child.poll() is not None:
            raise Error("helper exited before readiness; inspect original run")
        time.sleep(0.1)
    raise Error("helper readiness timed out; inspect original run before retry")


def finish(run):
    lease = load(run)
    write(lease.run / "finish.json", {"schema": 1})
    deadline = time.monotonic() + CLEANUP_TIMEOUT + CLI_TIMEOUT + 10
    while time.monotonic() < deadline:
        try:
            with lock(lease.run):
                return lease.finish(cancel=not (lease.run / "receipt.json").exists())
        except Busy:
            pass
        value = read(lease.run / "status.json")
        if value.get("phase") == "finished":
            return value
        if value.get("phase") == "failed":
            raise Error(value.get("error") or "helper cleanup failed")
        time.sleep(0.1)
    raise Error("helper cleanup timed out")


def _load_stop_proof():
    sibling = Path(__file__).parent / "resource_lease_stop_proof.py"
    try:
        before = sibling.lstat()
    except OSError:
        raise Error("terminal proof reader is unavailable") from None
    if (stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid() or before.st_mode & 0o022
            or before.st_size > 4 * 1024 * 1024):
        raise Error("terminal proof reader is not a trusted sibling")
    fd = os.open(sibling, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(fd)
        if ((opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
                or not stat.S_ISREG(opened.st_mode) or opened.st_uid != os.getuid()
                or opened.st_mode & 0o022 or opened.st_size > 4 * 1024 * 1024):
            raise Error("terminal proof reader changed while opening")
        source = os.read(fd, 4 * 1024 * 1024 + 1)
        after = os.fstat(fd)
        if (len(source) != opened.st_size or len(source) > 4 * 1024 * 1024
                or (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)
                != (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns, opened.st_ctime_ns)):
            raise Error("terminal proof reader changed while reading")
    finally:
        os.close(fd)
    if hashlib.sha256(source).hexdigest() != STOP_PROOF_SHA256:
        raise Error("terminal proof reader digest does not match the managed bundle")
    module_name = f"_resource_lease_stop_proof_{STOP_PROOF_SHA256[:16]}"
    module = types.ModuleType(module_name)
    module.__file__ = str(sibling)
    sys.modules[module_name] = module
    try:
        exec(compile(source, str(sibling), "exec"), module.__dict__)
    except BaseException:
        sys.modules.pop(module_name, None)
        raise
    return module


def reconcile(args):
    # Loaded only for the explicit, proof-gated legacy terminal recovery path.
    stop_proof = _load_stop_proof()
    proof = stop_proof.verify_bundle(Path(args.request), Path(args.qualification))
    result = stop_proof.apply_terminal_reconciliation(proof)
    print(json.dumps({
        "phase": result.status["phase"],
        "command_stop": result.status["command_stop"],
        "operation_id": proof.intent["operation_id"],
        "already_applied": result.already_applied,
    }, sort_keys=True))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    for name in ("run", "start"):
        command = commands.add_parser(name)
        command.add_argument("--config", required=True)
        command.add_argument("--profile", required=True)
        if name == "run":
            command.add_argument("--owner", required=True)
            command.add_argument("--env", action="append", default=[])
            command.add_argument("command", nargs=argparse.REMAINDER)
        else:
            for key in ("run-dir", "project", "task", "session"):
                command.add_argument(f"--{key}", required=True)
    reconcile_command = commands.add_parser(
        "reconcile", help="apply a reviewed terminal-only legacy stop proof",
    )
    reconcile_command.add_argument("--request", required=True)
    reconcile_command.add_argument("--qualification", required=True)
    for name in ("check", "finish", "_serve"):
        command = commands.add_parser(name)
        command.add_argument("--run-dir", required=True)
    args = parser.parse_args()
    for number in (signal.SIGTERM, signal.SIGINT):
        signal.signal(number, interrupted)
    try:
        if args.action == "run":
            return run_command(args)
        if args.action == "_serve":
            return serve(args.run_dir)
        if args.action == "reconcile":
            return reconcile(args)
        result = (start(args) if args.action == "start" else
                  check(args.run_dir) if args.action == "check" else finish(args.run_dir))
        print(json.dumps(result, sort_keys=True))
        return 0
    except (Error, OSError, ValueError, KeyError, TypeError) as error:
        print(f"resource-lease-client: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
