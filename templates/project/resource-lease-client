#!/usr/bin/env python3
"""Cooperative command/Session renewal over an independently installed CLI."""
from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import pwd
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
import uuid
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

MAX_BYTES = 262144
MAX_RUNS = 256
CLI_TIMEOUT = 10.0
ACQUIRE_TIMEOUT = 300.0
CLEANUP_TIMEOUT = 120.0
HEARTBEAT_MAX_AGE = 30.0
CUSTODY_MARKER_PROTOCOL = 1
UNCERTAINTY_MARKER = "command-stop-uncertain.json"
PARENT_STATES = {"not_started", "pending", "confirmed", "unconfirmed"}
MARKER_REASONS = {
    "native_runner_drain_unconfirmed", "remote_stop_unconfirmed",
    "host_interrupted", "remote_execution_uncertain",
    "wait_timeout", "signal_error",
}
STATUS_PHASES = {"preparing", "acquiring", "active", "stopped", "failed", "finished"}
STOP = False


class Error(ValueError):
    pass


class Busy(Error):
    pass


class FinishStatusUncertain(Error):
    def __init__(self, lease):
        super().__init__("resource cleanup is confirmed; finish status persistence failed")
        self.lease = lease


def interrupted(_number, _frame):
    global STOP
    STOP = True


def private(path: Path, *, directory=False):
    info = path.lstat()
    if (stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid()
            or info.st_mode & 0o077
            or not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))):
        raise Error(f"not an owner-private {'directory' if directory else 'file'}: {path}")


def mkdir(path: Path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    private(path, directory=True)


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise Error("duplicate JSON field")
        value[key] = item
    return value


def read(path: Path):
    private(path)
    with path.open("rb") as stream:
        data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        raise Error("JSON record exceeds size limit")
    value = json.loads(data, object_pairs_hook=unique_object)
    if not isinstance(value, dict):
        raise Error("expected a JSON object")
    return value


def _write_record(path: Path, value):
    data = (json.dumps(value, sort_keys=True, allow_nan=False) + "\n").encode()
    if len(data) > MAX_BYTES:
        raise Error("JSON record exceeds size limit")
    temporary = path.with_name(f".{path.name}-{uuid.uuid4().hex}")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


@contextmanager
def marker_lock(run: Path):
    """Protocol 1: all marker publishers/removers lock this directory inode."""
    private(run, directory=True)
    fd = os.open(run, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        deadline = time.monotonic() + CLI_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Busy("marker coordination lock timed out") from None
                time.sleep(min(0.05, remaining))
        info = run.lstat()
        held = os.fstat(fd)
        if (info.st_dev, info.st_ino) != (held.st_dev, held.st_ino):
            raise Error("marker coordination directory changed")
        private(run, directory=True)
        yield fd
    finally:
        os.close(fd)


def _stop_marker_publication_failed(run: Path, *, reason: str):
    """Retain the existing admission barrier even when marker publication fails."""
    private(run, directory=True)
    fd = os.open(run, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        _write_record(run / "stop-renewal.json", {
            "schema": 1, "reason": reason,
        })
        os.fsync(fd)
    finally:
        os.close(fd)


def write(path: Path, value):
    if path.name != UNCERTAINTY_MARKER:
        return _write_record(path, value)
    try:
        with marker_lock(path.parent) as fd:
            _write_record(path, value)
            os.fsync(fd)
    except (Error, OSError, ValueError) as error:
        # Never publish unlocked. This barrier also covers file/directory fsync
        # failures; if it cannot persist, propagate uncertainty to the owner.
        _stop_marker_publication_failed(
            path.parent,
            reason="marker_lock_unavailable" if isinstance(error, Busy) else "marker_publication_failed",
        )
        raise


@contextmanager
def lock(run: Path):
    fd = os.open(run / "helper.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        private(run / "helper.lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise Busy("helper is already running") from error
        yield
    finally:
        os.close(fd)


@contextmanager
def admission_lock(root: Path):
    path = root / "admission.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        private(path)
        deadline = time.monotonic() + CLI_TIMEOUT
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError as error:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Busy("run admission lock timed out") from error
                time.sleep(min(0.1, remaining))
        yield
    finally:
        os.close(fd)


def stop_child(child, *, group=False):
    if child.poll() is not None:
        return
    try:
        if group:
            os.killpg(child.pid, signal.SIGTERM)
        else:
            child.terminate()
    except ProcessLookupError:
        child.wait(timeout=5)
        return
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        if group:
            os.killpg(child.pid, signal.SIGKILL)
        else:
            child.kill()
        child.wait(timeout=5)


def capture(command, *, timeout=CLI_TIMEOUT, tick=None, resource_operation=None, **process):
    """Bound both output streams while retaining only owned child handles."""
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **process)
    output = {child.stdout: bytearray(), child.stderr: bytearray()}
    deadline = time.monotonic() + timeout
    try:
        with selectors.DefaultSelector() as selector:
            for stream in output:
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ)
            while selector.get_map() or child.poll() is None:
                if time.monotonic() >= deadline:
                    raise Error(f"{Path(command[0]).name} timed out")
                if tick:
                    tick()
                for key, _events in selector.select(0.1):
                    data = os.read(key.fd, 65536)
                    if not data:
                        selector.unregister(key.fileobj)
                    else:
                        output[key.fileobj].extend(data)
                        if sum(map(len, output.values())) > MAX_BYTES:
                            raise Error("command output exceeds size limit")
            if child.wait() != 0:
                # CLI stderr is diagnostic only; do not copy arbitrary tool
                # responses (which may include secrets) into evidence.
                label = (f"resource-lease {resource_operation}" if resource_operation
                         else Path(command[0]).name)
                message = f"{label} failed with exit {child.returncode}"
                if resource_operation == "acquire":
                    message += (
                        ". Check pool status using executable and pool from the client configuration:"
                        " <executable> --root <pool> status."
                        " Inspect the original run before retrying."
                    )
                raise Error(message)
            value = json.loads(output[child.stdout], object_pairs_hook=unique_object)
            if not isinstance(value, dict):
                raise Error("command returned a non-object result")
            return value
    finally:
        stop_child(child)
        for stream in output:
            stream.close()


def absolute(value, label):
    if not isinstance(value, str) or not Path(value).is_absolute():
        raise Error(f"{label} must be an absolute path")
    return Path(value).resolve()


def configuration(path):
    value = read(Path(path))
    if (set(value) != {"schema", "executable", "pool", "runs_directory", "profiles"}
            or type(value["schema"]) is not int or value["schema"] != 1):
        raise Error("unsupported resource client configuration")
    for key in ("executable", "pool", "runs_directory"):
        value[key] = str(absolute(value[key], key))
    if not os.access(value["executable"], os.X_OK):
        raise Error("configured resource-lease executable is unavailable")
    profiles = value["profiles"]
    if (not isinstance(profiles, dict) or not profiles
            or any(not isinstance(k, str) or not isinstance(v, str) or not k or not v
                   for k, v in profiles.items())):
        raise Error("profiles must map explicit names to capabilities")
    return value


def native_active(binding):
    task, session, project = (binding[key] for key in ("task", "session", "project"))
    deadline = time.monotonic() + CLI_TIMEOUT
    def observe(command):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Error("native observation timed out")
        return capture(command, timeout=remaining)
    detail = observe(["kent", "task", "show", task, "--project", project, "--json"])
    summary, status = detail.get("summary", {}), detail.get("status", {})
    if (not isinstance(summary, dict) or not isinstance(status, dict)
            or summary.get("id") != task or summary.get("done") is not False
            or status.get("kind") != "running"
            or status.get("native_state") not in {"running", "active", "waiting", "waiting_ask", "waiting_approval"}):
        raise Error("native Task is not observably active")
    offset = 0
    for _page in range(100):
        page = observe(["kent", "task", "sessions", task, "--project", project,
                        "--offset", str(offset), "--limit", "100", "--json"])
        if page.get("task_id") != task or not isinstance(page.get("items"), list):
            raise Error("invalid native Session inventory")
        matches = [row for row in page["items"] if isinstance(row, dict)
                   and row.get("session_id") == session]
        if matches:
            if len(matches) != 1 or matches[0].get("status") != "running":
                raise Error("native Session is not running")
            return
        following = page.get("next_offset")
        if following is None:
            break
        if type(following) is not int or following <= offset:
            raise Error("invalid native Session pagination")
        offset = following
    raise Error("native Session is missing from bounded inventory")


def _marker_present(run: Path) -> bool:
    path = run / UNCERTAINTY_MARKER
    if not (path.exists() or path.is_symlink()):
        return False
    value = read(path)
    if (set(value) != {"schema", "reason", "operation"}
            or type(value.get("schema")) is not int or value["schema"] != 1
            or value.get("reason") not in MARKER_REASONS
            or not isinstance(value.get("operation"), str)
            or re.fullmatch(r"[0-9a-f]{32}", value["operation"]) is None):
        raise Error("uncertainty marker format is unsupported")
    return True


def aggregate_command_stop(parent_stop, external_unconfirmed, marker_present):
    if (parent_stop in {"pending", "unconfirmed"}
            or external_unconfirmed or marker_present):
        return "unconfirmed"
    return "not_started" if parent_stop == "not_started" else "confirmed"


def request_managed_finish(run: Path):
    with marker_lock(run) as directory_fd:
        status = validate_status(read(run / "status.json"), run)
        if (_marker_present(run) or status["external_stop_unconfirmed"]
                or status["parent_command_stop"] in {"pending", "unconfirmed"}):
            raise Error("managed device stop is not confirmed")
        fence = run / "finish.json"
        if os.path.lexists(fence):
            if read(fence) != {"schema": 1}:
                raise Error("invalid managed finish barrier")
        else:
            _write_record(fence, {"schema": 1})
            os.fsync(directory_fd)


def validate_binding(value, run: Path) -> dict:
    required = {
        "schema", "config", "profile", "custody_marker_protocol",
        "capability", "owner", "binding",
    }
    config = value.get("config")
    profile = value.get("profile")
    binding = value.get("binding")
    android = value.get("android_runtime")
    schema = 1
    if "android_runtime" in value:
        required.add("android_runtime")
        if (binding is None or not isinstance(android, dict)
                or set(android) != {"checkout", "settings"}
                or not same_managed_root(run.parent) or not marked_managed(run.parent)):
            raise Error("invalid managed Android binding")
        pinned_path(android["checkout"])
        android_settings(android["settings"], retained=True)
        schema = 2
    if (set(value) != required
            or type(value.get("schema")) is not int or value["schema"] != schema
            or type(value.get("custody_marker_protocol")) is not int
            or value["custody_marker_protocol"] != CUSTODY_MARKER_PROTOCOL
            or not isinstance(config, dict)
            or set(config) != {"schema", "executable", "pool", "runs_directory", "profiles"}
            or type(config.get("schema")) is not int or config["schema"] != 1
            or any(not isinstance(config.get(key), str)
                   or not Path(config[key]).is_absolute()
                   for key in ("executable", "pool", "runs_directory"))
            or not isinstance(config.get("profiles"), dict) or not config["profiles"]
            or any(not isinstance(key, str) or not key
                   or not isinstance(capability, str) or not capability
                   for key, capability in config["profiles"].items())
            or not isinstance(profile, str)
            or not isinstance(value.get("owner"), str) or not value["owner"]
            or config["profiles"].get(profile) != value.get("capability")
            or run.parent != Path(config["runs_directory"])
            or binding is not None and (
                not isinstance(binding, dict)
                or set(binding) != {"project", "task", "session"}
                or any(not isinstance(binding[key], str) or not binding[key]
                       for key in ("project", "task", "session")))):
        raise Error("legacy or malformed consumer run binding requires qualified reconciliation")
    return value


def validate_status(value, run: Path) -> dict:
    updated_at = value.get("updated_at")
    required = {"phase", "updated_at", "custody_marker_protocol",
                "parent_command_stop", "external_stop_unconfirmed",
                "command_stop", "run_directory", "lease", "error"}
    if (set(value) != required
            or value.get("phase") not in STATUS_PHASES
            or type(updated_at) not in (int, float) or not math.isfinite(updated_at)
            or updated_at < 0
            or type(value.get("custody_marker_protocol")) is not int
            or value["custody_marker_protocol"] != CUSTODY_MARKER_PROTOCOL
            or value.get("parent_command_stop") not in PARENT_STATES
            or type(value.get("external_stop_unconfirmed")) is not bool
            or value.get("command_stop") not in {"not_started", "confirmed", "unconfirmed"}
            or value.get("run_directory") != str(run)
            or value.get("lease") is not None and not isinstance(value["lease"], dict)
            or value.get("error") is not None and not isinstance(value["error"], str)):
        raise Error("legacy or malformed owner status requires qualified reconciliation")
    return value


@dataclass
class Lease:
    run: Path
    metadata: dict

    @property
    def config(self):
        return self.metadata["config"]

    def cli(self, action, *, timeout=CLI_TIMEOUT, tick=None):
        command = [self.config["executable"], "--root", self.config["pool"], action,
                   "--owner", self.metadata["owner"], "--lease", str(self.run / "receipt.json")]
        if action == "acquire":
            command += ["--capability", self.metadata["capability"], "--wait", str(ACQUIRE_TIMEOUT)]
        elif action in {"cancel", "release"}:
            command += ["--wait", str(CLEANUP_TIMEOUT)]
        options = {}
        if managed_run(self.run):
            options = {"cwd": "/", "env": {"HOME": str(account_home()),
                                           "PATH": "/usr/bin:/bin"}}
        value = capture(command, timeout=timeout, tick=tick, resource_operation=action, **options)
        if (value.get("owner") != self.metadata["owner"]
                or value.get("capability") != self.metadata["capability"]):
            raise Error("CLI returned a different lease binding")
        return value

    def record(self, phase, *, lease=None, error=None, parent_command_stop=None):
        with marker_lock(self.run) as directory_fd:
            previous = validate_status(read(self.run / "status.json"), self.run)
            prior_parent = previous["parent_command_stop"]
            parent_stop = prior_parent if parent_command_stop is None else parent_command_stop
            if parent_stop not in PARENT_STATES:
                raise Error("invalid parent command-stop state")
            if prior_parent == "unconfirmed":
                parent_stop = "unconfirmed"
            prior_lease = lease if lease is not None else previous.get("lease")
            marker_present = _marker_present(self.run)
            external_unconfirmed = previous["external_stop_unconfirmed"]
            command_stop = aggregate_command_stop(
                parent_stop, external_unconfirmed, marker_present,
            )
            if external_unconfirmed and phase in {"preparing", "acquiring", "active", "finished"}:
                phase = "failed"
            if phase == "finished" and command_stop == "unconfirmed":
                phase = "failed"
                error = error or previous.get("error")
            # Pending work is not a failure, but explicit negatives and
            # uncertainty remaining at stop must retain their diagnostics.
            if command_stop == "unconfirmed" and (
                    phase not in {"preparing", "acquiring", "active"}
                    or parent_stop == "unconfirmed"):
                message = ("command stop is uncertain; resource cleanup confirmed; "
                           "command/business outcome remains unknown"
                           if phase == "failed" and lease is not None
                           and lease.get("state") in {"completed", "cancelled", "expired"}
                           and lease.get("cleanup_pending") is False
                           and lease.get("quarantined") is False
                           else "command stop is uncertain")
                if not error:
                    error = previous.get("error") or message
                if message not in error:
                    error = f"{message}; {error}"
            if error is None:
                error = previous.get("error")
            value = {"phase": phase, "updated_at": time.monotonic(),
                     "custody_marker_protocol": CUSTODY_MARKER_PROTOCOL,
                     "parent_command_stop": parent_stop,
                     "external_stop_unconfirmed": external_unconfirmed,
                     "run_directory": str(self.run), "lease": prior_lease, "error": error,
                     "command_stop": command_stop}
            _write_record(self.run / "status.json", value)
            os.fsync(directory_fd)
            return value

    def finish(self, cancel=False, *, managed=False):
        validate_binding(self.metadata, self.run)
        if managed or managed_run(self.run):
            request_managed_finish(self.run)
        else:
            with marker_lock(self.run):
                validate_status(read(self.run / "status.json"), self.run)
                _marker_present(self.run)
        if not (self.run / "receipt.json").exists():
            # The CLI writes its receipt before registration. With the helper
            # lock held and acquire child reaped, no receipt means no request.
            value = {
                "state": "cancelled", "cleanup_pending": False, "quarantined": False,
                "endpoint": None, "request_created": False,
            }
        else:
            value = self.cli("cancel" if cancel else "release", timeout=CLEANUP_TIMEOUT + 5)
            if (value.get("state") not in {"completed", "cancelled", "expired"}
                    or value.get("cleanup_pending") is not False or value.get("quarantined") is not False):
                raise Error("resource cleanup is not confirmed")
        try:
            status = self.record("finished", lease=value)
        except (Error, OSError, ValueError) as error:
            raise FinishStatusUncertain(value) from error
        return status


def active(value):
    remaining = value.get("expires_in")
    if (value.get("state") != "active" or not isinstance(value.get("endpoint"), dict)
            or not value["endpoint"] or isinstance(remaining, bool)
            or not isinstance(remaining, (float, int)) or not math.isfinite(remaining)
            or remaining <= 0 or value.get("quarantined") is not False):
        raise Error("lease is not active")
    return min(10.0, remaining / 3)


def prune(root):
    """Bound proven-finished records; retain all unknown/failed evidence."""
    completed = []
    allowed = {"binding.json", "status.json", "receipt.json", "helper.lock",
               "finish.json", "launched.json", "stop-renewal.json"}

    def finished(run):
        status = validate_status(read(run / "status.json"), run)
        value = status.get("lease") or {}
        marker_present = _marker_present(run)
        if (status.get("parent_command_stop") in {"not_started", "confirmed"}
                and not status.get("external_stop_unconfirmed")
                and status.get("phase") == "finished"
                and status["error"] is None
                and status.get("command_stop") == aggregate_command_stop(
                    status["parent_command_stop"], False, marker_present,
                )
                and not marker_present
                and value.get("state") in {"completed", "cancelled", "expired"}
                and value.get("cleanup_pending") is False
                and value.get("quarantined") is False):
            return status
        return None

    for run in root.iterdir():
        try:
            private(run, directory=True)
            status = finished(run)
            if status is not None:
                completed.append((status["updated_at"], run))
        except (Error, OSError, ValueError, KeyError, TypeError):
            continue
    for _updated, run in sorted(completed)[:-64]:
        try:
            with lock(run):
                with marker_lock(run):
                    if finished(run) is None:
                        continue
                    files = list(run.iterdir())
                    if any(path.name not in allowed for path in files):
                        continue
                    for path in files:
                        private(path)
                    for path in files:
                        path.unlink()
                    run.rmdir()
        except (Error, OSError):
            continue


def prepare(args, binding=None, *, managed_config=None, android_runtime=None):
    if android_runtime is not None and (managed_config is None or binding is None):
        raise Error("Android settings require managed owner")
    config = configuration(args.config) if managed_config is None else managed_config
    if args.profile not in config["profiles"]:
        raise Error("requested profile is not configured")
    root = Path(config["runs_directory"])
    mkdir(root)
    run = absolute(args.run_dir, "run directory") if getattr(args, "run_dir", None) else root / uuid.uuid4().hex
    if run.parent != root or run.name == "admission.lock":
        raise Error("run directory must be a non-reserved direct child of runs_directory")
    metadata = {"schema": 1, "config": config, "profile": args.profile,
                "custody_marker_protocol": CUSTODY_MARKER_PROTOCOL,
                "capability": config["profiles"][args.profile],
                "owner": args.owner if binding is None else f"smoke:{binding['task']}:{binding['session']}",
                "binding": binding}
    if android_runtime is not None:
        metadata.update(schema=2, android_runtime=android_runtime)
    created = False
    with admission_lock(root):
        marker = root / ".managed-only"
        reserved = managed_config is not None or same_managed_root(root)
        if reserved and os.path.lexists(marker):
            if read(marker) != {"schema": 1} or managed_config is None:
                raise Error("run root is reserved for managed attempts")
        elif managed_config is not None:
            if any(path.name != "admission.lock" for path in root.iterdir()):
                raise Error("managed run root already contains legacy state")
            write(marker, {"schema": 1})
            fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        if managed_config is None:
            prune(root)
        try:
            ignored = {"admission.lock", ".managed-only"} if reserved else {"admission.lock"}
            count = sum(path.name not in ignored for path in root.iterdir())
            if count >= MAX_RUNS and not run.exists():
                raise Error("consumer run retention limit reached; inspect completed records")
            run.mkdir(mode=0o700)
            created = True
        except FileExistsError:
            private(run, directory=True)
            if read(run / "binding.json") != metadata:
                raise Error("existing run has a different immutable binding")
        else:
            write(run / "binding.json", metadata)
            with marker_lock(run) as directory_fd:
                initial = {
                    "phase": "preparing", "updated_at": time.monotonic(),
                    "custody_marker_protocol": CUSTODY_MARKER_PROTOCOL,
                    "parent_command_stop": "not_started",
                    "external_stop_unconfirmed": False,
                    "run_directory": str(run), "lease": None, "error": None,
                    "command_stop": "not_started",
                }
                _write_record(run / "status.json", initial)
                os.fsync(directory_fd)
    if not created:
        validate_status(read(run / "status.json"), run)
        _marker_present(run)
    return Lease(run, metadata)


def load(run):
    run = Path(run).absolute()
    private(run, directory=True)
    run = run.resolve()
    metadata = read(run / "binding.json")
    validate_binding(metadata, run)
    validate_status(read(run / "status.json"), run)
    _marker_present(run)
    return Lease(run, metadata)


class Renewal:
    def __init__(self, lease, *, native=None):
        self.lease = lease
        self.native = native
        self.next_native = 0.0
        self.next_record = 0.0
        self.next_renew = 0.0
        self.value = None
        self.phase = "acquiring"

    def tick(self):
        now = time.monotonic()
        if STOP or (self.lease.run / "finish.json").exists():
            raise InterruptedError("consumer stopped")
        if (self.lease.run / "stop-renewal.json").exists():
            raise Error("renewal was permanently stopped")
        binding = self.lease.metadata["binding"]
        if binding and now >= self.next_native:
            (self.native or native_active)(binding)
            self.next_native = time.monotonic() + (
                active(self.value) if self.value is not None else 10
            )
        if self.value is not None and now >= self.next_renew:
            self.value = self.lease.cli("renew")
            self.next_renew = time.monotonic() + active(self.value)
        if now >= self.next_record:
            self.lease.record(self.phase, lease=self.value)
            self.next_record = time.monotonic() + 1

    def acquire(self):
        self.tick()
        self.value = self.lease.cli("acquire", timeout=ACQUIRE_TIMEOUT + 5, tick=self.tick)
        self.next_renew = time.monotonic() + active(self.value)
        self.phase = "active"
        self.lease.record(self.phase, lease=self.value)
        return self.value


def run_command(args):
    command = args.command[1:] if args.command and args.command[0] == "--" else args.command
    if not command:
        raise Error("a command is required")
    lease = prepare(args)
    child = None
    acquired = False
    failure = None
    result = 1
    with lock(lease.run):
        renewal = Renewal(lease)
        try:
            value = renewal.acquire()
            acquired = True
            environment = os.environ.copy()
            for mapping in args.env:
                variable, separator, key = mapping.partition("=")
                if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", variable):
                    raise Error("expected --env VARIABLE=endpoint_key")
                endpoint = value["endpoint"].get(key)
                if not isinstance(endpoint, str) or not endpoint:
                    raise Error("required endpoint field is unavailable")
                if variable in environment and environment[variable] != endpoint:
                    raise Error(f"conflicting inherited {variable}")
                environment[variable] = endpoint
            environment["RESOURCE_LEASE_RUN_DIRECTORY"] = str(lease.run)
            # Write ahead of launching: even failed uncertainty-marker/status
            # writes must leave retry/pruning unable to claim a confirmed stop.
            lease.record("active", lease=value, parent_command_stop="pending")
            child = subprocess.Popen(command, env=environment, start_new_session=True)
            while child.poll() is None:
                renewal.tick()
                time.sleep(0.1)
            # A final authoritative check prevents success after silent lease loss.
            active(lease.cli("inspect"))
            result = child.returncode
        except (Error, OSError, ValueError, InterruptedError) as error:
            failure = str(error)
            print(f"resource-lease-client: {failure}", file=sys.stderr)
        finally:
            if child is None:
                try:
                    lease.record("active", lease=renewal.value, parent_command_stop="not_started")
                except (Error, OSError, ValueError):
                    message = "command non-start confirmation persistence failed"
                    failure = f"{failure}; {message}" if failure else message
                    print(f"resource-lease-client: {failure}", file=sys.stderr)
            else:
                try:
                    stop_child(child, group=True)
                except (OSError, subprocess.TimeoutExpired) as error:
                    reason = "wait_timeout" if isinstance(error, subprocess.TimeoutExpired) else "signal_error"
                    failure = f"command stop is uncertain ({reason})"
                    try:
                        write(lease.run / UNCERTAINTY_MARKER, {
                            "schema": 1, "reason": reason, "operation": uuid.uuid4().hex,
                        })
                    except (Error, OSError, ValueError):
                        failure += "; uncertainty marker persistence failed"
                    try:
                        lease.record("failed", lease=renewal.value, error=failure,
                                     parent_command_stop="unconfirmed")
                    except (Error, OSError, ValueError):
                        failure += "; command status persistence failed"
                    print(f"resource-lease-client: {failure}", file=sys.stderr)
                else:
                    try:
                        lease.record("active", lease=renewal.value, parent_command_stop="confirmed")
                    except (Error, OSError, ValueError):
                        failure = "command stop confirmation persistence failed"
                        print(f"resource-lease-client: {failure}", file=sys.stderr)
            try:
                status = lease.finish(cancel=not acquired)
                if status["phase"] != "finished":
                    failure = failure or status.get("error") or "command stop is uncertain"
                    print(f"resource-lease-client: {failure}", file=sys.stderr)
            except (Error, OSError, ValueError) as error:
                if isinstance(error, FinishStatusUncertain):
                    cleanup_error, cleanup_value = str(error), error.lease
                else:
                    cleanup_error, cleanup_value = f"cleanup failed: {error}", renewal.value
                failure = f"{failure}; {cleanup_error}" if failure else cleanup_error
                try:
                    lease.record("failed", lease=cleanup_value, error=failure)
                except (Error, OSError, ValueError):
                    failure += "; cleanup status persistence failed"
                print(f"resource-lease-client: {failure}", file=sys.stderr)
        print(json.dumps({"command_exit": child.returncode if child else None,
                          "consumer_error": failure, "run_directory": str(lease.run)}),
              file=sys.stderr)
        return result if failure is None else 1


def serve(run, *, native=None):
    lease = load(run)
    with lock(lease.run):
        if validate_status(read(lease.run / "status.json"), lease.run)["phase"] != "preparing":
            raise Error("a stopped helper cannot be restarted")
        renewal = Renewal(lease) if native is None else Renewal(lease, native=native)
        try:
            renewal.acquire()
            while True:
                renewal.tick()
                time.sleep(0.1)
        except InterruptedError:
            try:
                status = lease.finish(cancel=renewal.value is None, managed=native is not None)
                if status["phase"] != "finished":
                    return 1
            except (Error, OSError, ValueError) as error:
                lease.record("failed", error=str(error))
                return 1
        except (Error, OSError, ValueError) as error:
            # Unknown observation is not proof device effects drained.
            # Stop renewal; the existing service TTL remains the fallback.
            lease.record("stopped", lease=renewal.value, error=str(error))
            return 1
    return 0


def check(run, *, native=None):
    lease = load(run)
    if (lease.run / "stop-renewal.json").exists():
        raise Error("renewal was permanently stopped")
    value = validate_status(read(lease.run / "status.json"), lease.run)
    _marker_present(lease.run)
    age = time.monotonic() - value["updated_at"]
    if value.get("phase") != "active" or not 0 <= age <= HEARTBEAT_MAX_AGE:
        raise Error("helper is not observably active")
    try:
        with lock(lease.run):
            raise Error("helper is no longer running")
    except Busy:
        pass
    try:
        if lease.metadata["binding"] is not None:
            (native or native_active)(lease.metadata["binding"])
        current = lease.cli("inspect")
        active(current)
    except (Error, OSError, ValueError):
        write(lease.run / "stop-renewal.json", {"schema": 1})
        raise
    value["lease"] = current
    value["endpoint"] = current["endpoint"]
    return value


def start(args):
    task = args.task
    if not task.startswith("task-") or str(uuid.UUID(task[5:])) != task[5:]:
        raise Error("expected canonical native task-UUID")
    if str(uuid.UUID(args.session)) != args.session:
        raise Error("expected canonical Session UUID")
    binding = {"project": args.project, "task": task, "session": args.session}
    native_active(binding)
    lease = prepare(args, binding)
    return launch(lease)


def launch(lease, *, native=None, helper_env=None):
    status = validate_status(read(lease.run / "status.json"), lease.run)
    if status["phase"] == "active":
        return check(lease.run) if native is None else check(lease.run, native=native)
    if status["phase"] != "preparing":
        raise Error("a stopped helper cannot be restarted")
    # Serialize launch admission separately from the long-lived helper lock.
    with lock(lease.run):
        if (lease.run / "launched.json").exists():
            raise Error("helper startup outcome is unknown; inspect the original run")
        write(lease.run / "launched.json", {"schema": 1})
        if native is not None:
            fd = os.open(lease.run, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
    action = "_serve" if native is None else "_serve-managed"
    child = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), action, "--run-dir", str(lease.run)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True, **({"env": helper_env} if helper_env is not None else {}),
    )
    deadline = time.monotonic() + ACQUIRE_TIMEOUT + 10
    while time.monotonic() < deadline:
        if (lease.run / "status.json").exists():
            value = read(lease.run / "status.json")
            if value.get("phase") == "active":
                return check(lease.run) if native is None else check(lease.run, native=native)
            if value.get("phase") in {"stopped", "failed", "finished"}:
                raise Error(value.get("error") or "helper stopped")
        if STOP:
            if native is not None:
                request_managed_finish(lease.run)
            else:
                write(lease.run / "finish.json", {"schema": 1})
            raise Error("startup interrupted; inspect original run cleanup")
        if child.poll() is not None:
            raise Error("helper exited before readiness; inspect original run")
        time.sleep(0.1)
    raise Error("helper readiness timed out; inspect original run before retry")


def finish(run, *, managed=False):
    lease = load(run)
    managed = managed or managed_run(lease.run)
    if managed:
        request_managed_finish(lease.run)
    else:
        write(lease.run / "finish.json", {"schema": 1})
    deadline = time.monotonic() + CLEANUP_TIMEOUT + CLI_TIMEOUT + 10
    while time.monotonic() < deadline:
        try:
            with lock(lease.run):
                if managed:
                    current = validate_status(read(lease.run / "status.json"), lease.run)
                    if current["phase"] == "finished":
                        _marker_present(lease.run)
                        return current
                    if ((lease.run / "launched.json").exists()
                            and not (lease.run / "receipt.json").exists()):
                        raise Error("managed release outcome is unknown")
                return lease.finish(cancel=not (lease.run / "receipt.json").exists(), managed=managed)
        except Busy:
            pass
        value = validate_status(read(lease.run / "status.json"), lease.run)
        if value.get("phase") == "finished":
            return value
        time.sleep(0.1)
    raise Error("helper cleanup timed out")


def canonical(value):
    path = absolute(value, "host path")
    if str(path) != value:
        raise Error("host path is not canonical")
    return path


def account_home():
    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def managed_root():
    return account_home() / ".config/kent/android-tools/managed-runs"


def same_managed_root(root):
    fixed = managed_root()
    return fixed.exists() and root.samefile(fixed)


def marked_managed(root):
    marker = root / ".managed-only"
    return os.path.lexists(marker) and read(marker) == {"schema": 1}


def managed_run(run):
    return same_managed_root(run.parent) and marked_managed(run.parent)


def trusted_path(path):
    for component in (*reversed(path.parents), path):
        info = component.lstat()
        if (stat.S_ISLNK(info.st_mode) or info.st_uid not in {0, os.getuid()}
                or info.st_mode & 0o022
                or (component != path and not stat.S_ISDIR(info.st_mode))):
            raise Error("unsafe host path")
    return path


def pinned_path(value):
    if (not isinstance(value, str) or not value.startswith("/")
            or "\x00" in value or str(Path(value)) != value
            or os.path.normpath(value) != value):
        raise Error("invalid pinned Android path")
    return Path(value)


def android_settings(value, *, retained=False):
    required = {"schema", "timeout_seconds", "output_limit_bytes", "providers", "records_directory"}
    if not retained:
        required.add("android_sdk_root")
    if (not isinstance(value, dict) or not required <= value.keys()
            or value.keys() - required - {"android_sdk_root", "retention"}
            or type(value["schema"]) is not int or value["schema"] != 1
            or type(value["timeout_seconds"]) not in (int, float)
            or not 0.1 <= value["timeout_seconds"] <= 300
            or type(value["output_limit_bytes"]) is not int
            or not 4096 <= value["output_limit_bytes"] <= 8388608):
        raise Error("invalid managed Android settings")
    pinned_path(value["records_directory"])
    if "android_sdk_root" in value:
        sdk = pinned_path(value["android_sdk_root"])
        if not retained and os.pathsep in str(sdk):
            raise Error("invalid managed Android SDK path")
    providers = value["providers"]
    if not isinstance(providers, dict) or set(providers) != {"mobile-native"}:
        raise Error("invalid managed Android provider settings")
    provider = providers["mobile-native"]
    if (not isinstance(provider, dict) or set(provider) != {"executable", "version"}
            or not isinstance(provider["version"], str) or not 0 < len(provider["version"]) <= 128
            or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", provider["version"]) is None):
        raise Error("invalid managed Android provider settings")
    pinned_path(provider["executable"])
    retention = value.get("retention", {"max_bytes": 500000000, "max_age_seconds": 604800})
    if (not isinstance(retention, dict) or set(retention) != {"max_bytes", "max_age_seconds"}
            or type(retention["max_bytes"]) is not int
            or not 1048576 <= retention["max_bytes"] <= 10000000000
            or type(retention["max_age_seconds"]) is not int
            or not 60 <= retention["max_age_seconds"] <= 31536000):
        raise Error("invalid managed Android retention")
    return {**value, "retention": retention}


def checkout_local(path):
    return any(os.path.lexists(parent / ".git") for parent in path.parents)


def existing_overlap(left, right):
    def contains(root, path):
        return path.is_relative_to(root) or (
            root.exists() and any(parent.exists() and parent.samefile(root)
                                  for parent in (path, *path.parents)))
    return contains(left, right) or contains(right, left)


def native_uuid(value, prefix=""):
    if not isinstance(value, str) or not value.startswith(prefix):
        raise Error("expected a canonical native UUID")
    suffix = value[len(prefix):]
    try:
        parsed = uuid.UUID(suffix)
    except ValueError:
        raise Error("expected a canonical native UUID") from None
    if str(parsed) != suffix or parsed.version != 4:
        raise Error("expected a canonical native UUID")
    return value


class HostRouting:
    def __init__(self, *, helper=False):
        self.home = canonical(str(account_home()))
        location = self.home / ".config/kent/android-tools"
        if helper:
            value = json.loads(os.environ["KENT_MANAGED_OBSERVER"], object_pairs_hook=unique_object)
        else:
            registration = trusted_path(canonical(str(location / "lease-routes.json")))
            if checkout_local(registration):
                raise Error("host registration cannot live in a checkout")
            value = read(registration)
        if (set(value) != {"schema", "kent_executable", "kent_persistence_root", "routes"}
                or type(value["schema"]) is not int or value["schema"] != 1
                or not isinstance(value["routes"], list) or len(value["routes"]) > 32):
            raise Error("unsupported host registration")
        self.kent = trusted_path(canonical(value["kent_executable"]))
        if not self.kent.is_file() or not os.access(self.kent, os.X_OK) or checkout_local(self.kent):
            raise Error("trusted Kent executable is unavailable")
        state = trusted_path(canonical(value["kent_persistence_root"]))
        if not state.is_dir():
            raise Error("trusted Kent state is unavailable")
        self.env = {"HOME": str(self.home), "PATH": "/usr/bin:/bin",
                    "KENT_PERSISTENCE_ROOT": str(state)}
        self.routes = value["routes"]
        self.root = canonical(str(location / "managed-runs"))

    def helper_environment(self):
        return {**self.env, "KENT_MANAGED_OBSERVER": json.dumps({
            "schema": 1, "kent_executable": str(self.kent),
            "kent_persistence_root": self.env["KENT_PERSISTENCE_ROOT"], "routes": [],
        })}

    def observe(self, deadline, *args):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise Error("native observation timed out")
        return capture([str(self.kent), *args, "--json"], timeout=remaining, cwd="/", env=self.env)

    def target(self, session):
        result = self.observe(time.monotonic() + CLI_TIMEOUT, "worktree", "status", "--session", session)
        target, roots = result.get("target"), result.get("worktree")
        if (result.get("problems") != [] or not isinstance(target, dict) or not isinstance(roots, dict)
                or target.get("workspace_availability") != "available" or "worktree" not in target):
            raise Error("native checkout unavailable")
        workspace = canonical(target.get("workspace_root"))
        linked = target["worktree"]
        if linked is not None and (not isinstance(linked, dict) or linked.get("availability") != "available"):
            raise Error("native checkout unavailable")
        checkout = workspace if linked is None else canonical(linked.get("root"))
        if (roots.get("recorded_root") != str(checkout) or roots.get("observed_root") != str(checkout)
                or not canonical(target.get("effective_workdir")).is_relative_to(checkout)
                or not checkout.is_dir() or not Path.cwd().is_relative_to(checkout)):
            raise Error("native checkout mismatch")
        cwd = Path.cwd()
        while cwd != checkout:
            if os.path.lexists(cwd / ".git"):
                raise Error("native checkout mismatch")
            cwd = cwd.parent
        return workspace, checkout

    def active(self, owner, *, route=None):
        project, task, session = (owner[key] for key in ("project", "task", "session"))
        deadline = time.monotonic() + CLI_TIMEOUT
        detail = self.observe(deadline, "task", "show", task, "--project", project)
        summary, status = detail.get("summary"), detail.get("status")
        if (not isinstance(summary, dict) or not isinstance(status, dict)
                or summary.get("id") != task or summary.get("project_id") != project
                or summary.get("done") is not False or status.get("kind") != "running"
                or status.get("native_state") not in {"running", "active", "waiting", "waiting_ask", "waiting_approval"}
                or route is not None and summary.get("workflow_id") != route["workflow_id"]):
            raise Error("native Task is not authorized and active")
        offset, found = 0, False
        for _page in range(100):
            page = self.observe(deadline, "task", "sessions", task, "--project", project,
                                "--offset", str(offset), "--limit", "100")
            rows = page.get("items")
            if (page.get("task_id") != task or not isinstance(rows, list) or len(rows) > 100
                    or any(not isinstance(row, dict) for row in rows)):
                raise Error("invalid native Session inventory")
            for row in rows:
                if row.get("session_id") == session:
                    if (found or row.get("status") != "running"
                            or route is not None and row.get("node_name") != route["smoke_node"]):
                        raise Error("native Session is not authorized and active")
                    found = True
            following = page.get("next_offset")
            if following is None:
                if found:
                    return
                break
            if type(following) is not int or following <= offset:
                raise Error("invalid native Session pagination")
            offset = following
        raise Error("native Session is missing from bounded inventory")

    def route(self, workspace):
        matches = []
        required = {"project", "workspace", "workflow_id", "smoke_node", "config"}
        for route in self.routes:
            if (not isinstance(route, dict)
                    or not required <= route.keys() or route.keys() - required - {"android_config"}
                    or not isinstance(route["smoke_node"], str) or not route["smoke_node"]):
                raise Error("invalid host route")
            native_uuid(route["project"], "project-")
            native_uuid(route["workflow_id"])
            if canonical(route["workspace"]) == workspace:
                matches.append(route)
        if len(matches) != 1:
            raise Error("host route is missing or ambiguous")
        return matches[0]

    def config(self, route):
        path = trusted_path(canonical(route["config"]))
        if checkout_local(path):
            raise Error("host config cannot live in a checkout")
        config = configuration(path)
        executable = trusted_path(Path(config["executable"]))
        if checkout_local(executable):
            raise Error("allocator executable cannot live in a checkout")
        for registered in self.routes:
            other = trusted_path(canonical(registered["config"]))
            if checkout_local(other):
                raise Error("host config cannot live in a checkout")
            paths = config if other == path else configuration(other)
            if any(existing_overlap(Path(paths[key]), self.root) for key in ("runs_directory", "pool")):
                raise Error("managed runs overlap retained runs")
        return {**config, "runs_directory": str(self.root)}

    def android(self, route, checkout, config):
        if "android_config" not in route:
            return None
        source = trusted_path(canonical(route["android_config"]))
        if checkout_local(source):
            raise Error("Android settings cannot live in a checkout")
        settings = android_settings(read(source))
        executable = trusted_path(canonical(settings["providers"]["mobile-native"]["executable"]))
        records = trusted_path(canonical(settings["records_directory"]))
        adb = trusted_path(Path(settings["android_sdk_root"]) / "platform-tools/adb")
        private(records, directory=True)
        if (not executable.is_file() or not os.access(executable, os.X_OK)
                or checkout_local(executable) or checkout_local(records)
                or not adb.is_file() or not os.access(adb, os.X_OK) or checkout_local(adb)
                or any(existing_overlap(records, root) for root in (
                    self.root, Path(config["pool"]), canonical(route["workspace"]), checkout,
                ))):
            raise Error("unsafe managed Android provider or records")
        return {"checkout": str(checkout), "settings": settings}


@contextmanager
def managed_lock(root, attempt):
    mutexes = root.parent / "managed-locks"
    mkdir(mutexes)
    # Fixed-size namespace: abandoned or rejected UUIDs cannot grow it.
    path = mutexes / f"{int(uuid.UUID(attempt)) % 64:02x}.lock"
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        private(path)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Busy("managed attempt pending") from None
        yield
    finally:
        os.close(fd)


def managed(args, host):
    attempt = native_uuid(args.attempt)
    session = native_uuid(os.environ.get("KENT_SESSION_ID"))
    workspace, checkout = host.target(session)
    run = host.root / attempt
    with managed_lock(host.root, attempt):
        if os.path.lexists(run):
            private(host.root, directory=True)
            if not marked_managed(host.root):
                raise Error("unrecognized managed attempt")
            lease = load(run)
            owner = lease.metadata["binding"]
            if (owner is None or owner["session"] != session
                    or args.action == "begin" and (owner["task"] != args.task
                                                  or lease.metadata["profile"] != args.profile)):
                raise Error("managed attempt owner or intent mismatch")
            android = lease.metadata.get("android_runtime")
            if android is not None and android["checkout"] != str(checkout):
                raise Error("managed Android checkout changed")
            host.active(owner)
        elif args.action == "begin":
            task = native_uuid(args.task, "task-")
            route = host.route(workspace)
            owner = {"project": route["project"], "task": task, "session": session}
            host.active(owner, route=route)
            config = host.config(route)
            args.run_dir = str(run)
            lease = prepare(args, owner, managed_config=config,
                            android_runtime=host.android(route, checkout, config))
        else:
            raise Error("managed attempt not found")
        if args.action == "begin":
            result = validate_status(read(run / "status.json"), run)
            if result["phase"] != "finished":
                result = launch(lease, native=host.active, helper_env=host.helper_environment())
        elif args.action == "status":
            result = validate_status(read(run / "status.json"), run)
            if result["phase"] != "finished":
                result = check(run, native=host.active)
        else:
            result = finish(run, managed=True)
        phase, value = result["phase"], result.get("lease")
        output = {"attempt": attempt, "phase": phase}
        if isinstance(value, dict):
            output["lease"] = {key: value[key] for key in ("id", "generation", "owner", "state") if key in value}
            if phase == "active":
                lease_id, generation = value.get("id"), value.get("generation")
                if (not isinstance(lease_id, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", lease_id)
                        or type(generation) is not int or generation < 1):
                    raise Error("managed lease identity is unavailable")
                serial = value.get("endpoint", {}).get("adb_serial")
                if not isinstance(serial, str) or not re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", serial):
                    raise Error("managed endpoint is unavailable")
                output["endpoint"] = {"adb_serial": serial}
        return output


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="action", required=True)
    for name in ("run", "start"):
        command = commands.add_parser(name)
        command.add_argument("--config", required=True)
        command.add_argument("--profile", required=True)
        if name == "run":
            command.add_argument("--owner", required=True)
            command.add_argument("--env", action="append", default=[])
            command.add_argument("command", nargs=argparse.REMAINDER)
        else:
            for key in ("run-dir", "project", "task", "session"):
                command.add_argument(f"--{key}", required=True)
    for name in ("check", "finish", "_serve", "_serve-managed"):
        command = commands.add_parser(name)
        command.add_argument("--run-dir", required=True)
    for name in ("begin", "status", "end"):
        command = commands.add_parser(name)
        command.add_argument("--attempt", required=True)
        if name == "begin":
            command.add_argument("--task", required=True)
            command.add_argument("--profile", required=True)
    args = parser.parse_args()
    for number in (signal.SIGTERM, signal.SIGINT):
        signal.signal(number, interrupted)
    try:
        if args.action in {"begin", "status", "end"}:
            result = managed(args, HostRouting())
            print(json.dumps(result, sort_keys=True))
            return int(args.action == "end" and result["phase"] != "finished")
        if args.action == "_serve-managed":
            host = HostRouting(helper=True)
            run = canonical(args.run_dir)
            if run.parent != host.root:
                raise Error("invalid managed run")
            native_uuid(run.name)
            if not marked_managed(host.root):
                raise Error("unrecognized managed attempt")
            return serve(run, native=host.active)
        if args.action == "run":
            return run_command(args)
        if args.action == "_serve":
            return serve(args.run_dir)
        result = (start(args) if args.action == "start" else
                  check(args.run_dir) if args.action == "check" else finish(args.run_dir))
        print(json.dumps(result, sort_keys=True))
        return 1 if args.action == "finish" and result.get("phase") != "finished" else 0
    except (Error, OSError, ValueError, KeyError, TypeError) as error:
        if args.action in {"begin", "status", "end"}:
            print(json.dumps({"error": "attempt_pending" if isinstance(error, Busy)
                              else "managed_attempt_unresolved"}, sort_keys=True))
            return 1
        print(f"resource-lease-client: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
