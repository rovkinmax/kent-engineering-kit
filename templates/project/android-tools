#!/usr/bin/env python3
"""Project Android operations with explicit custody and separate evidence."""
from __future__ import annotations

import argparse
import dataclasses
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import types

PROTOCOL = 1
# Exact source bundle: verify and execute the same bytes before any dispatch.
BUNDLE_HASHES = {
    "android_tools_native.py": "97cad8d0fba456afcd31460fe862876fa762e2c486e6def10a2d5f83e43f0e1f",
    "android_tools_evidence.py": "1d5e7b63c27f972bb2757709a128e45226a7a7abdc0bb6cdbb24632771989d1d",
    "android_tools_custody.py": "a87de1b65ca5163e35c39709d6c01a76293a93f77faca8c90105d4bff62b8b59",
}
LIMIT = 262144


class Error(ValueError):
    pass


def load_bundle():
    modules = {}
    for filename, expected in BUNDLE_HASHES.items():
        path = Path(__file__).absolute().parent / filename
        if path.is_symlink() or not path.is_file():
            raise Error("bundle_incomplete")
        data = path.read_bytes()
        if len(data) > 1048576 or hashlib.sha256(data).hexdigest() != expected:
            raise Error("bundle_mismatch")
        modules[filename] = (path, data)
    loaded = {}
    for filename, (path, data) in modules.items():
        name = filename.removesuffix(".py")
        module = types.ModuleType(name)
        module.__file__ = str(path)
        sys.modules[name] = module
        exec(compile(data, str(path), "exec"), module.__dict__)
        if getattr(module, "BUNDLE_PROTOCOL", None) != PROTOCOL:
            raise Error("bundle_protocol_mismatch")
        if filename == "android_tools_custody.py" and getattr(module, "CUSTODY_API_VERSION", None) != 1:
            raise Error("custody_api_mismatch")
        loaded[name] = module
    return loaded


def private(path, directory=False):
    info = path.lstat()
    if (stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077
            or not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))):
        raise Error("private_binding_required")


def read_private(path):
    private(path)
    if path.stat().st_size > LIMIT:
        raise Error("binding_too_large")
    value = json.loads(path.read_bytes())
    if not isinstance(value, dict):
        raise Error("invalid_binding")
    return value


def configuration(path, *, docs_only=False):
    value = read_private(path)
    required = {"schema", "timeout_seconds", "output_limit_bytes", "providers"}
    storage = {"source_root", "records_directory", "lease"}
    if (not required <= set(value) or set(value) - required - storage - {"retention"}
            or (not docs_only and not storage <= set(value))
            or value["schema"] != PROTOCOL):
        raise Error("unsupported_configuration")
    if (type(value["timeout_seconds"]) not in (int, float)
            or not 0 < value["timeout_seconds"] <= 300
            or type(value["output_limit_bytes"]) is not int
            or not 4096 <= value["output_limit_bytes"] <= 8388608):
        raise Error("invalid_limits")
    providers = value["providers"]
    required_providers = {"google-android"} if docs_only else {"mobile-native", "google-android"}
    if (not isinstance(providers, dict) or not required_providers <= set(providers)
            or set(providers) - {"mobile-native", "google-android"}):
        raise Error("invalid_providers")
    for name in required_providers:
        provider = providers[name]
        if (not isinstance(provider, dict) or set(provider) != {"executable", "version"}
                or not isinstance(provider["executable"], str)
                or not Path(provider["executable"]).is_absolute()
                or not isinstance(provider["version"], str)):
            raise Error("invalid_provider")
    if docs_only:
        return value
    retention = value.get("retention", {"max_bytes": 500000000, "max_age_seconds": 604800})
    if (not isinstance(retention, dict)
            or set(retention) != {"max_bytes", "max_age_seconds"}
            or type(retention["max_bytes"]) is not int
            or not 1048576 <= retention["max_bytes"] <= 10000000000
            or type(retention["max_age_seconds"]) is not int
            or not 60 <= retention["max_age_seconds"] <= 31536000):
        raise Error("invalid_retention")
    value["retention"] = retention
    for key in ("source_root", "records_directory"):
        if not isinstance(value[key], str) or not Path(value[key]).is_absolute():
            raise Error("absolute_path_required")
    lease = value["lease"]
    if (not isinstance(lease, dict) or set(lease) != {
        "schema", "executable", "pool", "runs_directory", "profiles",
    } or lease["schema"] != 1):
        raise Error("invalid_lease_configuration")
    for key in ("executable", "pool", "runs_directory"):
        if not isinstance(lease[key], str) or not Path(lease[key]).is_absolute():
            raise Error("invalid_lease_configuration")
    if (not isinstance(lease["profiles"], dict)
            or not lease["profiles"]
            or any(not isinstance(k, str) or not isinstance(v, str) or not k or not v
                   for k, v in lease["profiles"].items())):
        raise Error("invalid_lease_configuration")
    return value


def custody(module, config, serial):
    try:
        with module.borrow_device(config.get("lease"), serial) as borrowed:
            return borrowed.check()
    except module.Error as error:
        raise Error(str(error)) from None


def handoff_uncertain(module):
    try:
        module.handoff_uncertain("native_runner_drain_unconfirmed")
    except module.Error as error:
        raise Error(str(error)) from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True)
    parser.add_argument("family", choices=("device", "preview", "docs", "evidence"))
    parser.add_argument("action")
    parser.add_argument("--arguments", default="{}", help="JSON operation arguments; never secrets")
    parser.add_argument("--binding-file", help="Private binding for explicit evidence export")
    parser.add_argument("--helper", help="Qualified project-memory executable for export")
    parser.add_argument("--interface", choices=("standalone", "workflow"), default="standalone")
    parser.add_argument("--include-artifacts", action="store_true")
    parser.add_argument("--record", action="store_true",
                        help="Record docs queries for explicit evidence export")
    args = parser.parse_args()
    if args.family == "docs" and args.action not in {"search", "fetch"}:
        raise Error("unsupported_operation")
    if args.record and args.family != "docs":
        raise Error("record_only_for_docs")
    docs_only = args.family == "docs" and not args.record
    config = configuration(Path(args.config), docs_only=docs_only)
    arguments = json.loads(args.arguments)
    if not isinstance(arguments, dict):
        raise Error("arguments_must_be_object")
    modules = load_bundle()
    if args.family == "evidence":
        if args.action != "export" or set(arguments) != {"invocation_id"}:
            raise Error("unsupported_evidence_operation")
        if not args.binding_file or not args.helper:
            raise Error("export_binding_required")
        evidence = modules["android_tools_evidence"]
        handle = evidence.open_run(Path(config["records_directory"]), arguments["invocation_id"])
        result = evidence.export_run(
            handle, read_private(Path(args.binding_file)), helper=Path(args.helper),
            interface=args.interface, include_artifacts=args.include_artifacts,
            **config["retention"],
        )
        print(json.dumps(dataclasses.asdict(result), sort_keys=True))
        return 0 if result.status == "exported" else 1
    operation = f"{args.family}.{args.action}"
    provider_id = "mobile-native" if args.family == "device" else "google-android"
    provider = config["providers"][provider_id]
    if docs_only:
        result = modules["android_tools_native"].execute_android_native(
            provider_id, operation, arguments,
            executable=Path(provider["executable"]), expected_version=provider["version"],
            timeout_s=config["timeout_seconds"], output_limit_bytes=config["output_limit_bytes"],
        )
        output = dataclasses.asdict(result)
        output["local_manifest"] = None
        print(json.dumps(output, sort_keys=True))
        return 0 if result.error is None else 1
    safe_context = {}
    if args.family == "device":
        if args.action == "capture" and arguments.pop("scene", None) != "known-safe":
            raise Error("capture_scene_unqualified")
        lease = custody(modules["android_tools_custody"], config, arguments.get("device_serial"))
        safe_context = {
            "lease_id": lease["id"], "generation": lease["generation"],
            "device_serial": arguments["device_serial"],
        }
    elif args.family == "preview":
        safe_context = {"target": arguments.get("target", "")}
    native = modules["android_tools_native"]
    evidence = modules["android_tools_evidence"]
    def before_tap():
        current = custody(modules["android_tools_custody"], config, arguments.get("device_serial"))
        if (current["id"], current["generation"]) != (lease["id"], lease["generation"]):
            raise Error("lease_lost")

    handle = evidence.begin_run(
        Path(config["records_directory"]), operation, provider_id, safe_context,
        **config["retention"],
        reservation_bytes=evidence.reservation_for_operation(
            operation, config["output_limit_bytes"],
        ),
    )
    try:
        result = native.execute_android_native(
            provider_id, operation, arguments,
            executable=Path(provider["executable"]), expected_version=provider["version"],
            timeout_s=config.get("timeout_seconds", 120),
            output_limit_bytes=config.get("output_limit_bytes", 1048576),
            source_root=Path(config["source_root"]),
            staging_dir=handle.staging_directory,
            **({"before_effect": before_tap} if operation == "device.tap"
               and {"text", "resource_id"} & set(arguments) else {}),
        )
        handoff = None
        if args.family == "device" and result.error == "drain_unknown":
            try:
                handoff_uncertain(modules["android_tools_custody"])
                handoff = "uncertainty_recorded"
            except (Error, OSError, KeyError):
                handoff = "handoff_unknown"
        if args.family == "device":
            try:
                custody(modules["android_tools_custody"], config, arguments.get("device_serial"))
            except (Error, ValueError, OSError, KeyError, subprocess.SubprocessError):
                if result.error != "drain_unknown":
                    result = dataclasses.replace(
                        result, transport="unknown",
                        effect="not_dispatched" if result.effect == "not_dispatched" else "unknown",
                        error="lease_lost",
                    )
        # Evidence is intentionally narrower than the useful interactive result.
        manifest = evidence.finish_run(handle, result)
    finally:
        evidence.release_run(handle)
    output = dataclasses.asdict(result)
    output["local_manifest"] = str(manifest)
    if handoff:
        output["lease_handoff"] = handoff
    print(json.dumps(output, sort_keys=True))
    return 0 if result.error is None else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Error as error:
        print(json.dumps({"error": str(error), "effect": "not_dispatched"}))
        raise SystemExit(1)
    except (ValueError, OSError, KeyError, subprocess.SubprocessError):
        print(json.dumps({"error": "android_tools_rejected", "effect": "unknown"}))
        raise SystemExit(1)
