#!/usr/bin/env python3
"""Project Android operations with explicit custody and separate evidence."""
from __future__ import annotations

import argparse
import dataclasses
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import types

PROTOCOL = 1
# Exact source bundle: verify and execute the same bytes before any dispatch.
BUNDLE_HASHES = {
    "android_tools_native.py": "fe693efb1d6981945e37613c54e801466a195034cd5f2277981d4ca173dcab2e",
    "android_tools_evidence.py": "2f7cf4334f0b31a279d246922e56da6595619d3e7fcc70daf91157d6ef637dae",
    "android_tools_custody.py": "f705c1d39f693844dd208fb68c504e0627c3797e0b69a55a6162e613328c839f",
}
LIMIT = 262144
MAX_BUNDLE_FILE_BYTES = 1048576
MAX_QUALIFICATION_BYTES = 65536
BUNDLE_CONTRACTS = {
    "custody_api": 1,
    "custody_marker": 1,
    "device_launch": 1,
    "native_result": 1,
    "run_manifest": "android-tools-run-v1",
}


class Error(ValueError):
    pass


class LoadedBundle:
    """Loaded modules and metadata from the exact bytes verified by the loader."""

    def __init__(self, modules, files):
        self.modules = modules
        self.files = files

    def __getitem__(self, name):
        return self.modules[name]

    def __iter__(self):
        return iter(self.modules)

    def __len__(self):
        return len(self.modules)


def _file_identity(info):
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def _read_stable_file(path, *, limit=MAX_BUNDLE_FILE_BYTES):
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_NONBLOCK", 0)
    )
    try:
        descriptor = os.open(path, flags)
    except FileNotFoundError as error:
        raise Error("bundle_incomplete") from error
    except OSError as error:
        raise Error("bundle_unreadable") from error
    try:
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != os.getuid()
                or before.st_nlink != 1
                or before.st_mode & 0o022
                or before.st_size <= 0
                or before.st_size > limit
            ):
                raise Error("bundle_unsafe")
            chunks = []
            size = 0
            while True:
                block = os.read(descriptor, min(65536, limit + 1 - size))
                if not block:
                    break
                chunks.append(block)
                size += len(block)
                if size > limit:
                    raise Error("bundle_size_limit")
            after = os.fstat(descriptor)
            current = os.stat(path, follow_symlinks=False)
        except Error:
            raise
        except OSError as error:
            raise Error("bundle_unstable") from error
        raw = b"".join(chunks)
        if (
            _file_identity(before) != _file_identity(after)
            or _file_identity(after) != _file_identity(current)
            or size != after.st_size
        ):
            raise Error("bundle_unstable")
        return raw, {
            "path": str(path),
            "size_bytes": size,
            "sha256": hashlib.sha256(raw).hexdigest(),
            "mode": stat.S_IMODE(after.st_mode),
        }
    finally:
        os.close(descriptor)


def load_bundle():
    modules = {}
    files = {}
    directory = Path(__file__).absolute().parent
    for filename, expected in BUNDLE_HASHES.items():
        path = directory / filename
        data, metadata = _read_stable_file(path)
        if metadata["sha256"] != expected:
            raise Error("bundle_mismatch")
        files[filename] = metadata
        modules[filename] = (path, data)
    loaded = {}
    for filename, (path, data) in modules.items():
        name = filename.removesuffix(".py")
        module = types.ModuleType(name)
        module.__file__ = str(path)
        sys.modules[name] = module
        exec(compile(data, str(path), "exec"), module.__dict__)
        if getattr(module, "BUNDLE_PROTOCOL", None) != PROTOCOL:
            raise Error("bundle_protocol_mismatch")
        if filename == "android_tools_custody.py" and getattr(module, "CUSTODY_API_VERSION", None) != 1:
            raise Error("custody_api_mismatch")
        loaded[name] = module
    return LoadedBundle(loaded, files)


def qualify_bundle():
    bundle = load_bundle()
    launcher = Path(__file__).absolute()
    _launcher_bytes, launcher_metadata = _read_stable_file(launcher)
    if launcher.resolve(strict=True) != launcher:
        raise Error("bundle_entrypoint_not_canonical")
    custody = bundle["android_tools_custody"]
    if getattr(custody, "CUSTODY_API_VERSION", None) != 1:
        raise Error("custody_api_mismatch")
    if getattr(custody, "CUSTODY_MARKER_PROTOCOL", None) != 1:
        raise Error("custody_marker_mismatch")
    bundle_hashes = {
        filename: bundle.files[filename]["sha256"]
        for filename in sorted(BUNDLE_HASHES)
    }
    identity = {
        "launcher_sha256": launcher_metadata["sha256"],
        "bundle_sha256s": bundle_hashes,
    }
    canonical = json.dumps(
        identity, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
    ).encode("utf-8")
    result = {
        "schema": "android-tools-bundle-qualification-v1",
        "installation_id": hashlib.sha256(canonical).hexdigest(),
        "contracts": dict(BUNDLE_CONTRACTS),
        "custody": {
            "path": bundle.files["android_tools_custody.py"]["path"],
            "size_bytes": bundle.files["android_tools_custody.py"]["size_bytes"],
            "sha256": bundle.files["android_tools_custody.py"]["sha256"],
        },
    }
    emitted = json.dumps(result, sort_keys=True).encode("utf-8") + b"\n"
    if len(emitted) > MAX_QUALIFICATION_BYTES:
        raise Error("qualification_size_limit")
    return result


def private(path, directory=False):
    info = path.lstat()
    if (stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077
            or not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))):
        raise Error("private_binding_required")


def read_private(path):
    private(path)
    if path.stat().st_size > LIMIT:
        raise Error("binding_too_large")
    value = json.loads(path.read_bytes())
    if not isinstance(value, dict):
        raise Error("invalid_binding")
    return value


def configuration(path, *, docs_only=False):
    return validate_configuration(read_private(path), docs_only=docs_only)


def validate_configuration(value, *, docs_only=False, managed=False):
    required = {"schema", "timeout_seconds", "output_limit_bytes", "providers"}
    storage = {"source_root", "records_directory", "lease"}
    if (not required <= set(value) or set(value) - required - storage - {"retention"}
            or (not docs_only and not storage <= set(value))
            or value["schema"] != PROTOCOL):
        raise Error("unsupported_configuration")
    if (type(value["timeout_seconds"]) not in (int, float)
            or not 0 < value["timeout_seconds"] <= 300
            or type(value["output_limit_bytes"]) is not int
            or not 4096 <= value["output_limit_bytes"] <= 8388608):
        raise Error("invalid_limits")
    providers = value["providers"]
    required_providers = ({"mobile-native"} if managed else {"google-android"}
                          if docs_only else {"mobile-native", "google-android"})
    if (not isinstance(providers, dict) or not required_providers <= set(providers)
            or set(providers) - {"mobile-native", "google-android"}):
        raise Error("invalid_providers")
    for name in required_providers:
        provider = providers[name]
        if (not isinstance(provider, dict) or set(provider) != {"executable", "version"}
                or not isinstance(provider["executable"], str)
                or not Path(provider["executable"]).is_absolute()
                or not isinstance(provider["version"], str)):
            raise Error("invalid_provider")
    if docs_only:
        return value
    retention = value.get("retention", {"max_bytes": 500000000, "max_age_seconds": 604800})
    if (not isinstance(retention, dict)
            or set(retention) != {"max_bytes", "max_age_seconds"}
            or type(retention["max_bytes"]) is not int
            or not 1048576 <= retention["max_bytes"] <= 10000000000
            or type(retention["max_age_seconds"]) is not int
            or not 60 <= retention["max_age_seconds"] <= 31536000):
        raise Error("invalid_retention")
    value["retention"] = retention
    for key in ("source_root", "records_directory"):
        if not isinstance(value[key], str) or not Path(value[key]).is_absolute():
            raise Error("absolute_path_required")
    lease = value["lease"]
    if (not isinstance(lease, dict) or set(lease) != {
        "schema", "executable", "pool", "runs_directory", "profiles",
    } or lease["schema"] != 1):
        raise Error("invalid_lease_configuration")
    for key in ("executable", "pool", "runs_directory"):
        if not isinstance(lease[key], str) or not Path(lease[key]).is_absolute():
            raise Error("invalid_lease_configuration")
    if (not isinstance(lease["profiles"], dict)
            or not lease["profiles"]
            or any(not isinstance(k, str) or not isinstance(v, str) or not k or not v
                   for k, v in lease["profiles"].items())):
        raise Error("invalid_lease_configuration")
    return value


def custody(module, config, serial):
    try:
        with module.borrow_device(config.get("lease"), serial) as borrowed:
            return borrowed.check()
    except module.Error as error:
        raise Error(str(error)) from None


def handoff_uncertain(module):
    try:
        module.handoff_uncertain("native_runner_drain_unconfirmed")
    except module.Error as error:
        raise Error(str(error)) from None


def _first_positional_argument(argv):
    options_with_values = {
        "--arguments", "--attempt", "--binding-file", "--config", "--helper", "--interface",
    }
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--":
            return argv[index + 1] if index + 1 < len(argv) else None
        option = token.split("=", 1)[0]
        if option in options_with_values:
            index += 1 if "=" in token else 2
        elif token.startswith("-"):
            index += 1
        else:
            return token
    return None


def main():
    argv = sys.argv[1:]
    if _first_positional_argument(argv) == "bundle":
        if argv != ["bundle", "qualify"]:
            raise Error("bundle_qualification_arguments_rejected")
        print(json.dumps(qualify_bundle(), sort_keys=True))
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    selector = parser.add_mutually_exclusive_group(required=True)
    selector.add_argument("--config")
    selector.add_argument("--attempt")
    parser.add_argument("family", choices=("device", "preview", "docs", "evidence"))
    parser.add_argument("action")
    parser.add_argument(
        "--arguments",
        default="{}",
        help="JSON operation arguments passed to the configured provider process",
    )
    parser.add_argument("--binding-file", help="Private binding for explicit evidence export")
    parser.add_argument("--helper", help="Qualified project-memory executable for export")
    parser.add_argument("--interface", choices=("standalone", "workflow"))
    parser.add_argument("--include-artifacts", action="store_true")
    parser.add_argument("--record", action="store_true",
                        help="Record docs queries for explicit evidence export")
    args = parser.parse_args()
    if args.family == "docs" and args.action not in {"search", "fetch"}:
        raise Error("unsupported_operation")
    if args.record and args.family != "docs":
        raise Error("record_only_for_docs")
    docs_only = args.family == "docs" and not args.record
    config = configuration(Path(args.config), docs_only=docs_only) if args.config is not None else None
    arguments = json.loads(args.arguments)
    if not isinstance(arguments, dict):
        raise Error("arguments_must_be_object")
    modules = load_bundle()
    borrowed = None
    device_environment = None
    if args.attempt is not None:
        if (args.family != "device" or "device_serial" in arguments
                or args.binding_file is not None or args.helper is not None
                or args.interface is not None or args.include_artifacts):
            raise Error("managed_device_arguments_rejected")
        try:
            config, borrowed, device_environment = modules["android_tools_custody"].managed_device(
                args.attempt, Path(__file__).absolute(),
            )
        except (ValueError, OSError, KeyError, TypeError, subprocess.SubprocessError):
            raise Error("managed_device_unavailable") from None
        config = validate_configuration(config, managed=True)
        arguments["device_serial"] = borrowed.serial

    if args.family == "evidence":
        if args.action != "export" or set(arguments) != {"invocation_id"}:
            raise Error("unsupported_evidence_operation")
        if not args.binding_file or not args.helper:
            raise Error("export_binding_required")
        evidence = modules["android_tools_evidence"]
        handle = evidence.open_run(Path(config["records_directory"]), arguments["invocation_id"])
        result = evidence.export_run(
            handle, read_private(Path(args.binding_file)), helper=Path(args.helper),
            interface=args.interface or "standalone", include_artifacts=args.include_artifacts,
            **config["retention"],
        )
        print(json.dumps(dataclasses.asdict(result), sort_keys=True))
        return 0 if result.status == "exported" else 1
    operation = f"{args.family}.{args.action}"
    provider_id = "mobile-native" if args.family == "device" else "google-android"
    provider = config["providers"][provider_id]
    if docs_only:
        result = modules["android_tools_native"].execute_android_native(
            provider_id, operation, arguments,
            executable=Path(provider["executable"]), expected_version=provider["version"],
            timeout_s=config["timeout_seconds"], output_limit_bytes=config["output_limit_bytes"],
        )
        output = dataclasses.asdict(result)
        output["local_manifest"] = None
        print(json.dumps(output, sort_keys=True))
        return 0 if result.error is None else 1
    safe_context = {}

    def check_device():
        if borrowed is None:
            return custody(modules["android_tools_custody"], config, arguments.get("device_serial"))
        try:
            return borrowed.check()
        except (ValueError, OSError, KeyError, subprocess.SubprocessError):
            raise Error("managed_device_unavailable") from None

    if args.family == "device":
        if args.action == "capture" and arguments.pop("scene", None) != "known-safe":
            raise Error("capture_scene_unqualified")
        lease = check_device()
        safe_context = {
            "lease_id": lease["id"], "generation": lease["generation"],
            "device_serial": arguments["device_serial"],
        }
        if borrowed is not None:
            safe_context["attempt_id"] = args.attempt
    elif args.family == "preview":
        safe_context = {"target": arguments.get("target", "")}
    native = modules["android_tools_native"]
    evidence = modules["android_tools_evidence"]
    def before_effect():
        current = check_device()
        if (current["id"], current["generation"]) != (lease["id"], lease["generation"]):
            raise Error("lease_lost")

    guarded = (borrowed is not None or operation == "device.input"
               or operation == "device.tap" and bool({"text", "resource_id"} & arguments.keys()))
    dispatch_options = {"before_effect": before_effect} if guarded else {}
    if borrowed is not None:
        dispatch_options["device_environment"] = device_environment

    try:
        reservation = evidence.reservation_for_operation(
            operation, config["output_limit_bytes"],
        )
        handle = evidence.begin_run(
            Path(config["records_directory"]), operation, provider_id, safe_context,
            **config["retention"], reservation_bytes=reservation,
        )
    except (ValueError, OSError):
        if operation == "device.input":
            raise Error("android_tools_rejected") from None
        raise
    try:
        if borrowed is not None:
            try:
                borrowed.begin_remote_execution()
            except (ValueError, OSError, KeyError, subprocess.SubprocessError):
                raise Error("managed_device_dispatch_blocked") from None
        result = native.execute_android_native(
            provider_id, operation, arguments,
            executable=Path(provider["executable"]), expected_version=provider["version"],
            timeout_s=config.get("timeout_seconds", 120),
            output_limit_bytes=config.get("output_limit_bytes", 1048576),
            source_root=Path(config["source_root"]),
            staging_dir=handle.staging_directory,
            **dispatch_options,
        )
        handoff = None
        if args.family == "device" and result.error == "drain_unknown":
            try:
                if borrowed is None:
                    handoff_uncertain(modules["android_tools_custody"])
                else:
                    borrowed.handoff_uncertain("native_runner_drain_unconfirmed")
                handoff = "uncertainty_recorded"
            except (ValueError, OSError, KeyError):
                handoff = "handoff_unknown"
        if args.family == "device":
            try:
                if borrowed is not None and result.error != "drain_unknown":
                    borrowed.confirm_remote_stopped()
                check_device()
            except (Error, ValueError, OSError, KeyError, subprocess.SubprocessError):
                if result.error != "drain_unknown":
                    result = dataclasses.replace(
                        result, transport="unknown",
                        effect="not_dispatched" if result.effect == "not_dispatched" else "unknown",
                        error="lease_lost",
                    )
        # Evidence is intentionally narrower than the useful interactive result.
        manifest = evidence.finish_run(handle, result)
    finally:
        evidence.release_run(handle)
    output = dataclasses.asdict(result)
    if borrowed is None:
        output["local_manifest"] = str(manifest)
    else:
        # Managed artifacts are retained under this invocation, not public
        # provider paths. Evidence already persisted the original descriptors.
        for artifact in output["artifacts"]:
            artifact.pop("path", None)
        output["invocation_id"] = handle.invocation_id
    if handoff:
        output["lease_handoff"] = handoff
    print(json.dumps(output, sort_keys=True))
    return 0 if result.error is None else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Error as error:
        print(json.dumps({"error": str(error), "effect": "not_dispatched"}))
        raise SystemExit(1)
    except (ValueError, OSError, KeyError, subprocess.SubprocessError):
        print(json.dumps({"error": "android_tools_rejected", "effect": "unknown"}))
        raise SystemExit(1)
