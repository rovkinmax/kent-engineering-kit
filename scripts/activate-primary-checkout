#!/usr/bin/env python3
"""Preview or perform the separately governed primary-checkout activation."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from workflowkit.operations import (
    OperationError,
    activate_primary_checkout,
    load_plan,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("mode", choices=("preview", "apply", "rollback"))
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--expect-plan-sha256", required=True)
    parser.add_argument("--confirm")
    args = parser.parse_args()
    try:
        plan = load_plan(
            args.plan,
            schema="kit-primary-activation-plan-v1",
            expected_sha256=args.expect_plan_sha256,
            mutation=args.mode in {"apply", "rollback"},
            confirm=args.confirm,
        )
        report = activate_primary_checkout(
            plan, mode=args.mode, confirm=args.confirm
        )
    except (OperationError, OSError) as error:
        print(f"activate-primary-checkout: {error}", file=sys.stderr)
        return 1
    print(json.dumps(report, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
