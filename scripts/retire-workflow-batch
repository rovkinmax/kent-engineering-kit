#!/usr/bin/env python3
"""Preview, apply, or resume a closed Workflow retirement batch."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from workflowkit.operations import OperationError, load_plan, retire_workflow_batch


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("mode", choices=("preview", "apply", "resume"))
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--expect-plan-sha256", required=True)
    parser.add_argument("--confirm")
    parser.add_argument("--kent", required=True)
    args = parser.parse_args()
    if not Path(args.kent).is_absolute():
        parser.error("--kent must be an absolute path")
    try:
        plan = load_plan(
            args.plan,
            schema="workflow-retirement-batch-plan-v1",
            expected_sha256=args.expect_plan_sha256,
            mutation=args.mode in {"apply", "resume"},
            confirm=args.confirm,
        )
        report = retire_workflow_batch(plan, mode=args.mode, kent=args.kent)
    except (OperationError, OSError) as error:
        print(f"retire-workflow-batch: {error}", file=sys.stderr)
        return 1
    print(json.dumps(report, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
