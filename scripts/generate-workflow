#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from workflowkit import (
    KentClient,
    ProjectProfile,
    build_canary_workflow,
    build_delivery_workflow,
    build_smoke_lab_workflow,
)
from workflowkit.kent import (
    CanonicalWorkflowCompatibilityPlan,
    KentCommandError,
    spec_as_json,
)
from workflowkit.model import SpecError
from workflowkit.naming import snapshot_filename


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate a versioned Kent workflow from a project profile."
    )
    parser.add_argument(
        "--project",
        required=True,
        type=Path,
        help="Project repository root containing .kent/workflow-profile.toml.",
    )
    parser.add_argument(
        "--kind",
        choices=("delivery", "canary", "smoke-lab"),
        default="delivery",
        help="Workflow kind to generate.",
    )
    parser.add_argument(
        "--version",
        type=int,
        help="Positive generated workflow version; omitted for smoke-lab.",
    )
    parser.add_argument(
        "--label",
        default="",
        help="Free-form experimental suffix for smoke-lab rollover.",
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Create/update, link, validate, and export the workflow.",
    )
    parser.add_argument(
        "--set-default",
        action="store_true",
        help="Set the generated workflow as project default. Requires --apply.",
    )
    parser.add_argument(
        "--workflow-id",
        default="",
        help=(
            "Update one explicit existing workflow UUID even when its legacy "
            "display name differs from the generated name."
        ),
    )
    parser.add_argument(
        "--compatibility-plan",
        type=Path,
        help="Delegate an existing UUID-bound semantic update to the canonical v2 effect owner.",
    )
    parser.add_argument(
        "--compatibility-plan-sha256",
        default="",
        help="Expected exact SHA-256 of the canonical v2 compatibility plan.",
    )
    parser.add_argument(
        "--confirm-compatibility-plan",
        default="",
        help="Repeat the exact compatibility-plan SHA-256 to authorize its application.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.set_default and not args.apply:
        raise SpecError("--set-default requires --apply")
    compatibility_values = (
        args.compatibility_plan,
        args.compatibility_plan_sha256,
        args.confirm_compatibility_plan,
    )
    if any(compatibility_values) and not all(compatibility_values):
        raise SpecError(
            "compatibility-plan application requires --compatibility-plan, "
            "--compatibility-plan-sha256, and --confirm-compatibility-plan"
        )
    if args.compatibility_plan is not None:
        if not args.apply:
            raise SpecError("--compatibility-plan requires --apply")
        if not args.workflow_id.strip():
            raise SpecError("--compatibility-plan requires an explicit --workflow-id UUID")
        if args.set_default:
            raise SpecError("--compatibility-plan cannot set a project default")
    if args.kind == "smoke-lab":
        if args.version is not None:
            raise SpecError("--version is not used with smoke-lab")
    elif args.version is None:
        raise SpecError(f"--version is required with {args.kind}")
    elif args.label.strip():
        raise SpecError("--label is supported only with smoke-lab")

    profile = ProjectProfile.load(args.project)
    if args.kind == "smoke-lab":
        spec = build_smoke_lab_workflow(profile, label=args.label)
    else:
        builders = {
            "delivery": build_delivery_workflow,
            "canary": build_canary_workflow,
        }
        spec = builders[args.kind](profile, args.version)

    if not args.apply:
        print(json.dumps(spec_as_json(spec), indent=2, ensure_ascii=False))
        return 0

    client = KentClient(profile.project_root)
    compatibility_plan = (
        CanonicalWorkflowCompatibilityPlan(
            path=args.compatibility_plan,
            expected_sha256=args.compatibility_plan_sha256,
            confirmation_sha256=args.confirm_compatibility_plan,
        )
        if args.compatibility_plan is not None
        else None
    )
    definition = client.apply(
        spec,
        minimum_version=profile.minimum_version_tuple(),
        set_default=args.set_default,
        workflow_selector=args.workflow_id.strip() or None,
        compatibility_plan=compatibility_plan,
    )
    if compatibility_plan is not None:
        print(json.dumps(definition, indent=2, ensure_ascii=False))
        return 0
    snapshot_name = snapshot_filename(
        definition["workflow"]["name"],
        disambiguate=bool(args.label.strip()),
    )
    snapshot_path = profile.project_root / ".kent" / "workflows" / snapshot_name
    client.export_snapshot(definition, snapshot_path)
    print(
        json.dumps(
            {
                "workflow_id": definition["workflow"]["id"],
                "workflow_name": definition["workflow"]["name"],
                "workflow_kind": args.kind,
                "execution_target": spec.execution_target,
                "snapshot": str(snapshot_path),
                "project_workspace": str(client.project_workspace),
                "default_changed": args.set_default,
                "static_validation": "passed",
                "managed_worktree_canary_required": True,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KentCommandError, SpecError) as error:
        print(f"generate-workflow: {error}", file=sys.stderr)
        raise SystemExit(1)
