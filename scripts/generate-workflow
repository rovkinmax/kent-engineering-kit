#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import sys


REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from workflowkit import KentClient, ProjectProfile, build_delivery_workflow
from workflowkit.kent import KentCommandError, spec_as_json
from workflowkit.model import SpecError


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate a versioned Kent workflow from a project profile."
    )
    parser.add_argument(
        "--project",
        required=True,
        type=Path,
        help="Project repository root containing .kent/workflow-profile.toml.",
    )
    parser.add_argument(
        "--kind",
        choices=("delivery",),
        default="delivery",
        help="Workflow kind to generate.",
    )
    parser.add_argument(
        "--version",
        required=True,
        type=int,
        help="Positive generated workflow version.",
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="Create/update, link, validate, and export the workflow.",
    )
    parser.add_argument(
        "--set-default",
        action="store_true",
        help="Set the generated workflow as project default. Requires --apply.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.set_default and not args.apply:
        raise SpecError("--set-default requires --apply")

    profile = ProjectProfile.load(args.project)
    spec = build_delivery_workflow(profile, args.version)

    if not args.apply:
        print(json.dumps(spec_as_json(spec), indent=2, ensure_ascii=False))
        return 0

    client = KentClient(profile.project_root)
    definition = client.apply(
        spec,
        minimum_version=profile.minimum_version_tuple(),
        set_default=args.set_default,
    )
    snapshot_name = slugify(spec.name) + ".json"
    snapshot_path = profile.project_root / ".kent" / "workflows" / snapshot_name
    client.export_snapshot(definition, snapshot_path)
    print(
        json.dumps(
            {
                "workflow_id": definition["workflow"]["id"],
                "workflow_name": spec.name,
                "execution_target": spec.execution_target,
                "snapshot": str(snapshot_path),
                "default_changed": args.set_default,
                "static_validation": "passed",
                "managed_worktree_canary_required": True,
            },
            indent=2,
            ensure_ascii=False,
        )
    )
    return 0


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    if not slug:
        raise SpecError(f"cannot derive snapshot name from {value!r}")
    return slug


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KentCommandError, SpecError) as error:
        print(f"generate-workflow: {error}", file=sys.stderr)
        raise SystemExit(1)
