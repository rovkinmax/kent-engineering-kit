#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
installed_state=0
if [[ "${1:-}" == "--installed-state" ]]; then
  installed_state=1
  shift
fi
if [[ $# -ne 0 ]]; then
  echo "usage: scripts/validate [--installed-state]" >&2
  exit 2
fi
kent_root="${KENT_PERSISTENCE_ROOT:-$HOME/.kent}"

bash -n "$repo_root/scripts/install"
bash -n "$repo_root/scripts/audit-mobile-schema"
bash -n "$repo_root/scripts/configure-mcporter"
bash -n "$repo_root/scripts/kent-worktree"
bash -n "$repo_root/scripts/preflight-revision"
bash -n "$repo_root/templates/project/workflow-prepare-github-ci"
bash -n "$repo_root/scripts/resolve-github-merge-strategy"
bash -n "$repo_root/adapters/mcp/kent-mcp-call"
bash -n "$repo_root/adapters/mcp/kent-mcp-list"
bash -n "$repo_root/adapters/mcp/mcp-common.sh"
bash -n "$repo_root/adapters/gradle/shell-postprocess-hook"
bash -n "$repo_root/templates/project/emulator-resource-lock.sh"
bash -n "$repo_root/templates/project/jira-api.sh"
bash -n "$repo_root/templates/project/mobile-evidence-audit.sh"
bash -n "$repo_root/templates/project/sentry-issues.sh"
bash -n "$repo_root/templates/project/workflow-plan-contract-accept"
bash -n "$repo_root/templates/project/workflow-plan-contract-continue"
bash -n "$repo_root/templates/project/workflow-plan-contract-fix-continue"
bash -n "$repo_root/templates/project/workflow-plan-contract-verify"
python3 -m py_compile \
  "$repo_root/templates/project/android-tools" \
  "$repo_root/templates/project/android_tools_native.py" \
  "$repo_root/templates/project/android_tools_evidence.py" \
  "$repo_root/workflowkit/ci_contract.py" \
  "$repo_root/workflowkit/kit_runtime.py" \
  "$repo_root/workflowkit/delivery.py" \
  "$repo_root/workflowkit/profile.py" \
  "$repo_root/workflowkit/revision.py" \
  "$repo_root/workflowkit/runtime.py" \
  "$repo_root/scripts/prepare-github-ci" \
  "$repo_root/workflowkit/operations.py" \
  "$repo_root/scripts/activate-primary-checkout" \
  "$repo_root/scripts/reconcile-canonical-workflows" \
  "$repo_root/templates/project/android-apk-install-preserve" \
  "$repo_root/templates/project/workflow-branch-identity" \
  "$repo_root/templates/project/workflow-checkpoint" \
  "$repo_root/templates/project/workflow-evidence-ledger" \
  "$repo_root/templates/project/workflow-verify-report" \
  "$repo_root/templates/project/workflow-plan-contract" \
  "$repo_root/templates/project/workflow-verification-dispatch" \
  "$repo_root/templates/project/workflow-wait-github-ci" \
  "$repo_root/templates/project/workflow-wait-github-pr" \
  "$repo_root/templates/project/workflow-task-janitor"
install_help_root="$(mktemp -d)"
KENT_PERSISTENCE_ROOT="$install_help_root" \
  "$repo_root/scripts/install" --help >/dev/null
if find "$install_help_root" -mindepth 1 -print -quit | grep -q .; then
  echo "install --help must not mutate the target root" >&2
  exit 1
fi
rmdir "$install_help_root"

[[ -x "$repo_root/adapters/gradle/shell-postprocess-hook" ]] || {
  echo "Gradle shell postprocessor is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-verification-dispatch" ]] || {
  echo "verification dispatch template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-verify-report" ]] || {
  echo "verification report template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-checkpoint" ]] || {
  echo "workflow checkpoint template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-evidence-ledger" ]] || {
  echo "workflow evidence-ledger template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-plan-contract" ]] || {
  echo "workflow plan-contract template is not executable" >&2
  exit 1
}
for plan_contract_wrapper in \
  workflow-plan-contract-accept \
  workflow-plan-contract-continue \
  workflow-plan-contract-fix-continue \
  workflow-plan-contract-verify; do
  [[ -x "$repo_root/templates/project/$plan_contract_wrapper" ]] || {
    echo "$plan_contract_wrapper template is not executable" >&2
    exit 1
  }
done
[[ -x "$repo_root/templates/project/android-apk-install-preserve" ]] || {
  echo "Android APK preservation installer template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-wait-github-ci" ]] || {
  echo "GitHub CI watcher template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-prepare-github-ci" ]] || {
  echo "GitHub CI preparation template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/prepare-github-ci" ]] || {
  echo "GitHub CI preparation CLI is not executable" >&2
  exit 1
}
ruby -ryaml -rjson -e 'exit 0' >/dev/null
git --no-replace-objects --no-lazy-fetch --version >/dev/null
[[ -x "$repo_root/templates/project/workflow-branch-identity" ]] || {
  echo "workflow branch-identity template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-wait-github-pr" ]] || {
  echo "GitHub PR watcher template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/workflow-task-janitor" ]] || {
  echo "task janitor template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/emulator-resource-lock.sh" ]] || {
  echo "mobile resource-lock template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/jira-api.sh" ]] || {
  echo "Jira API template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/mobile-evidence-audit.sh" ]] || {
  echo "mobile evidence-audit template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/templates/project/sentry-issues.sh" ]] || {
  echo "Sentry issues template is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/generate-workflow" ]] || {
  echo "workflow generator is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/sync-project-adapters" ]] || {
  echo "project adapter synchronizer is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/preflight-revision" ]] || {
  echo "revision preflight is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/resolve-github-merge-strategy" ]] || {
  echo "GitHub merge-strategy resolver is not executable" >&2
  exit 1
}
for operations_script in \
  activate-primary-checkout \
  reconcile-canonical-workflows; do
  [[ -x "$repo_root/scripts/$operations_script" ]] || {
    echo "$operations_script is not executable" >&2
    exit 1
  }
done
[[ -x "$repo_root/scripts/configure-mcporter" ]] || {
  echo "mcporter configurator is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/audit-mobile-schema" ]] || {
  echo "mobile schema auditor is not executable" >&2
  exit 1
}
[[ -x "$repo_root/scripts/kent-worktree" ]] || {
  echo "Kent worktree wrapper is not executable" >&2
  exit 1
}
[[ -x "$repo_root/adapters/mcp/kent-mcp-call" ]] || {
  echo "MCP call adapter is not executable" >&2
  exit 1
}
[[ -x "$repo_root/adapters/mcp/kent-mcp-list" ]] || {
  echo "MCP list adapter is not executable" >&2
  exit 1
}

if grep -R -n -E '^[[:space:]]*(model|tools)[[:space:]]*:' \
  "$repo_root/agents"/*.md; then
  echo "global role prompts must not declare model or tools" >&2
  exit 1
fi

python3 - \
  "$repo_root/config/subagents.toml" \
  "$repo_root" <<'PY'
import pathlib
import sys
import tomllib

config = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())
repo_root = pathlib.Path(sys.argv[2])
configured = set()

for role, values in config.get("subagents", {}).items():
    if not isinstance(values, dict):
        continue
    tools = values.get("tools", {})
    if (
        isinstance(tools, dict)
        and tools.get("patch") is True
        and tools.get("edit") is True
    ):
        raise AssertionError(
            f"{role}: tools.patch and tools.edit cannot both be enabled"
        )
    prompt = values.get("system_prompt_file")
    if prompt is None:
        continue
    path = repo_root / prompt
    if not path.is_file():
        raise AssertionError(f"{role}: missing system prompt {path}")
    configured.add(path.resolve())

available = {path.resolve() for path in (repo_root / "agents").glob("*.md")}
if configured != available:
    missing = sorted(str(path) for path in available - configured)
    foreign = sorted(str(path) for path in configured - available)
    raise AssertionError(
        f"agent/config mismatch: unconfigured={missing}, foreign={foreign}"
    )
PY

names_file="$(mktemp)"
trap 'rm -f "$names_file"' EXIT

for skill_file in "$repo_root"/skills/*/SKILL.md; do
  name="$(sed -n 's/^name: //p' "$skill_file" | head -1)"
  description="$(sed -n 's/^description: //p' "$skill_file" | head -1)"

  [[ -n "$name" ]] || {
    echo "missing skill name: $skill_file" >&2
    exit 1
  }
  [[ -n "$description" ]] || {
    echo "missing skill description: $skill_file" >&2
    exit 1
  }
  if grep -Fqx "$name" "$names_file"; then
    echo "duplicate skill name: $name" >&2
    exit 1
  fi
  echo "$name" >>"$names_file"
done

if [[ "$installed_state" -eq 1 ]]; then
for target in \
  "$kent_root/AGENTS.md" \
  "$kent_root/bin/kent-mcp-call" \
  "$kent_root/bin/kent-mcp-list" \
  "$kent_root/bin/kent-preflight-revision" \
  "$kent_root/bin/kent-resolve-github-merge-strategy" \
  "$kent_root/bin/kent-worktree" \
  "$kent_root/hooks/gradle-worktree-warning" \
  "$kent_root/skills/kent-engineering-kit" \
  "$kent_root/prompts/grill.md"; do
  [[ -e "$target" ]] || {
    echo "missing installed target: $target" >&2
    exit 1
  }
done

[[ -L "$kent_root/bin/kent-worktree" ]] || {
  echo "installed Kent worktree wrapper is not a managed symlink" >&2
  exit 1
}
[[ -L "$kent_root/bin/kent-preflight-revision" ]] || {
  echo "installed revision preflight is not a managed symlink" >&2
  exit 1
}
[[ -L "$kent_root/bin/kent-resolve-github-merge-strategy" ]] || {
  echo "installed merge-strategy resolver is not a managed symlink" >&2
  exit 1
}
[[ -L "$kent_root/bin/kent-mcp-call" ]] || {
  echo "installed MCP call adapter is not a managed symlink" >&2
  exit 1
}
[[ -L "$kent_root/bin/kent-mcp-list" ]] || {
  echo "installed MCP list adapter is not a managed symlink" >&2
  exit 1
}
[[ "$(readlink "$kent_root/bin/kent-preflight-revision")" == \
  "$repo_root/scripts/preflight-revision" ]] || {
  echo "installed revision preflight points outside this toolkit" >&2
  exit 1
}
[[ "$(readlink "$kent_root/bin/kent-resolve-github-merge-strategy")" == \
  "$repo_root/scripts/resolve-github-merge-strategy" ]] || {
  echo "installed merge-strategy resolver points outside this toolkit" >&2
  exit 1
}
[[ "$(readlink "$kent_root/bin/kent-worktree")" == \
  "$repo_root/scripts/kent-worktree" ]] || {
  echo "installed Kent worktree wrapper points outside this toolkit" >&2
  exit 1
}
[[ "$(readlink "$kent_root/bin/kent-mcp-call")" == \
  "$repo_root/adapters/mcp/kent-mcp-call" ]] || {
  echo "installed MCP call adapter points outside this toolkit" >&2
  exit 1
}
[[ "$(readlink "$kent_root/bin/kent-mcp-list")" == \
  "$repo_root/adapters/mcp/kent-mcp-list" ]] || {
  echo "installed MCP list adapter points outside this toolkit" >&2
  exit 1
}

for agent_file in "$repo_root"/agents/*.md; do
  target="$kent_root/agents/$(basename "$agent_file")"
  [[ -L "$target" ]] || {
    echo "installed agent is not a managed symlink: $target" >&2
    exit 1
  }
  [[ "$(readlink "$target")" == "$agent_file" ]] || {
    echo "installed agent points outside this toolkit: $target" >&2
    exit 1
  }
done

python3 - \
  "$repo_root/config/subagents.toml" \
  "$kent_root/config.toml" <<'PY'
import pathlib
import sys
import tomllib

expected = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())
actual = tomllib.loads(pathlib.Path(sys.argv[2]).read_text())


def compare(expected_value, actual_value, path):
    if isinstance(expected_value, dict):
        if not isinstance(actual_value, dict):
            raise AssertionError(f"{path}: expected table")
        for key, value in expected_value.items():
            if key not in actual_value:
                raise AssertionError(f"{path}.{key}: missing")
            compare(value, actual_value[key], f"{path}.{key}")
        return

    if expected_value != actual_value:
        raise AssertionError(
            f"{path}: expected {expected_value!r}, got {actual_value!r}"
        )


compare(expected, actual, "config")
PY
fi

PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
  python3 - "$repo_root" <<'PY'
import pathlib
import sys
from workflowkit.profile import ProjectProfile

root = pathlib.Path(sys.argv[1])
example = root / "contracts" / "project-profile.example.toml"
ProjectProfile.from_toml(
    root, example.read_text(), source=str(example), check_files=False
)
PY

python3 -m compileall -q \
  "$repo_root/workflowkit" \
  "$repo_root/scripts/generate-workflow" \
  "$repo_root/scripts/sync-project-adapters"
python3 -B "$repo_root/.kent/workflows/kit_development.py" --check-current
if [[ "$installed_state" -eq 1 ]]; then
  "$repo_root/scripts/configure-mcporter"
fi
PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m unittest discover -s "$repo_root/tests" -p 'test_*.py'
"$repo_root/tests/test_mcp_adapter.sh"
"$repo_root/tests/test_jira_adapter.sh"
"$repo_root/tests/test_sentry_adapter.sh"
"$repo_root/tests/test_emulator_resource_lock.sh"
"$repo_root/tests/test_mobile_evidence_audit.sh"

echo "kent-engineering-kit validation passed"
