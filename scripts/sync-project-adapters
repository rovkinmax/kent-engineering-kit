#!/usr/bin/env python3
from __future__ import annotations

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import stat
import sys
import tempfile


REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from workflowkit.profile import ProjectProfile


ADAPTER_TEMPLATES = {
    "jira_api": REPO_ROOT / "templates" / "project" / "jira-api.sh",
    "mobile_evidence_audit": (
        REPO_ROOT / "templates" / "project" / "mobile-evidence-audit.sh"
    ),
    "android_apk_install": (
        REPO_ROOT / "templates" / "project" / "android-apk-install-preserve"
    ),
    "mobile_resource_lock": (
        REPO_ROOT / "templates" / "project" / "emulator-resource-lock.sh"
    ),
    "sentry_issues": REPO_ROOT / "templates" / "project" / "sentry-issues.sh",
}


@dataclass(frozen=True)
class CommandTemplate:
    source: Path
    version: str


COMMAND_TEMPLATES = {
    "branch_identity": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-branch-identity",
        "1.0.0",
    ),
    "checkpoint": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-checkpoint",
        "1.0.0",
    ),
    "evidence": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-evidence-ledger",
        "1.0.0",
    ),
    "plan_contract": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-plan-contract",
        "1.0.0",
    ),
    "plan_contract_accept": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-plan-contract-accept",
        "1.0.0",
    ),
    "plan_contract_continue": CommandTemplate(
        REPO_ROOT
        / "templates"
        / "project"
        / "workflow-plan-contract-continue",
        "1.0.0",
    ),
    "plan_contract_fix_continue": CommandTemplate(
        REPO_ROOT
        / "templates"
        / "project"
        / "workflow-plan-contract-fix-continue",
        "1.0.0",
    ),
    "plan_contract_verify": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-plan-contract-verify",
        "1.0.0",
    ),
    "wait_ci": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-wait-github-ci",
        "1.0.0",
    ),
    "dispatch": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-verification-dispatch",
        "1.0.0",
    ),
    "janitor": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-task-janitor",
        "1.0.0",
    ),
    "wait_pr": CommandTemplate(
        REPO_ROOT / "templates" / "project" / "workflow-wait-github-pr",
        "1.0.0",
    ),
}


@dataclass(frozen=True)
class PlannedSynchronization:
    target: Path
    source_bytes: bytes
    status: str


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Synchronize declared Kent Engineering Kit project adapters."
    )
    parser.add_argument(
        "--project",
        required=True,
        type=Path,
        help="Project root containing .kent/workflow-profile.toml.",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="Replace differing managed adapters and commands with templates.",
    )
    return parser.parse_args()


def project_target(project_root: Path, configured_path: str) -> Path:
    relative = Path(configured_path)
    if relative.is_absolute():
        raise ValueError(f"adapter path must be project-relative: {configured_path}")

    target = project_root
    parts = [part for part in relative.parts if part not in ("", ".")]
    for index, part in enumerate(parts):
        target /= part
        if target.is_symlink():
            raise ValueError(
                f"adapter path must not contain symlinks: {configured_path}"
            )
        if index < len(parts) - 1 and target.exists() and not target.is_dir():
            raise ValueError(
                f"adapter path has non-directory component: {configured_path}"
            )

    resolved = target.resolve()
    if not resolved.is_relative_to(project_root):
        raise ValueError(f"adapter path escapes project root: {configured_path}")
    return target


def read_template(source: Path, key: str) -> bytes:
    if source.is_symlink():
        raise ValueError(
            f"toolkit template for {key!r} must not be a symlink: {source}"
        )
    try:
        source_mode = source.lstat().st_mode
    except FileNotFoundError as error:
        raise ValueError(
            f"toolkit template for {key!r} not found: {source}"
        ) from error
    if not stat.S_ISREG(source_mode):
        raise ValueError(
            f"toolkit template for {key!r} is not a regular file: {source}"
        )
    return source.read_bytes()


def validate_project_owned_target(
    target: Path,
    *,
    kind: str,
) -> None:
    if target.is_symlink():
        raise ValueError(f"project-owned {kind} must not be a symlink: {target}")
    try:
        target_mode = target.lstat().st_mode
    except FileNotFoundError as error:
        raise ValueError(f"project-owned {kind} not found: {target}") from error
    if not stat.S_ISREG(target_mode):
        raise ValueError(
            f"project-owned {kind} is not a regular file: {target}"
        )
    if not os.access(target, os.X_OK):
        raise ValueError(
            f"project-owned {kind} is not executable: {target}"
        )


def plan_synchronization(
    source: Path,
    target: Path,
    *,
    key: str,
    update: bool,
) -> PlannedSynchronization:
    source_bytes = read_template(source, key)
    if target.is_symlink():
        raise ValueError(f"managed target must not be a symlink: {target}")
    if target.exists():
        target_mode = target.lstat().st_mode
        if not stat.S_ISREG(target_mode):
            raise ValueError(
                f"managed target is not a regular file: {target}"
            )
        target_bytes = target.read_bytes()
        if target_bytes != source_bytes:
            if not update:
                raise ValueError(
                    f"managed target differs from toolkit template: {target}; "
                    "rerun with --update after reviewing the diff"
                )
            status_label = "updated"
        else:
            status_label = "unchanged"
    else:
        status_label = "created"
    return PlannedSynchronization(
        target=target,
        source_bytes=source_bytes,
        status=status_label,
    )


def apply_synchronization(plan: PlannedSynchronization) -> None:
    target = plan.target
    if plan.status != "unchanged":
        target.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary_name = tempfile.mkstemp(
            dir=target.parent,
            prefix=f".{target.name}.",
        )
        os.close(descriptor)
        temporary_path = Path(temporary_name)
        try:
            temporary_path.write_bytes(plan.source_bytes)
            temporary_path.chmod(0o755)
            os.replace(temporary_path, target)
        finally:
            temporary_path.unlink(missing_ok=True)
    else:
        target.chmod(0o755)


def synchronize(
    source: Path,
    target: Path,
    *,
    key: str,
    update: bool,
) -> str:
    plan = plan_synchronization(
        source,
        target,
        key=key,
        update=update,
    )
    apply_synchronization(plan)
    return plan.status


def validate_schema4_command_versions(profile: ProjectProfile) -> None:
    for key in profile.kit_managed_commands:
        template = COMMAND_TEMPLATES.get(key)
        if template is None:
            raise ValueError(
                f"no toolkit template exists for managed command {key!r}"
            )
        expected = template.version
        actual = profile.command_versions[key]
        if actual != expected:
            raise ValueError(
                f"command_versions.{key} is {actual!r}; "
                f"expected toolkit template version {expected!r}"
            )


def synchronize_schema3(
    profile: ProjectProfile,
    project_root: Path,
    *,
    update: bool,
) -> dict[str, list[dict[str, str]]]:
    results = {"adapters": [], "commands": []}
    managed_adapter_keys = set(profile.kit_managed_adapters)
    for key, configured_path in sorted(profile.adapters.items()):
        if not configured_path:
            continue
        target = project_target(project_root, configured_path)
        if key in managed_adapter_keys:
            source = ADAPTER_TEMPLATES.get(key)
            if source is None:
                raise ValueError(
                    f"no toolkit template exists for managed adapter {key!r}"
                )
            status_label = synchronize(
                source,
                target,
                key=key,
                update=update,
            )
        else:
            if not target.is_file():
                raise ValueError(
                    f"project-owned adapter not found: {target}"
                )
            if not os.access(target, os.X_OK):
                raise ValueError(
                    f"project-owned adapter is not executable: {target}"
                )
            status_label = "project-owned"
        results["adapters"].append(
            {
                "adapter": key,
                "status": status_label,
                "target": str(target),
            }
        )

    for key, configured_path in sorted(profile.commands.items()):
        if not configured_path:
            continue
        target = project_target(project_root, configured_path)
        template = COMMAND_TEMPLATES.get(key)
        if template is None:
            continue
        status_label = synchronize(
            template.source,
            target,
            key=key,
            update=update,
        )
        results["commands"].append(
            {
                "command": key,
                "status": status_label,
                "target": str(target),
            }
        )
    return results


def plan_schema4(
    profile: ProjectProfile,
    project_root: Path,
    *,
    update: bool,
) -> tuple[list[PlannedSynchronization], dict[str, list[dict[str, str]]]]:
    validate_schema4_command_versions(profile)
    managed_adapter_keys = set(profile.kit_managed_adapters)
    managed_command_keys = set(profile.kit_managed_commands)
    plans: list[PlannedSynchronization] = []
    results = {"adapters": [], "commands": []}

    for key, configured_path in sorted(profile.adapters.items()):
        if not configured_path:
            continue
        target = project_target(project_root, configured_path)
        if key in managed_adapter_keys:
            source = ADAPTER_TEMPLATES.get(key)
            if source is None:
                raise ValueError(
                    f"no toolkit template exists for managed adapter {key!r}"
                )
            plan = plan_synchronization(
                source,
                target,
                key=key,
                update=update,
            )
            plans.append(plan)
            status_label = plan.status
        else:
            validate_project_owned_target(
                target,
                kind="adapter",
            )
            status_label = "project-owned"
        results["adapters"].append(
            {
                "adapter": key,
                "status": status_label,
                "target": str(target),
            }
        )

    for key, configured_path in sorted(profile.commands.items()):
        if not configured_path:
            continue
        target = project_target(project_root, configured_path)
        if key in managed_command_keys:
            template = COMMAND_TEMPLATES.get(key)
            if template is None:
                raise ValueError(
                    f"no toolkit template exists for managed command {key!r}"
                )
            plan = plan_synchronization(
                template.source,
                target,
                key=key,
                update=update,
            )
            plans.append(plan)
            status_label = plan.status
        else:
            validate_project_owned_target(
                target,
                kind="command",
            )
            status_label = "project-owned"
        results["commands"].append(
            {
                "command": key,
                "status": status_label,
                "target": str(target),
            }
        )
    return plans, results


def main() -> int:
    args = parse_args()
    project_root = args.project.expanduser().resolve()
    profile_path = project_root / ".kent" / "workflow-profile.toml"
    if not profile_path.is_file():
        raise ValueError(f"project profile not found: {profile_path}")

    profile = ProjectProfile.from_toml(
        project_root,
        profile_path.read_text(),
        source=str(profile_path),
        check_files=False,
    )
    if profile.schema_version == 4:
        plans, results = plan_schema4(
            profile,
            project_root,
            update=args.update,
        )
        for plan in plans:
            apply_synchronization(plan)
    else:
        results = synchronize_schema3(
            profile,
            project_root,
            update=args.update,
        )

    print(
        json.dumps(
            {
                "project": str(project_root),
                "adapters": results["adapters"],
                "commands": results["commands"],
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"sync-project-adapters: {error}", file=sys.stderr)
        raise SystemExit(1)
