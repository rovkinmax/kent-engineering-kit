#!/usr/bin/env python3
"""Run the closed release-live-portfolio operation."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from workflowkit.operations import (  # noqa: E402
    OperationError,
    RELEASE_LIVE_PORTFOLIO_MODES,
    RELEASE_LIVE_PORTFOLIO_MUTATION_MODES,
    load_plan,
    reconcile_release_live_portfolio,
)


def main() -> int:
    parser = argparse.ArgumentParser(prog="scripts/reconcile-release-portfolio")
    parser.add_argument("mode", choices=RELEASE_LIVE_PORTFOLIO_MODES)
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--expect-plan-sha256", required=True)
    parser.add_argument("--kent", required=True)
    parser.add_argument("--confirm")
    args = parser.parse_args()
    if not args.plan.is_absolute():
        parser.error("--plan must be an absolute path")
    kent = Path(args.kent)
    if not kent.is_absolute():
        parser.error("--kent must be an absolute path")
    if args.mode not in RELEASE_LIVE_PORTFOLIO_MUTATION_MODES and args.confirm is not None:
        parser.error("--confirm is only valid for mutation modes")
    if args.mode in RELEASE_LIVE_PORTFOLIO_MUTATION_MODES and args.confirm is None:
        parser.error(f"{args.mode} requires --confirm")
    try:
        plan = load_plan(
            args.plan,
            schema="release-live-portfolio-plan-v1",
            expected_sha256=args.expect_plan_sha256,
            mutation=args.mode in RELEASE_LIVE_PORTFOLIO_MUTATION_MODES,
            confirm=args.confirm,
        )
        report = reconcile_release_live_portfolio(
            plan,
            mode=args.mode,
            kent=kent,
            confirm=args.confirm,
        )
    except (OperationError, OSError) as error:
        print(f"reconcile-release-portfolio: {error}", file=sys.stderr)
        return 1
    print(json.dumps(report, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
